@{
    ViewData["Title"] = "Refer & Earn";
}



<style>
    .tracking {
        position: relative;
    }

    .tracking-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: 25px;
    }

        .tracking-item:last-child {
            padding-bottom: 0;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 40px;
            width: 2px;
            height: calc(100% - 20px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

    .tracking-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tracking-content {
        padding-top: 5px;
    }

    .completed .tracking-content strong {
        color: #198754;
    }

    .active .tracking-content strong {
        color: #fd7e14;
    }
</style>
<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    🎁 Share & Earn Rewards
                </h1>
                <p class="breadcrumb-subtitle mb-0">
                    | Share your referral link and earn rewards
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/secure/user-dashboard">Dashboard</a>
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<div class="clearfix"></div>



<div class="row mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total Referrals</h6>
                <h3 class="text-primary">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Successful Referrals</h6>
                <h3 class="text-success">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Pending Referrals</h6>
                <h3 class="text-warning">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total Earnings</h6>
                <h3 class="text-danger">₹0</h3>
            </div>
        </div>
    </div>

</div>




<div class="card shadow-sm mb-4">
    <div class="card-body">

        <label class="form-label fw-bold">
            Your Referral Link
        </label>

        <div class="input-group">
              <input type="text" id="txtReferralLink" class="form-control"
                   value="https://yourdomain.com/register?ref=USR12345"
                   readonly /> 

           @*  <input type="text"
                   id="txtReferralLink"
                   class="form-control"
                   value="@($"{Context.Request.Scheme}://{Context.Request.Host}/register?ref={Model.ReferralCode}")"
                   readonly /> *@


            <button class="btn btn-success" id="btnCopyReferral">
                <i class="bi bi-copy"></i> Copy Link
            </button>
        </div>

    </div>
</div>

<div class="table-responsive">
    <table id="tblList"
           class="table table-striped table-hover display nowrap"
           style="width:100%">
    </table>
</div>

<div class="alert alert-success mt-4">

    <h6 class="fw-bold mb-2">
        How Refer & Earn Works?
    </h6>

    <ul class="mb-0">
        <li>Share your referral link with friends.</li>
        <li>Your friend registers using your referral link.</li>
        <li>Your friend places their first order.</li>
        <li>You earn ₹100 cashback/reward instantly.</li>
    </ul>

</div>

<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
<script>
        $(document).ready(function () {

        var referralLink =
            "https://yourdomain.com/register?ref=AJAY123";

        $("#whatsappShare").attr(
            "href",
            "https://wa.me/?text=" + encodeURIComponent(referralLink)
        );

        $("#telegramShare").attr(
            "href",
            "https://t.me/share/url?url=" + encodeURIComponent(referralLink)
        );

        $("#facebookShare").attr(
            "href",
            "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(referralLink)
        );

        $("#btnCopyReferral").click(function () {

            navigator.clipboard.writeText(referralLink);

            $(this)
                .removeClass("btn-success")
                .addClass("btn-primary")
                .html('<i class="bi bi-check-lg"></i> Copied');

            setTimeout(() => {

                $("#btnCopyReferral")
                    .removeClass("btn-primary")
                    .addClass("btn-success")
                    .html('<i class="bi bi-copy"></i> Copy');

            }, 2000);
        });

        var referralList = [

            {
                name: "Rahul Sharma",
                mobile: "9876543210",
                joinDate: "01-Aug-2026",
                reward: "₹100",
                status: "Success"
            },

            {
                name: "Amit Kumar",
                mobile: "9876543211",
                joinDate: "03-Aug-2026",
                reward: "₹100",
                status: "Success"
            },

            {
                name: "Priya Singh",
                mobile: "9876543212",
                joinDate: "08-Aug-2026",
                reward: "₹0",
                status: "Pending"
            }

        ];

        $('#tblList').DataTable({

            data: referralList,
            responsive: true,

            columns: [

                {
                    title: "#",
                    data: null,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },

                {
                    title: "Name",
                    data: "name"
                },

                {
                    title: "Mobile",
                    data: "mobile"
                },

                {
                    title: "Join Date",
                    data: "joinDate"
                },

                {
                    title: "Reward",
                    data: "reward"
                },

                {
                    title: "Status",
                    data: "status",
                    render: function (data) {

                        return data === "Success"
                            ? '<span class="badge bg-success">Success</span>'
                            : '<span class="badge bg-warning text-dark">Pending</span>';
                    }
                }

            ]

        });

    });
</script>
