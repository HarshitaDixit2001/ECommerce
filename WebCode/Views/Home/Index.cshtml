<style>

    /*=========================================
                        BEST SELLING PRODUCTS
     =========================================*/

     .product-card {
        position: relative;
    }

    .product-code-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #198754;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        z-index: 2;
        box-shadow: 0 2px 6px rgba(0,0,0,.15);
        white-space: nowrap;
    }

    .best-selling-wrapper {
        position: relative;
        overflow: hidden;
    }

    .marquee-container {
        width: 100%;
        overflow: hidden;
        padding: 10px 55px;
    }

    .marquee-track {
        display: flex;
        align-items: stretch;
        gap: 20px;
        width: max-content;
        animation: marqueeScroll 40s linear infinite;
    }

    .marquee-container:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        flex: 0 0 auto;
        width: 280px;
    }

    /*=========================================
                        Navigation Buttons
                =========================================*/

    .marquee-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 10px 25px rgba(0,0,0,.18);
        transition: .3s;
    }

        .marquee-btn:hover {
            background: #146c43;
            transform: translateY(-50%) scale(1.08);
        }

    .marquee-prev {
        left: 5px;
    }

    .marquee-next {
        right: 5px;
    }

    /*=========================================
                        Marquee Animation
                =========================================*/

    @@keyframes marqueeScroll {

        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    /*=========================================
                        Responsive
                =========================================*/

    @@media (max-width:992px) {

        .marquee-item {
            width: 240px;
        }
    }

    @@media (max-width:768px) {

        .marquee-container {
            padding: 10px 45px;
        }

        .marquee-item {
            width: 200px;
        }

        .marquee-btn {
            width: 40px;
            height: 40px;
            font-size: 18px;
        }
    }
</style>


