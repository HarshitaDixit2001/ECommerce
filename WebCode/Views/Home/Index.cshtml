@model List<ProductViewModel>
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .hero-slide {
        min-height: 70vh;
        padding: 70px 0;
        background-size: cover;
        background-position: center;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* OVERLAY (Dark Effect) */
    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient( rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.45) );
        z-index: 1;
    }

    /* CONTENT CENTER */
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 750px;
        text-align: center;
        animation: fadeUp 1s ease;
    }

        /* HEADING */
        .hero-content h1 {
            font-size: 2.6rem;
            font-weight: 700;
        }

        /* TEXT */
        .hero-content p {
            font-size: 1.1rem;
            margin: 15px 0;
            color: #ddd;
        }



    /* TEXT ANIMATION */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(35px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* SMOOTH SLIDE FADE */
    .carousel-fade .carousel-item {
        transition: opacity 1s ease-in-out;
    }

    /* INDICATORS STYLE */
    .carousel-indicators button {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* ARROWS */
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.4);
        border-radius: 50%;
    }

    section:hover {
        transition: 0.3s;
    }

    .service-card {
        transition: all 0.3s ease;
        border: 0;
        box-shadow: 0 2px 15px rgba(0,0,0,.08);
    }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 25px rgba(0,0,0,.15);
        }
</style>

<style>
    /* ==========================================
                      AYURVEDIC HERO BANNER
                 ========================================== */

    .hero-banner {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        border: 2px solid #d8eadc;
        box-shadow: 0 10px 30px rgba(25,135,84,.12);
    }

    .hero-banner-img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        display: block;
    }

    /* Overlay */
    .banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(10, 60, 30, 0), rgba(15, 100, 84, 0.30) );
        display: flex;
        align-items: center;
    }

    /* Content */
    .banner-content {
        max-width: 650px;
        color: #fff;
        padding: 40px;
    }

    .banner-badge {
        display: inline-block;
        background: rgba(255,255,255,.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.25);
        padding: 8px 18px;
        border-radius: 50px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .banner-title {
        font-size: 3rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 20px;
        text-shadow: 0 3px 12px rgba(0,0,0,.3);
    }

    .banner-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: rgba(255,255,255,.95);
        margin-bottom: 25px;
    }

    .btn-banner {
        background: #198754;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px 28px;
        font-weight: 600;
    }

        .btn-banner:hover {
            background: #146c43;
            color: #fff;
        }

    /* ==========================================
                        MOBILE
                 ========================================== */

    @@media (max-width: 991px) {
        .hero-banner-img {
            height: 350px;
        }

        .banner-content {
            text-align: center;
            max-width: 100%;
            padding: 25px;
        }

        .banner-title {
            font-size: 2rem;
        }

        .banner-text {
            font-size: .95rem;
            line-height: 1.6;
        }
    }

    @@media (max-width: 576px) {
        .hero-banner-img {
            height: 280px;
        }

        .banner-title {
            font-size: 1.5rem;
        }

        .banner-badge {
            font-size: 13px;
        }
    }
</style>

<style>
