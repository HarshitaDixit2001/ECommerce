<script src="~/js/jquery-3.7.1.min.js"></script>
<script>
     $(document).on("click", ".wishlist-btn", function () {
         $(this).toggleClass("active");
     });


    $(document).ready(function () {
        BindProduct();
    });


    function BindProduct() {

        $.ajax({
            url: "/product/get-product",
            type: "GET",
            data: {cart_id: 0, fetch_type: "HOME_BEST_SELLING" },
            success: function (response) {

                if (!response.success)
                    return;

                let products = response.data || [];
                let html = "";

                // Duplicate products for infinite marquee
                for (let r = 0; r < 2; r++) {

                    $.each(products, function (i, product) {

                        let img = "/images/noimage.jpg";

                        if (product.img1 && product.img1 !== "") {
                            img = "/" + product.img1.replace(/^\/+/, "");
                        }

                        let name = product.prod_name || "";

                        if (name.length > 25) {
                            name = name.substring(0, 25) + "...";
                        }

                        let discount = product.discount ? Number(product.discount).toFixed(0) : 0;

                        let mrp = product.mrp ? Number(product.mrp).toFixed(2) : "0.00";
                        let price = product.price ? Number(product.price).toFixed(2) : "0.00";

                        let code = product.prod_code || "";

                        html += `
                        <div class="marquee-item">
                            <div class="product-card">
                                <!-- Product Code -->
                                <div class="product-code-badge"> ${code} </div>

                                <!-- Wishlist -->
                                <div class="wishlist-btn"> <i class="bi bi-heart"></i> </div>

                                <a href="/product/${product.seo_url}">
                                    <img src="${img}" class="product-img" alt="${product.prod_name}">
                                </a>

                                <div class="product-info">
                                    <h6 class="product-title mb-2"> ${name} </h6>

                                    <div class="product-price-box d-flex justify-content-between align-items-center">
                                        <span class="mrp"> MRP${mrp} </span>
                                        <span class="dp"> Rs.${price} </span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="badge bg-warning text-dark">
                                            ${discount}% OFF
                                        </span>

                                        <button class="btn-cart-sm"
                                                onclick="AddToCart(0,${product.pid},1,'')">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                    });
                }

                $("#marqueeTrack").html(html);

                // Reinitialize marquee if available
                if (typeof InitializeMarquee === "function") {
                    InitializeMarquee();
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading products:", error);
            }
        });
    } 
</script>


<script>

    $(function () {
        var container = $("#marqueeContainer");
        var timer;
        function startAutoScroll() {
            timer = setInterval(function () {
                var maxScroll = container[0].scrollWidth - container.innerWidth();
                if (container.scrollLeft() >= maxScroll) {
                    container.scrollLeft(0);
                } else {
                    container.scrollLeft(container.scrollLeft() + 1);
                }
            }, 20);
        }

        function stopAutoScroll() {
            clearInterval(timer);
        }

        startAutoScroll();
        container.hover(function () {
            stopAutoScroll();
        }, function () {
            startAutoScroll();
        });

        $("#nextBtn").click(function () {
            stopAutoScroll();
            container.stop().animate({
                scrollLeft: container.scrollLeft() + 320
            }, 400);
            startAutoScroll();
        });

        $("#prevBtn").click(function () {
            stopAutoScroll();
            container.stop().animate({
                scrollLeft: container.scrollLeft() - 320
            }, 400);
            startAutoScroll();
        });
    });
</script>
 