
@{
    ViewData["Title"] = "Error";
}


<div class="container mt-5">
    <h2 class="text-danger">An error occurred</h2>
    <p class="text-muted">@ViewBag.ErrorMessage</p>

    @if (ViewBag.StackTrace != null)
    {
        <pre class="bg-light p-3 border rounded" style="overflow:auto;">@ViewBag.StackTrace</pre>
    }

    <a href="/" class="btn btn-outline-primary mt-3">Go to Homepage</a>
</div>
