@model AddUpdateUserRequest
@{
    ViewData["Title"] = "Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
                           AYURVEDIC REGISTRATION PAGE
                     ========================================== */

    /* ===== CONTAINER ===== */
    .registration-container {
        padding: 40px 0;
        background: linear-gradient(135deg,#f8fcf8,#edf7ef);
        min-height: 100vh;
    }

    /* ===== CARD ===== */
    .registration-card {
        background: #ffffff;
        border: 1px solid #d8eadc;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(25,135,84,0.08);
        overflow: hidden;
        animation: fadeInUp 0.5s ease;
    }

    /* ===== HEADER ===== */
    .registration-header {
        background: linear-gradient(135deg,#198754,#2e7d32);
        color: #ffffff;
        padding: 25px;
    }

        .registration-header h3,
        .registration-header h4,
        .registration-header h5 {
            color: #ffffff;
            margin-bottom: 5px;
        }

        .registration-header p {
            color: rgba(255,255,255,.9);
            margin-bottom: 0;
        }


    /* ===== SECTION TITLE ===== */
    .section-title {
        font-weight: 700;
        color: #1d5a34;
        border-left: 5px solid #198754;
        padding-left: 12px;
        margin-bottom: 15px;
        font-size: 18px;
    }

    /* ===== LABEL ===== */
    .form-label {
        font-weight: 600;
        color: #2f4f39;
        margin-bottom: 6px;
    }

    /* ===== INPUT ===== */
    .form-control,
    .form-select {
        border: 1px solid #d8eadc;
        border-radius: 10px;
        padding: 10px 12px;
        min-height: 45px;
        transition: all .3s ease;
        background: #fff;
    }

        /* ===== INPUT FOCUS ===== */
        .form-control:focus,
        .form-select:focus {
            border-color: #198754;
            box-shadow: 0 0 0 .20rem rgba(25,135,84,.15);
        }

    /* ===== SELECT2 ===== */
    .select2-container .select2-selection--single {
        height: 45px !important;
        border: 1px solid #d8eadc !important;
        border-radius: 10px !important;
        padding: 8px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 28px !important;
    }

    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #198754 !important;
    }

    /* ===== SPONSOR BOX ===== */
    .sponsor-name {
        background: #edf7ef;
        border: 1px solid #d8eadc;
        color: #198754;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        margin-top: 5px;
        font-weight: 600;
    }

    /* ===== BUTTONS ===== */
    .btn-submit {
        background: linear-gradient(135deg,#198754,#2e7d32);
        border: none;
        color: #ffffff;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        transition: .3s;
        box-shadow: 0 5px 15px rgba(25,135,84,.20);
    }

        .btn-submit:hover {
            background: linear-gradient(135deg,#146c43,#1b5e20);
            color: #ffffff;
            transform: translateY(-2px);
        }

    .btn-cancel {
        background: #f1f5f2;
        border: 1px solid #d8eadc;
        color: #444;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #e8f5ec;
            color: #198754;
        }

    /* ===== REQUIRED STAR ===== */
    .required {
        color: #dc3545;
    }

    /* ===== CARD DIVIDER ===== */
    .form-divider {
        height: 1px;
        background: #e8f2ea;
        margin: 20px 0;
    }

    /* ===== ANIMATION ===== */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== MOBILE ===== */
    @@media (max-width: 768px) {
        .registration-container {
            padding: 20px 0;
        }

        .registration-body {
            padding: 20px;
        }

        .section-title {
            font-size: 16px;
        }
    }
</style>

<style>
    .card {
        border-radius: 15px;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
    }

    .form-control,
    .form-select {
        height: 45px;
        border-radius: 8px;
    }

    textarea.form-control {
        height: auto;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 .15rem rgba(25,135,84,.15);
    }

    label.fw-semibold {
        color: #344054;
        font-size: 14px;
        margin-bottom: 0;
    }
</style>





<section class="registration-container">
    <div class="container">
        <div class="registration-card">
            <!-- HEADER -->
            <div class="registration-header text-white text-center p-4">
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-person-plus-fill me-2"></i> Ayurvedic Wellness Registration
                </h3>
                <p class="fw-semibold small">
                    Join our herbal wellness community and start your journey toward a healthier lifestyle.
                </p>
            </div>
            <!-- Form Body -->
            <div class="registration-body">
                @await Html.PartialAsync("_Loader")

                <form id="SubmitForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(false, "", new { @class = "validation-summary text-danger" })
                    <div class="mx-3 pb-5">
                        <!-- Row 1 -->
                        <div class="row align-items-center mb-3">

                            <label class="col-md-2 fw-semibold">
                                Full Name <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">
                                <input asp-for="name"
                                       class="form-control"
                                       placeholder="Enter Full Name">
                                <span asp-validation-for="name" class="text-danger"></span>
                            </div>

                            <label class="col-md-2 fw-semibold">
                                Mobile Number <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">
                                <input asp-for="mobile"
                                       maxlength="10"
                                       class="form-control"
                                       placeholder="Enter Mobile Number">
                                <span asp-validation-for="mobile" class="text-danger"></span>
                            </div>

                        </div>

                        <!-- Row 2 -->
                        <div class="row align-items-center mb-3">

                            <label class="col-md-2 fw-semibold">
                                Email Address
                            </label>

                            <div class="col-md-4">
                                <input asp-for="email_id"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter Email Address">
                            </div>

                            <label class="col-md-2 fw-semibold">
                                City
                            </label>

                            <div class="col-md-4">
                                <input asp-for="city"
                                       class="form-control"
                                       placeholder="Enter City">
                            </div>

                        </div>

                        <!-- Row 3 -->
                        <div class="row align-items-center mb-3">

                            <label class="col-md-2 fw-semibold">
                                State <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">

                                <select asp-for="state_id"
                                        asp-items="ViewBag.StateList"
                                        onchange="DistrictSelect()"
                                        class="form-select select2">

                                    <option value="0">
                                        @Const.DROPDOWN_DEFAULT
                                    </option>

                                </select>

                                <span asp-validation-for="state_id"
                                      class="text-danger"></span>

                            </div>

                            <label class="col-md-2 fw-semibold">
                                District
                            </label>

                            <div class="col-md-4">

                                <select id="dist_id"
                                        name="dist_id"
                                        asp-items="ViewBag.DistrictList"
                                        class="form-select select2">

                                    <option value="0">
                                        @Const.DROPDOWN_DEFAULT
                                    </option>

                                </select>

                            </div>

                        </div>

                        <!-- Row 4 -->
                        <div class="row align-items-center mb-3">

                            <label class="col-md-2 fw-semibold">
                                PIN Code <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">

                                <input asp-for="pin_code"
                                       class="form-control"
                                       placeholder="Enter PIN Code">

                                <span asp-validation-for="pin_code"
                                      class="text-danger"></span>

                            </div>

                            <label class="col-md-2 fw-semibold pt-2">
                                Address <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">

                                <textarea asp-for="address"
                                          rows="2"
                                          class="form-control"
                                          placeholder="Enter Complete Address"></textarea>

                                <span asp-validation-for="address"
                                      class="text-danger"></span>

                            </div>


                        </div>

                        <!-- Row 5 -->
                        <div class="row align-items-center mb-3 d-none">

                            <label class="col-md-2 fw-semibold">
                                Sponsor ID <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">
                                <input asp-for="sponsor_user_id" class="form-control" placeholder="Enter sponsor ID" onchange="GetSponsorName()">
                                <span asp-validation-for="sponsor_user_id" class="text-danger"></span>
                                <div id="sponsor_name"></div>
                            </div>

                            <label class="col-md-2 fw-semibold">
                                Position (Left/Right) <span class="text-danger">*</span>
                            </label>

                            <div class="col-md-4">
                                <select asp-for="p_side" class="form-control">
                                    <option value="">@Const.DROPDOWN_DEFAULT</option>
                                    <option value="L">Left</option>
                                    <option value="R">Right</option>
                                </select>
                            </div>

                        </div>

                        <!-- Row 6 -->
                        <div class="row mb-4">
                            <label class="col-md-2 fw-semibold">
                                Password <span class="text-danger">*</span>
                            </label>
                            <div class="col-md-4">
                                <input asp-for="password" type="password" class="form-control" placeholder="Enter Password">
                                <span asp-validation-for="password" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="row">
                            <div class="col-md-12 text-end">
                                <a asp-action="Index" class="btn btn-secondary px-4 me-2">
                                    Cancel
                                </a>
                                @*  <button type="submit" class="btn btn-success px-4"> 
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Submit Registration 
                                </button> *@
                                <button type="submit" class="btn btn-success px-4" onclick="confirmSubmission(event)">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Submit Registration
                                </button>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>




