<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_dropdownsearch")

<script>
    $(function () {
        // Initialize Select2 without search
        $('.select2').select2({
            theme: 'bootstrap-5',
            width: '100%',
            minimumResultsForSearch: Infinity // Disable search
        });
    });



    function confirmSubmission(event) {
        debugger;

        event.preventDefault();

        var name = document.getElementById("name")?.value.trim() || '';
        var mobile = document.getElementById("mobile")?.value.trim() || '';
        var sponsor = document.getElementById("sponsor_user_id")?.value || '';
        var position = document.getElementById("p_side")?.value || '';
        var posText = position === "L" ? "Left" : position === "R" ? "Right" : "-";

        // Name Validation
        if (name === '') {
            Swal.fire('Validation Error', 'Please enter Full Name.', 'warning');
            return false;
        }

        // Mobile Validation
        if (mobile === '') {
            Swal.fire('Validation Error', 'Please enter Mobile Number.', 'warning');
            return false;
        }

        // Indian Mobile Number Validation
        var mobileRegex = /^[5-9]\d{9}$/;
        if (!mobileRegex.test(mobile)) {
            Swal.fire(
                'Validation Error',
                'Please enter a valid 10-digit mobile number.',
                'warning'
            );
            return false;
        }

        Swal.fire({
            icon: 'question',
            title: '⚠️ Confirm Registration',
            width: '450px',
            confirmButtonText: 'Yes, Submit',
            cancelButtonText: 'Cancel',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            html: `
            <div style="text-align:left; font-size:14px;">
                <p><strong>👤 Full Name:</strong> ${name}</p>
                <p><strong>📱 Mobile:</strong> ${mobile}</p> 
                <hr/>
                <small style="color:#666;">Please verify all details before submitting.</small>
            </div>`
        }).then((swalResult) => {

            if (swalResult.isConfirmed) {
                const formData = new FormData(document.getElementById('SubmitForm'));
                showLoader();
                $.ajax({
                    url: '/Home/AddUser',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        hideLoader();
                        if (response.success === true) {
                            window.location.href = `/Home/Thanks?user_id=${response.message}`;
                        }
                        else { showErrorLog("Error", response.message); }
                    },
                    error: function () {
                        hideLoader();
                        Swal.fire('Error', 'Something went wrong!', 'error');
                    }
                });
            }
        });
    }




