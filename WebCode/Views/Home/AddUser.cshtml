    let URL_DROPDOWN_LIST = `/common/get-master-dropdown`;

    function GetSponsorName() {
        const userId = $('#sponsor_user_id').val();
        const $name = $('#sponsor_name');
        if (!userId) return $name.text('').css('color', '');

        $name.html('<i class="bi bi-hourglass-split me-1"></i>Loading...').css('color', '#1565C0');

        $.get(`/common/master-reports?mst_key=GET_BASIC_USER_DATA&user_id=${userId}`, res => {
            const data = (JSON.parse(res.data || '[]')[0]) || {};
            if (data?.name) {
                $name.html(`<i class="bi bi-check-circle me-1"></i>${data.name}`).css('color', '#4CAF50');
            } else {
                $name.html('<i class="bi bi-x-circle me-1"></i>Invalid Sponsor ID').css('color', '#dc3545');
            }
        }).fail(() => $name.text('').css('color', ''));
    }


     function DistrictSelect() {
         const stateId = $('#state_id').val();
         const $dist = $('#dist_id');
         const defaultOpt = '<option value="0">🔍 Select District</option>';

         if (!stateId || stateId == 0) {
             $dist.html(defaultOpt);
             return;
         }
         $dist.html('<option value="0">Loading...</option>');
         $.get('/common/get-master-dropdown', {
             mst_key: 'GET_DISTRICT_LIST',
             id: stateId
         })
         .done(res => {
             const options = (res?.data || [])
                 .map(x => `<option value="${x.value}">${x.text}</option>`)
                 .join('');
             $dist.html(defaultOpt + options);
         })
         .fail(() => $dist.html(defaultOpt));
     }

</script>
