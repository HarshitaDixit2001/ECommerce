<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    ❓ Frequently Asked Questions
                </h1>
                <p class="breadcrumb-subtitle mb-0">
                    Find answers to the most common questions about our services.
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>
                        <li class="breadcrumb-item active">
                            FAQ
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="clearfix"></div>

<!-- ================= FAQ SECTION ================= -->
<section class="py-5">
    <div class="container">

        <div class="row justify-content-center mb-4">
            <div class="col-lg-8 text-center">
                <h2 class="fw-bold">Frequently Asked Questions</h2>
                <p class="text-muted">
                    Have questions? We've got answers. Browse our most commonly asked questions below.
                </p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="accordion" id="faqAccordion">

                    <!-- FAQ 1 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq1">
                                What is your company about?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                We provide software development, web solutions,
                                mobile applications, eCommerce platforms, MLM software,
                                and digital business solutions.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 2 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq2">
                                How can I contact customer support?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You can contact our support team through phone,
                                email, WhatsApp, or the contact form available on our website.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 3 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq3">
                                Do you provide MLM software solutions?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, we provide Binary, Matrix, Unilevel,
                                Board Plan, Generation Plan, Hybrid Plan,
                                and customized MLM software solutions.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 4 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq4">
                                How long does a project take to complete?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Project timelines depend on requirements.
                                Small projects may take a few days while larger
                                applications can take several weeks or months.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 5 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq5">
                                Do you provide website maintenance services?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, we offer website maintenance, updates,
                                bug fixing, security monitoring, and performance optimization.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 6 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq6">
                                What payment methods do you accept?
                            </button>
                        </h2>
                        <div id="faq6" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                We accept Bank Transfer, UPI, Credit/Debit Cards,
                                Net Banking, and other approved payment methods.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 7 -->
                    <div class="accordion-item mb-3 border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq7">
                                Can I request custom software development?
                            </button>
                        </h2>
                        <div id="faq7" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Absolutely. We specialize in custom software
                                development tailored to your business requirements.
                            </div>
                        </div>
                    </div>

                    <!-- FAQ 8 -->
                    <div class="accordion-item border rounded">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq8">
                                Do you offer post-launch support?
                            </button>
                        </h2>
                        <div id="faq8" class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, we provide technical support, maintenance,
                                updates, and training after project deployment.
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>
</section>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script src="~/js/jquery-3.7.1.min.js"></script>