@{
    ViewData["Title"] = "Blog";
}

<!-- ================= HERO SECTION ================= -->
<section class="hero-section text-center">
    <div class="container">
        <h1 class="animate__animated animate__fadeInDown">
            Our Blog
        </h1>

        <p class="animate__animated animate__fadeInUp">
            Latest articles about MLM Software, Ecommerce Development,
            CRM Systems, Mobile Apps and Technology Trends.
        </p>
    </div>
</section>


<!-- ================= BLOG SECTION ================= -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- BLOG LEFT SIDE -->
            <div class="col-md-8">
                <!-- BLOG 1 -->
                <div class="card shadow border-0 mb-4">
                    <img src="https://images.unsplash.com/photo-1556157382-97eda2d62296"
                         class="card-img-top">
                    <div class="card-body">
                        <h3 class="fw-bold">
                            Why MLM Software is Important for Network Marketing
                        </h3>

                        <p class="text-muted">
                            Posted on July @DateTime.Now.Year | MLM Software
                        </p>
                        <p>
                            MLM software helps network marketing companies
                            manage members, commissions, payouts and business
                            growth effectively. A good MLM system includes
                            binary plan, level plan, wallet management and
                            secure admin dashboard.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>

                <!-- BLOG 2 -->
                <div class="card shadow border-0 mb-4">
                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f"
                         class="card-img-top">
                    <div class="card-body">
                        <h3 class="fw-bold">
                            Benefits of Ecommerce Website for Business
                        </h3>

                        <p class="text-muted">
                            Posted on July @DateTime.Now.Year | Ecommerce
                        </p>

                        <p>
                            Ecommerce websites allow businesses to sell
                            products online and reach global customers.
                            With proper payment gateway integration,
                            product management and order tracking,
                            online stores increase business revenue.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>


                <!-- BLOG 3 -->
                <div class="card shadow border-0 mb-4">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71"
                         class="card-img-top">
                    <div class="card-body">
                        <h3 class="fw-bold">
                            What is CRM Software and Why Businesses Need It
                        </h3>

                        <p class="text-muted">
                            Posted on July @DateTime.Now.Year | CRM Software
                        </p>

                        <p>
                            CRM software helps companies manage customers,
                            leads, sales pipelines and communication.
                            It improves productivity and allows businesses
                            to manage operations efficiently.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>

            <!-- BLOG SIDEBAR -->
            <div class="col-md-4">
                <!-- SEARCH -->
                <div class="card shadow border-0 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">
                            Search Blog
                        </h5>
                        <input type="text" class="form-control" placeholder="Search article">
                    </div>
                </div>

                <!-- CATEGORIES -->
                <div class="card shadow border-0 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">
                            Categories
                        </h5>

                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a href="#">MLM Software</a>
                            </li>

                            <li class="mb-2">
                                <a href="#">Ecommerce Development</a>
                            </li>

                            <li class="mb-2">
                                <a href="#">CRM Software</a>
                            </li>

                            <li class="mb-2">
                                <a href="#">Mobile App Development</a>
                            </li>

                            <li class="mb-2">
                                <a href="#">Technology News</a>
                            </li>
                        </ul>
                    </div>
                </div>


                <!-- RECENT POSTS -->
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">
                            Recent Posts
                        </h5>
                        <p>
                            ✔ Best MLM Software Features in @DateTime.Now.Year
                        </p>
                        <p>
                            ✔ How Ecommerce Websites Increase Sales
                        </p>
                        <p>
                            ✔ Top CRM Software Benefits
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ================= CALL TO ACTION ================= -->
<section class="enquiry-section text-center">
    <div class="container">
        <h2 class="text-white fw-bold">
            Need Software for Your Business?
        </h2>

        <p class="text-white">
            We develop MLM Software, Ecommerce Websites,
            CRM Systems and Mobile Apps.
        </p>

        <a href="/Home/Contact" class="btn btn-light btn-lg mt-3">
            Contact Us
        </a>
    </div>
</section>
<script src="~/js/jquery-3.7.1.min.js"></script>