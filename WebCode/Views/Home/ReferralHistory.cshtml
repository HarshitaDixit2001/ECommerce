@{
    ViewData["Title"] = "Refer & Earn";
}



<style>
    .tracking {
        position: relative;
    }

    .tracking-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: 25px;
    }

        .tracking-item:last-child {
            padding-bottom: 0;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 40px;
            width: 2px;
            height: calc(100% - 20px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

    .tracking-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tracking-content {
        padding-top: 5px;
    }

    .completed .tracking-content strong {
        color: #198754;
    }

    .active .tracking-content strong {
        color: #fd7e14;
    }
</style>

<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    👥 Referral History
                </h1>

                <p class="breadcrumb-subtitle mb-0">
                    | Track all your referred members and referral earnings
                </p>
            </div>

            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/secure/user-dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            Referral History
                        </li>
                    </ol>
                </nav>
            </div>

        </div>
    </div>
</section>


<div class="row mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total Referrals</h6>
                <h3 class="text-primary mb-0">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Successful Referrals</h6>
                <h3 class="text-success mb-0">18</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Pending Referrals</h6>
                <h3 class="text-warning mb-0">7</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total Earnings</h6>
                <h3 class="text-danger mb-0">₹2,500</h3>
            </div>
        </div>
    </div>

</div>


<div class="row mb-3">

    <div class="col-md-2">
        <input type="text"
               id="from_date"
               class="form-control"
               placeholder="From Date" />
    </div>

    <div class="col-md-2">
        <input type="text"
               id="to_date"
               class="form-control"
               placeholder="To Date" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary" id="btnSearch">
            Search
        </button>
    </div>

</div>

<div class="table-responsive">
    <table id="tblList"
           class="table table-striped table-hover display nowrap"
           style="width:100%">
    </table>
</div>


<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
<script>
    $(document).ready(function () {

        var referralHistory = [
            {
                referralCode: "AJAY123",
                memberName: "Rahul Sharma",
                mobile: "9876543210",
                joinDate: "01-Aug-2026",
                orderAmount: "₹1,250",
                reward: "₹100",
                status: "Success"
            },

            {
                referralCode: "AJAY123",
                memberName: "Amit Kumar",
                mobile: "9876543211",
                joinDate: "05-Aug-2026",
                orderAmount: "₹980",
                reward: "₹100",
                status: "Success"
            },

            {
                referralCode: "AJAY123",
                memberName: "Priya Singh",
                mobile: "9876543212",
                joinDate: "08-Aug-2026",
                orderAmount: "-",
                reward: "₹0",
                status: "Pending"
            }

        ];

        $('#tblList').DataTable({

            destroy: true,
            responsive: true,
            pageLength: 10,
            data: referralHistory,

            columns: [

                {
                    title: "#",
                    data: null,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },

                {
                    title: "Referral Code",
                    data: "referralCode",
                    render: function (data) {
                        return `<span class="badge bg-primary">${data}</span>`;
                    }
                },

                {
                    title: "Member Name",
                    data: "memberName"
                },

                {
                    title: "Mobile No.",
                    data: "mobile"
                },

                {
                    title: "Join Date",
                    data: "joinDate"
                },

                {
                    title: "Order Amount",
                    data: "orderAmount",
                    className: "fw-bold"
                },

                {
                    title: "Reward Earned",
                    data: "reward",
                    className: "text-success fw-bold"
                },

                {
                    title: "Status",
                    data: "status",
                    render: function (data) {

                        if (data === "Success") {
                            return '<span class="badge bg-success">Success</span>';
                        }

                        return '<span class="badge bg-warning text-dark">Pending</span>';
                    }
                }

            ]

        });

    });
</script>
