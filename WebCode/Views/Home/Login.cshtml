@model AppModels.LoginRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}
  <style>
    .login-page {
        min-height: 100vh;
        background: linear-gradient( 135deg, #f8fcf8 0%, #edf7ef 50%, #e4f4e8 100% );
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
    }

    .card {
        border: 1px solid #d8eadc;
        border-radius: 18px;
    }
</style>  
 
  <br />
<div class="login-page">

    <div class="login-container">

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="modal-herbal-header text-center py-4">

                <h4 class="mb-2">
                    🌿 Welcome Back
                </h4>

                <p class="mb-0">
                    Sign in to access your Ayurvedic wellness account
                </p>

            </div>

            <!-- Body -->
            <div class="card-body p-4">

                @using (Html.BeginForm("login", "home", FormMethod.Post, new { onsubmit = "return showLoader(this);" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Login ID -->
                    <div class="mb-3">

                        <label asp-for="login_id" class="form-label fw-semibold">
                            Login ID
                        </label>

                        <div class="input-group">

                            <span class="input-group-text herbal-icon">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <input asp-for="login_id"
                                   class="form-control herbal-input"
                                   placeholder="Enter Login ID" />

                        </div>

                        <span asp-validation-for="login_id"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Password -->
                    <div class="mb-3">

                        <label asp-for="password"
                               class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text herbal-icon">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                            <input asp-for="password"
                                   type="password"
                                   class="form-control herbal-input"
                                   placeholder="Enter Password" />

                        </div>

                        <span asp-validation-for="password"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- CAPTCHA -->
                    <div class="captcha-box mb-4">

                        <div class="row align-items-center">

                            <div class="col-md-6">

                                <span class="fw-bold text-success">
                                    @ViewBag.Num1 + @ViewBag.Num2 = ?
                                </span>

                            </div>

                            <div class="col-md-6">

                                <input type="number"
                                       name="Sum_input"
                                       class="form-control herbal-input"
                                       placeholder="Enter Answer"
                                       required />

                                <input type="hidden"
                                       name="Num1"
                                       value="@ViewBag.Num1" />

                                <input type="hidden"
                                       name="Num2"
                                       value="@ViewBag.Num2" />

                            </div>

                        </div>

                    </div>

                    <!-- Login Button -->
                    <div class="d-grid">

                        <button type="submit" class="btn btn-herbal">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                        </button>

                    </div>

                    <!-- Footer -->
                    <div class="text-center mt-4">
                        <a href="/" class="text-decoration-none text-success fw-semibold">
                            <i class="bi bi-arrow-left"></i>
                            Back to Home
                        </a>

                        <p class="mt-3 mb-0 text-muted"> 
                            Don't have an account? 
                            <a asp-controller="Home" asp-action="AddUser"
                               class="text-success fw-bold text-decoration-none"> 
                                Create Account 
                            </a> 
                        </p> 
                    </div>
                } 
            </div> 
        </div> 
    </div> 
</div>
<script src="~/js/jquery-3.7.1.min.js"></script>

