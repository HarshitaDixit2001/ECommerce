@{
    ViewData["Title"] = "Support Tickets";
}

<style>
    .tracking {
        position: relative;
    }

    .tracking-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: 25px;
    }

        .tracking-item:last-child {
            padding-bottom: 0;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 40px;
            width: 2px;
            height: calc(100% - 20px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

    .tracking-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tracking-content {
        padding-top: 5px;
    }

    .completed .tracking-content strong {
        color: #198754;
    }

    .active .tracking-content strong {
        color: #fd7e14;
    }
</style>
<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    🎫 Support Tickets
                </h1>

                <p class="breadcrumb-subtitle mb-0">
                    | Manage and track your support requests
                </p>
            </div>

            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/secure/user-dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            Support Tickets
                        </li>
                    </ol>
                </nav>
            </div>

        </div>
    </div>
</section>


<div class="row mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total Tickets</h6>
                <h3 class="text-primary mb-0">12</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Open</h6>
                <h3 class="text-warning mb-0">4</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Resolved</h6>
                <h3 class="text-success mb-0">6</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Closed</h6>
                <h3 class="text-danger mb-0">2</h3>
            </div>
        </div>
    </div>

</div>


<div class="row mb-3">

    <div class="col-md-2">
        <input type="text"
               id="from_date"
               class="form-control"
               placeholder="From Date" />
    </div>

    <div class="col-md-2">
        <input type="text"
               id="to_date"
               class="form-control"
               placeholder="To Date" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary" id="btnSearch">
            Search
        </button>
    </div>

    <div class="col-md-6 text-end">
        <a href="/home/raise-complaint"
           class="btn btn-success">
            <i class="bi bi-plus-circle"></i>
            Create Ticket
        </a>
    </div>

</div>

<div class="table-responsive">
    <table id="tblList"
           class="table table-striped table-hover display nowrap"
           style="width:100%">
    </table>
</div>


<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
<script>
       $(document).ready(function () {

        var ticketList = [

            {
                ticketNo: "TK10001",
                subject: "Order Not Delivered",
                category: "Order Issue",
                priority: "High",
                createdDate: "01-Aug-2026",
                status: "Open"
            },

            {
                ticketNo: "TK10002",
                subject: "Payment Failed",
                category: "Payment",
                priority: "Medium",
                createdDate: "05-Aug-2026",
                status: "Resolved"
            },

            {
                ticketNo: "TK10003",
                subject: "Refund Request",
                category: "Refund",
                priority: "Low",
                createdDate: "08-Aug-2026",
                status: "Closed"
            }

        ];

        $('#tblList').DataTable({

            destroy: true,
            responsive: true,
            pageLength: 10,
            data: ticketList,

            columns: [

                {
                    title: "#",
                    data: null,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },

                {
                    title: "Ticket No",
                    data: "ticketNo",
                    render: function (data) {
                        return `<span class="badge bg-primary">${data}</span>`;
                    }
                },

                {
                    title: "Subject",
                    data: "subject"
                },

                {
                    title: "Category",
                    data: "category"
                },

                {
                    title: "Priority",
                    data: "priority",
                    render: function (data) {

                        if (data === "High")
                            return '<span class="badge bg-danger">High</span>';

                        if (data === "Medium")
                            return '<span class="badge bg-warning text-dark">Medium</span>';

                        return '<span class="badge bg-success">Low</span>';
                    }
                },

                {
                    title: "Created Date",
                    data: "createdDate"
                },

                {
                    title: "Status",
                    data: "status",
                    render: function (data) {

                        if (data === "Open")
                            return '<span class="badge bg-warning text-dark">Open</span>';

                        if (data === "Resolved")
                            return '<span class="badge bg-success">Resolved</span>';

                        return '<span class="badge bg-secondary">Closed</span>';
                    }
                },

                {
                    title: "Action",
                    data: "ticketNo",
                    orderable: false,
                    render: function (data) {

                        return `
                            <a href="/secure/ticket-details/${data}"
                               class="btn btn-sm btn-outline-primary">
                               View
                            </a>
                        `;
                    }
                }

            ]

        });

    });
</script>
