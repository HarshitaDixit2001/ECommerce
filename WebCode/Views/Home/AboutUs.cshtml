@{
    ViewData["Title"] = "About-us Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 

<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    🌿 Trusted Ayurvedic Wellness Brand
                </h1>

                <p class="breadcrumb-subtitle mb-0">
                    | Natural Wellness Inspired by Ayurveda
                </p>
            </div>

            <div class="col-lg-6 text-lg-end">

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">

                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/Home/AboutUs">About-us</a>
                        </li> 
                    </ol>
                </nav>

            </div>

        </div>

    </div>
</section>



<!-- ========================= ABOUT US SECTION ========================= -->
<section class="about-section py-5">
    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Image -->
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=1200&q=80"
                         class="img-fluid rounded-4 shadow-lg w-100"
                         style="height:500px; object-fit:cover;"
                         alt="About Us">
                </div>
            </div>

            <!-- Content -->
            <div class="col-lg-6">

                <span class="badge bg-success-subtle text-success px-3 py-2 mb-3">
                    🌿 About Our Brand
                </span>

                <h2 class="fw-bold mb-4">
                    Bringing the Wisdom of Ayurveda to Modern Living
                </h2>

                <p class="text-muted mb-3">
                    At <strong>@Const.COM_NAME</strong>, we believe that true wellness begins with nature.
                    Our mission is to provide premium-quality Ayurvedic and wellness products that help people
                    live healthier, happier, and more balanced lives.
                </p>

                <p class="text-muted mb-4">
                    We carefully select products made from trusted herbal ingredients and traditional Ayurvedic
                    formulations. Every product is chosen with a commitment to quality, authenticity, and customer satisfaction.
                </p>

                <div class="row g-3">

                    <div class="col-sm-6">
                        <div class="about-feature">
                            <i class="bi bi-flower1"></i>
                            <span>100% Natural Products</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="about-feature">
                            <i class="bi bi-shield-check"></i>
                            <span>Quality Assured</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="about-feature">
                            <i class="bi bi-truck"></i>
                            <span>Fast Delivery</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="about-feature">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Customer Wellness Focused</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<section class="py-5 bg-light">
    <div class="container">

        <div class="row g-4">

            <div class="col-md-6">
                <div class="mission-card h-100">

                    <i class="bi bi-bullseye display-5 text-success"></i>

                    <h3 class="mt-3 mb-3">
                        Our Mission
                    </h3>

                    <p class="text-muted">
                        To make natural wellness accessible to every household by providing
                        authentic Ayurvedic products that support a healthy lifestyle and long-term well-being.
                    </p>

                </div>
            </div>

            <div class="col-md-6">
                <div class="mission-card h-100">

                    <i class="bi bi-eye display-5 text-success"></i>

                    <h3 class="mt-3 mb-3">
                        Our Vision
                    </h3>

                    <p class="text-muted">
                        To become a trusted destination for Ayurvedic wellness by combining
                        traditional knowledge with modern convenience and customer care.
                    </p>

                </div>
            </div>

        </div>

    </div>
</section>



<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">
                Why Choose Us
            </h2>

            <p class="text-muted">
                Trusted by customers for quality, authenticity, and service excellence.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="choose-card">
                    <i class="bi bi-flower1"></i>
                    <h5>Natural Ingredients</h5>
                    <p>Carefully selected herbal ingredients for everyday wellness.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="choose-card">
                    <i class="bi bi-patch-check"></i>
                    <h5>Trusted Quality</h5>
                    <p>Products sourced with a focus on purity and authenticity.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="choose-card">
                    <i class="bi bi-credit-card"></i>
                    <h5>Secure Shopping</h5>
                    <p>Safe payment methods and hassle-free checkout experience.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="choose-card">
                    <i class="bi bi-headset"></i>
                    <h5>Dedicated Support</h5>
                    <p>Friendly support team ready to assist you at every step.</p>
                </div>
            </div>

        </div>

    </div>
</section>
<script src="~/js/jquery-3.7.1.min.js"></script>