@{
    ViewData["Title"] = "News";
}

<!-- ================= HERO SECTION ================= -->
<section class="hero-section text-center">
    <div class="container">
        <h1 class="animate__animated animate__fadeInDown">
            Company News & Updates
        </h1>

        <p class="animate__animated animate__fadeInUp">
            Latest news, updates and announcements from @Const.COM_TITLE
            about software development, technology and company growth.
        </p>
    </div>
</section>


<!-- ================= NEWS SECTION ================= -->

<section class="py-5">
    <div class="container"> 
        <div class="row">
            <!-- NEWS 1 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085"
                         class="card-img-top">
                    <div class="card-body">
                        <h5 class="fw-bold">
                            New MLM Software Version Released
                        </h5>

                        <p class="text-muted">
                            July @DateTime.Now.Year
                        </p>

                        <p>
                            @Const.COM_TITLE has launched a new version
                            of MLM Software with improved performance,
                            faster payout processing and better admin tools.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>


            <!-- NEWS 2 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c"
                         class="card-img-top">

                    <div class="card-body">
                        <h5 class="fw-bold">
                            New Ecommerce Platform Development
                        </h5>

                        <p class="text-muted">
                            July @DateTime.Now.Year
                        </p>

                        <p>
                            Our team successfully developed a new
                            Ecommerce platform with product management,
                            order tracking and secure payment integration.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>


            <!-- NEWS 3 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71"
                         class="card-img-top">

                    <div class="card-body">
                        <h5 class="fw-bold">
                            CRM Software for Business Automation
                        </h5>

                        <p class="text-muted">
                            June @DateTime.Now.Year
                        </p>

                        <p>
                            We launched a new CRM system that helps
                            businesses manage leads, customers and
                            sales operations efficiently.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>


            <!-- NEWS 4 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216"
                         class="card-img-top">

                    <div class="card-body">
                        <h5 class="fw-bold">
                            Flutter Mobile App Development Service
                        </h5>

                        <p class="text-muted">
                            June @DateTime.Now.Year
                        </p>

                        <p>
                            @Const.COM_TITLE now provides Flutter mobile
                            app development services for Android and
                            iOS platforms.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>


            <!-- NEWS 5 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa"
                         class="card-img-top">

                    <div class="card-body">
                        <h5 class="fw-bold">
                            Plot Booking Software Launch
                        </h5>

                        <p class="text-muted">
                            May @DateTime.Now.Year
                        </p>

                        <p>
                            Our company launched a new Plot Booking
                            Management Software for real estate
                            companies and property developers.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>


            <!-- NEWS 6 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow border-0 h-100">
                    <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d"
                         class="card-img-top">

                    <div class="card-body">
                        <h5 class="fw-bold">
                            Software Development Training Program
                        </h5>

                        <p class="text-muted">
                            May @DateTime.Now.Year
                        </p>

                        <p>
                            @Const.COM_TITLE started a software
                            development training program for
                            students interested in IT careers.
                        </p>

                        <a href="#" class="btn btn-primary btn-sm">
                            Read More
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

 
<script src="~/js/jquery-3.7.1.min.js"></script>