@model List<StockTranViewModel>
@{
    ViewData["Title"] = "Stock Detail";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Stock Detail
    </h4>
</section>

<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">

                <div class="panel-body">
                    <div class="table-responsive mb-4">

                        <table id="stockTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Product Qty</th>
                                    <th>DOE</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>@item.product_with_packsize</td>
                                            <td>@item.qty</td>
                                            <td>@item.product_qty</td>
                                            <td>@item.doe?.ToString("dd-MM-yyyy")</td>
                                            <td>@item.invoice_no</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">No data found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")


<script>
    $(document).ready(function () {
        var table = $('#stockTable').DataTable({
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            lengthChange: true,
            pageLength: -1,
            lengthMenu: [[50, 100, -1], [50, 100, "All"]],
            order: [[4, 'desc']],
            dom: 'Bflrtip',
            buttons: [
                { extend: 'excelHtml5', title: 'Stock_Detail',  exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', title: 'Stock_Detail', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', title: 'Stock_Detail', orientation: 'landscape', pageSize: 'A4', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            columnDefs: [
                { targets: 0, orderable: false, searchable: false }, // Serial no
                { targets: [2, 3], className: 'text-end' },
                { targets: '_all', className: 'text-start' }
            ]
        });
        table.on('order.dt search.dt draw.dt', function () { table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) { cell.innerHTML = i + 1; }); }).draw();
    });
</script>

