@await Html.PartialAsync("_DatatableScript") 


<script>
    let URL_LIST = `/print/admin-invoice-seller-detail`;
    $(function () {
        const pathSegments = window.location.pathname.split('/');
        const inv_id = pathSegments[pathSegments.length - 1];
        if(parseInt(inv_id)>0){
            Get_Seller_Details(inv_id);
            Bind_HSNCode_Data(inv_id);
        }
    });


    function Get_Seller_Details(inv_id) {
        $.ajax({
            url: URL_LIST + `?inv_id=${inv_id}`,
            method: 'GET',
            contentType: 'application/json',
            success: function (response) {
                if (response.success === true) {
                     const dataArray = JSON.parse(response.data) || [];
                     const data = dataArray[0] || {};


                      $('#order_no').text(data.order_no);
                      $('#invoice_no').text(data.invoice_no);
                      $('#doe').text(data.doe);


                      $('#buyer_name').text(data.buyer_name);
                      $('#buyer_mobile').text(data.buyer_mobile);
                      $('#buyer_address_line').text(data.buyer_full_address);
                      $('#buyer_state').text(data.buyer_state);


                      $('#shipper_name').text(data.shipper_name);
                      $('#shipper_mobile').text(data.shipper_mobile);
                      $('#shipper_state').text(data.shipper_state);
                      $('#shipper_address').text(data.shipper_full_address);


                      $('#t_gross').text(data.t_gross);
                      $('#t_tax_rs').text(data.t_tax_rs);
                      $('#amount').text(data.amount);

                      $('#discount').text(data.discount);
                      $('#del_charge').text(data.del_charge);
                      $('#adjust_amt').text(data.adjust_amt);
                      $('#t_amount').text(data.t_amount);
                      $('#gross_weight').text(data.gross_weight);
                      $('#shipper_name').text(data.shipper_name);


                      $('#transport').text(data.transport);
                      $('#tracking').text(data.tracking);
                      $('#remark').text(data.remark);
                      
                      if (data.status == 1) {
                          $('#status').text("OK").removeClass("cancelled").addClass("ok");
                      }
                      else if (data.status == 2) {
                          $('#status').text("CANCELLED").removeClass("ok").addClass("cancelled");
                      }

                      $('#id_last_digit_inv').text(data.invoice_no.split("/").pop());
                 }
            },
            error: function (res_error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    }



     function Bind_HSNCode_Data(inv_id) {
         let URL_LIST = `/common/master-reports`;
          let mst_key="GET_ADMIN_HSNCODE_WISE_INVOICE";
         $.ajax({
             url: URL_LIST + `?mst_key=${mst_key}&id=${inv_id}`,
             type: 'GET',
             success: function (response) {

                if (response.success === true) {
                     const data = JSON.parse(response.data) || [];
                     $('#tblHSNCodeList').DataTable({
                        dom: 'Blrtip',
                        scrollY: "500px",
                        scrollX: true,
                        scrollCollapse: true,
                        destroy: true,
                        responsive: true,
                        autoWidth: true,
                        paging: false,
                        ordering: false,
                        info: false, // 🔴 Hides "Showing X to Y of Z entries"
                        language: { emptyTable: "No records found" },
                        pageLength: -1,
                             data: data,
                             columns: [
                             { data: 'hsncode', title: 'HSN CODE' },
                             { data: 'tax', title: 'GST Rate	' },
                             { data: 'gross', title: 'Taxable Value	' },
                             { data: 'cgst', title: 'CGST' },
                             { data: 'sgst', title: 'SGST' },
                             { data: 'igst', title: 'IGST' },
                         ],
                         "footerCallback": function (row, data, start, end, display) {
                             const api = this.api();
                             const getTotal = (index) => {
                                return api.column(index, { page: 'current' }).data().reduce((a, b) => {
                                    const x = parseFloat(a) || 0;
                                    const y = parseFloat(b) || 0;
                                    return x + y;
                                }, 0);
                             };

                            $(api.column(2).footer()).html(getTotal(2).toFixed(2));
                            $(api.column(3).footer()).html(getTotal(3).toFixed(2));
                            $(api.column(4).footer()).html(getTotal(4).toFixed(2));
                            $(api.column(5).footer()).html(getTotal(5).toFixed(2));

                         }
                     });
                 }
             },
             error: function (xhr, status, error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }
</script>




