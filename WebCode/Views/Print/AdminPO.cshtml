</header>



<table>
    <thead>
        <tr style="background: #d1d2d4;">
            <th class="service total-bold">#</th>
            <th class="service total-bold">Product Name</th>
            <th class="desc total-bold">HSN Code</th>
            <th class="total-bold hide-xs">ActQ</th>
            <th class="total-bold hide-xs">Qty</th>

            <th class="total-bold hide-xs">MRP</th>
            <th class="total-bold hide-xs">Rate</th>
            <th class="total-bold hide-xs">Gross</th>
            <th class="total-bold hide-xs">Tax %</th>
            <th class="total-bold hide-xs">Tax Rs</th>
            <th class="total-bold hide-xs">Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @{
            int totalActQ = 0;
            int totalQty = 0;
            decimal totalGross = 0;
            decimal totalTax = 0;
            decimal totalAmount = 0;
            int serialNo = 1;
        }
        @foreach (var item in Model)
        {
            totalActQ += item.actual_qty ?? 0;
            totalQty += item.qty ?? 0;

            totalGross += item.gross ?? 0;
            totalTax += item.gst_amt ?? 0;
            totalAmount += item.total_amt ?? 0;

            <tr>

                <td class="service">@serialNo</td>
                <td class="desc">
                    @item.prod_code - @item.prod_name<br />
                    Mfg: @item.mfg_date<br />
                    Exp: @item.exp_date
                    @if (item.prod_type == 3)
                    {
                        <span style="color:forestgreen;">(Sample)</span>
                    }
                </td>

                <td class="text-start">@item.hsncode</td>
                <td class="total hide-xs" style="text-align: center;">@item.actual_qty</td>
                <td class="total hide-xs" style="text-align: center;">@item.qty</td>
                <td class="total hide-xs" style="text-align: right;">@item.mrp</td>
                <td class="total hide-xs" style="text-align: right;">@item.price</td>
                <td class="total hide-xs" style="text-align: right;">@item.gross</td>
                <td class="total hide-xs" style="text-align: center;">@(item.gst) %</td>
                <td class="total hide-xs" style="text-align: right;">@item.gst_amt</td>
                <td class="total hide-xs" style="text-align: right;">@item.total_amt</td>
            </tr>
            serialNo++;
        }
    </tbody>
    <tfoot class="fw-bold">
        <tr>
            <td colspan="3" class="text-end">Total</td>
            <td class="total-bold" style="text-align: right;">@totalActQ</td>
            <td class="total-bold" style="text-align: right;">@totalQty</td>
            <td class="text-end"></td>
            <td class="text-end"></td>
            <td class="total-bold" style="text-align: right;">@totalGross</td>
            <td class="text-end"></td>
            <td class="total-bold" style="text-align: right;">@totalTax</td>
            <td class="total-bold" style="text-align: right;">@totalAmount</td>
        </tr>
    </tfoot>
</table>

