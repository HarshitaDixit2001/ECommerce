@await Html.PartialAsync("_DatatableScript") 
<script>
    let URL_LIST = `/print/admin-po-seller-detail`;
    $(function () {
        const pathSegments = window.location.pathname.split('/');
        const order_id = pathSegments[pathSegments.length - 1];
        if(parseInt(order_id)>0){
            Get_Seller_Details(order_id);
        }
    });


    function Get_Seller_Details(order_id) {
        $.ajax({
            url: URL_LIST + `?order_id=${order_id}`,
            method: 'GET',
            contentType: 'application/json',
            success: function (response) {
                if (response.success === true) {
                     const dataArray = JSON.parse(response.data) || [];
                     const data = dataArray[0] || {};


                      $('#order_no').text(data.order_no);
                      $('#doe').text(data.doe);


                      $('#buyer_name').text(data.buyer_name);
                      $('#buyer_mobile').text(data.buyer_mobile);
                      $('#buyer_full_address').text(data.buyer_full_address);
                      $('#buyer_state').text(data.buyer_state);


                      $('#shipper_name').text(data.shipper_name);
                      $('#shipper_mobile').text(data.shipper_mobile);
                      $('#shipper_state').text(data.shipper_state);
                      $('#shipper_full_address').text(data.shipper_full_address);


                      $('#t_gross').text(data.t_gross);
                      $('#t_tax_rs').text(data.t_tax_rs);
                      $('#t_amount').text(data.t_amount);


                      if (data.status == 1) {
                          $('#status').text("OK").removeClass("cancelled").addClass("ok");
                      }
                      else if (data.status == 2) {
                          $('#status').text("CANCELLED").removeClass("ok").addClass("cancelled");
                      }

                      $('#id_last_digit_inv').text(data.order_no.split("/").pop());
                 }
            },
            error: function (res_error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    }
</script>


<style>
    .total-bold1 table tr td, .total-bold1 table tr th {
