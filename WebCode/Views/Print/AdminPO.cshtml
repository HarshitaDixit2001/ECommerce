    /* Normal status text */
    #status {
        font-weight: bold;
        font-size: 18px;
    }

        /* OK style */
        #status.ok {
            color: green;
        }

        /* Cancelled = always center big watermark */
        #status.cancelled {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
