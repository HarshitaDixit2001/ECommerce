<div class="clearfix"></div>

<br />
<br />
<br />
<script src="~/webtemplate/js/jquery.min.js"></script>

@await Html.PartialAsync("_DatatableScript") 


<script>
    let URL_LIST_DETAIL = `/print/vendor-po`;
    let URL_LIST_PRODUCT= `/print/vendor-product-detail`;
    $(function () {
        const pathSegments = window.location.pathname.split('/');
        const purchase_id = pathSegments[pathSegments.length - 1];
        if(parseInt(purchase_id)>0){
            Get_Seller_Details(purchase_id);
            Get_Product_Details(purchase_id);
        }
    });


    function Get_Seller_Details(purchase_id) {
        $.ajax({
            url: URL_LIST_DETAIL + `?purchase_id=${purchase_id}`,
            method: 'GET',
            contentType: 'application/json',
            success: function (response) {
                if (response.success === true) {
                    debugger;
                     const dataArray = JSON.parse(response.data) || [];
                     const data = dataArray[0] || {};

                      $('#purchase_order_no').text(data.purchase_order_no);
                      $('#doe').text(data.doe);
                      $('#shipper_name').text(data.shipper_name);
                      $('#shipper_mobile').text(data.shipper_mobile);
                      $('#shipper_email').text(data.shipper_email);
                      $('#shipper_state').text(data.shipper_state);
                      $('#t_gross').text(data.t_gross);
                      $('#t_tax_rs').text(data.t_tax_rs);
                      $('#t_amount').text(data.t_amount);

                 }
            },
            error: function (res_error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    }





    function Get_Product_Details(purchase_id) {
        $.ajax({
            url: URL_LIST_PRODUCT + `?purchase_id=${purchase_id}`,
            method: 'GET',
            contentType: 'application/json',
            success: function (response) {
                debugger;

                if (response.success === true) {
                     const data = JSON.parse(response.data) || [];
                     $('#tblList').DataTable({
                        dom: 'Blrtip',
                        scrollY: "500px",
                        scrollX: true,
                        scrollCollapse: true,
                        destroy: true,
                        responsive: true,
                        autoWidth: true,
                        paging: false,
                        ordering: false,
                        info: false, // 🔴 Hides "Showing X to Y of Z entries"
                        language: { emptyTable: "No records found" },
                        pageLength: -1,
                             data: data,
                             columns: [
                                 { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                                 { data: 'product_full_name', title: 'Product Name' },
                                 { data: 'qty', title: 'Qty' },
                                 { data: 'price', title: 'Rate' },
                                 { data: 'gross', title: 'Gross' },
                                 { data: 'tax', title: 'Tax %' },
                                 { data: 'taxrs', title: 'GST' },
                                 { data: 'total', title: 'Total Amount' },

                         ],
                         "footerCallback": function (row, data, start, end, display) {
                             const api = this.api();
                             const getTotal = (index) => {
                                return api.column(index, { page: 'current' }).data().reduce((a, b) => {
                                    const x = parseFloat(a) || 0;
                                    const y = parseFloat(b) || 0;
                                    return x + y;
                                }, 0);
                             };


                            $(api.column(2).footer()).html(getTotal(2));
                            $(api.column(4).footer()).html(getTotal(4).toFixed(2));
                            $(api.column(6).footer()).html(getTotal(6).toFixed(2));
                             $(api.column(7).footer()).html(getTotal(7).toFixed(2));

                         }
                     });
                 }



            },
            error: function () {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
            }
        });
    }








</script>




