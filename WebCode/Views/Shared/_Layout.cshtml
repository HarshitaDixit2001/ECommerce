    <script>
        let URL_ADD_CART = `/cart/add-cart-data`;
        let URL_COUNT_CART = `/cart/get-count-cart-data`;
        const cart_id=3;

        function AddToCart(cid, pid, qty, callback){
             let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
             if(uid =="")
             {
                 const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                 loginModal.show();
             }
             else{
                 $.ajax({
                     url: URL_ADD_CART,
                     method: 'GET',
                     data: { cart_id :cart_id, uid: uid, pid: pid, cid: cid, qty: qty},
                     contentType: 'application/json',
                     success: function (response) {
                         if(response.success == true){
                             //showRightSideCart();
                             updateMstCartUI();
                             showToastSuccess('Item Added.');

                             // 🔥 update cart count + shake
                             let $badge = $('#CartCount');
                             $badge.removeClass('cart-animate');
                             void $badge[0].offsetWidth;
                             $badge.addClass('cart-animate');
                             flyToCart(pid);

                             if (typeof callback === 'function') {
                                 callback();
                             }

                         }else{
                              showErrorLog(`@Const.ERROR_HEADER`, response.message);
                         }
                     },
                     error: function (xhr) { showErrorLog(`@Const.ERROR_HEADER`, xhr); }
                 });
             }
        }


        function flyToCart(pid) {

            let $btn = $('#' + pid);
            let $card = $btn.closest('.product-card');
            let $img = $card.find('.product-img');
            let $cart = $('#cartBtn');
            let $badge = $('#CartCount');

            if ($img.length === 0 || $cart.length === 0) return;

            let imgOffset = $img.offset();
            let cartOffset = $cart.offset();

            let startX = imgOffset.left + ($img.width() / 2);
            let startY = imgOffset.top + ($img.height() / 2);

            let endX = cartOffset.left + ($cart.width() / 2);
            let endY = cartOffset.top + ($cart.height() / 2);

            // create clone
            let $clone = $img.clone()
                .appendTo('body')
                .css({
                    position: 'fixed',
                    top: startY,
                    left: startX,
                    width: 60,
                    height: 60,
                    borderRadius: '50%',
                    zIndex: 9999,
                    pointerEvents: 'none'
                });

            // 🔥 animate with curve
            $clone.animate({
                left: endX,
                top: endY
            }, {
                duration: 700,
                easing: 'swing',
                step: function (now, fx) {

                    if (fx.prop === "top") {
                        let progress = fx.pos;
                        let curve = Math.sin(progress * Math.PI) * -80;
                        $(this).css("top", now + curve);
                    }

                    let scale = 1 - (fx.pos * 0.7);
                    $(this).css({
                        transform: "translate(-50%, -50%) scale(" + scale + ")",
                        opacity: 1 - fx.pos
                    });
                },

                complete: function () {
                    $(this).remove();

                    // ✅ AFTER animation → update cart UI


                    // 2. Show badge if hidden
                    $badge.show();

                    // 3. Shake animation
                    $badge.removeClass('cart-animate');
                    void $badge[0].offsetWidth;
                    $badge.addClass('cart-animate');

                    // 4. Optional: cart icon bounce
                    $cart.addClass('cart-animate');
                    setTimeout(() => $cart.removeClass('cart-animate'), 700);
                }
            });
        }



        function UserLogin(){
            let login_id=$('#mst_login_id').val();
            let password=$('#mst_password').val();
            let Sum_input=$('#Sum_input').val();
            let Num1=$('#Num1').val();
            let Num2=$('#Num2').val();
            if(login_id ==""){
                showErrorLog(`@Const.ERROR_HEADER`, "Please enter user id.!");
                return;
            }
            if(password ==""){
                showErrorLog(`@Const.ERROR_HEADER`, "Please enter password.!");
                return;
            }
            if(Sum_input ==""){
                showErrorLog(`@Const.ERROR_HEADER`, "Please enter captcha.!");
                return;
            }
            var payload = {
                login_id: login_id,
                password: password,
                Sum_input: Sum_input,
                Num1: Num1,
                Num2: Num2
            };
            $.ajax({
                url: "/home/MasterLogin",
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if(response =="1"){
                         showToastSuccess('✅ User logged in successfully!');
                         setTimeout(function () { location.reload(); }, 1000);
                    }else{  showErrorLog(`@Const.ERROR_HEADER`, response); }
                },
                error: function (xhr) {  showErrorLog(`@Const.ERROR_HEADER`, xhr); }
            });
        }


        function updateMstCartUI(){
            const $items = $('#cartItems').empty();
            let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
            if(uid !=""){
                $.ajax({
                   url: `/cart/get-cart-data`,
                   data: { cart_id: cart_id, uid: uid },
                   type: 'GET',
                   success: function (response) {
                       if (response.success === true) {
                            const cart = JSON.parse(response.data) || [];
                            if (cart.length === 0) {
                                $items.append(`
                                    <div class="text-center py-5">
                                        <i class="bi bi-cart-x" style="font-size: 3rem; color: #d1d5db;"></i>
                                        <p class="text-muted mt-3 mb-0" style="font-size: 1rem;">Your cart is empty</p>
                                        <a href="/product" class="btn btn-primary btn-sm mt-3" style="background-color: #1565C0; border-color: #1565C0;">
                                            <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                                        </a>
                                    </div>
                                `);
                                $('#cartSubtotal').text(formatINR(0));
                                $('#CartCount').text(0);
                                return;
                            }

                            let subtotal = 0;
                            let str_line =``;
                            cart.forEach(item => {
                                let img = item.img1 ? `/${item.img1}` : `/images/noimage.jpg`;
                                subtotal += (item.t_amount);
                                const prodName = item.prod_name.length > 30 ? item.prod_name.substring(0, 30) + "..." : item.prod_name;
                                const line = `
                                    <div class="cart-item-card mb-3 p-3 border rounded-3" style="background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                        <div class="d-flex gap-3 align-items-start">
                                            <img src="${img}" width="80" height="80" style="object-fit:cover; border-radius: 8px;" class="border" alt="${prodName}">
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold mb-1" style="color: #0f172a; font-size: 0.95rem; line-height: 1.3;">${prodName}</div>
                                                <div class="small text-muted mb-2">Code: ${item.prod_code}</div>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div>

                                                        <div class="small text-muted">Qty: ${item.qty}</div>
                                                    </div>
                                                    <div class="text-end">

                                                        <div class="fw-bold text-success" style="font-size: 0.95rem;">${formatINR(item.t_amount)}</div>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mt-2">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                         <button class="btn btn-outline-danger" type="button" onclick="mst_changeQty(${item.cid}, -1)" style="border-color: #dc3545; color: #dc3545;">
                                                            <i class="bi bi-dash"></i>
                                                        </button>
                                                        <input type="number" min="1" maxlength="7" value="${item.qty}" class="form-control cart-qty-input text-center"
                                                         id="mst_qty-${item.cid}" style="width: 60px;" oninput="this.value = this.value.slice(0, 7);"
                                                         onchange="mst_changeQtyDirect(${item.cid}, this.value)" />
                                                        <button class="btn btn-outline-success" type="button" onclick="mst_changeQty(${item.cid}, 1)" style="border-color: #4CAF50; color: #4CAF50;">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                    <button class="btn btn-sm btn-link text-danger p-0 ms-auto" onclick="Delete_By_Id('MST',${item.cid})" style="text-decoration: none; font-size: 0.85rem;">
                                                        <i class="bi bi-trash me-1"></i>Remove
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `;
                               str_line +=line;
                            });
                            //$items.empty();
                            $items.empty().append(str_line);

                            $('#cartSubtotal').text(formatINR(subtotal));
                            $('#CartCount').text(cart.length);
                        }
                   },
                   error: function (xhr, status, error) {
                       //window.location.href = `@Const.LOGOUT`; return;
                   }
                });
            }
        }


        function mst_changeQty(cid, value) {
              let mst_input = document.getElementById(`mst_qty-${cid}`);
              let mst_currentQty = parseInt(mst_input.value) || 1;
              let mst_newQty = mst_currentQty + value;
              mst_newQty = Math.min(Math.max(mst_newQty, 1), 999999);
              mst_input.value = mst_newQty;
              AddToCart(cid, 0, mst_newQty, updateMstCartUI);
        }


        function mst_changeQtyDirect(cid, value) {
             let mst_newQty = parseInt(value) || 1;
             mst_newQty = Math.min(Math.max(mst_newQty, 1), 999999);
             document.getElementById(`mst_qty-${cid}`).value = mst_newQty;
             AddToCart(cid, 0, mst_newQty, updateMstCartUI);
        }


        function Delete_By_Id(type, id){
              $.ajax({
                  url: `/cart/delete-cart-data`,
                  data: { id: id },
                  type: 'GET',
                  contentType: 'application/json',
                  success: function (response) {
                       if(response.success == true){
                           if(type =="CART"){
                               BindTableData();
                           }
                           updateMstCartUI();
                       }
                      else{ showErrorLog(`@Const.ERROR_HEADER`, response.message); }
                  },
                  error: function (res_error) {
                  }
              });
          }
    </script>


    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-md">

            <div class="modal-content rounded-4 shadow-lg overflow-hidden">

                <!-- Header -->
                <div class="modal-herbal-header px-4 py-4 text-center">

                    <h4 class="mb-2">
                        🌿 Secure Sign In
                    </h4>

                    <p class="mb-0">
                        Access your wellness account safely and securely
                    </p>

                </div>

                <!-- Body -->
                <div class="modal-body p-4">

                    <!-- Login ID -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Login ID
                        </label>

                        <div class="input-group">

                            <span class="input-group-text herbal-icon">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <input type="text" id="mst_login_id" name="mst_login_id"
                                   class="form-control herbal-input" maxlength="30" required>

                        </div>

                    </div>

                    <!-- Password -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text herbal-icon">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                            <input type="password" id="mst_password" name="mst_password"
                                   class="form-control herbal-input" maxlength="30" required>
                        </div>

                    </div>

                    <!-- Captcha -->
                    <div class="captcha-box mb-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="fw-semibold">
                                Security Check:
                            </span>

                            <span class="fw-bold text-success">
                                @ViewBag.Num1 + @ViewBag.Num2 =
                            </span>

                            <input type="number" id="Sum_input" name="Sum_input"
                                   class="form-control form-control-sm"
                                   style="width:120px;" placeholder="Answer" required>

                        </div>

                        <input type="hidden" id="Num1" value="@ViewBag.Num1">
                        <input type="hidden" id="Num2" value="@ViewBag.Num2">

                    </div>

                    <!-- Login Button -->
                    <div class="d-grid">

                        <button type="button" class="btn btn-herbal btn-lg" onclick="UserLogin()">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login
                        </button>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer justify-content-between px-4 py-3">
                    <a href="/" class="text-decoration-none">
                        ← Back to Home
                    </a>

                    <div>
                        <small class="text-muted">
                            New Customer?
                        </small>
                        <a asp-controller="Home" asp-action="AddUser" class="text-decoration-none ms-1">
                            Register Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

     
</body>
</html>

