@{
    ViewData["Title"] = "Repurchase_Payout_Dispatch_User";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@* <link href="~/webtemplate/gridtbl/datatables.datatables.css" rel="stylesheet" />
