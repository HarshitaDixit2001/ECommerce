@{
    ViewData["Title"] = "Repurchase_Payout_Dispatch_User";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 

<!-- Breadcrumb -->
@* <section class="content-header">
    <ol class="breadcrumb pull-right"> 
        <li><a asp-action="repurchase-payout-dispatch" asp-controller="payout"><i class="fa fa-list"></i> Repurchase Payout Dispatched</a></li>
    </ol>
</section> *@
@{
    var role_name = User.FindFirst("role_name")?.Value;
}
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Repurchase Payout Dispatched
    </h4>
</section>
<br />

<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@
<script>

    let table;
    let token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
    const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const URL_LIST = `@Const.BASE_URL/payout/get-matrix-monthly-payout-list`;
    const DOWNLOAD_FILE_NAME = "Matrix_Monthly_payout_dispatch";


    $(function () {
        initializeTable();
    });



    function initializeTable() {
        table = $('#tblList').DataTable({
            processing: true,
            serverSide: true,
            scrollX: true,
            ordering: false,
            autoWidth: true,
            responsive: true,
            pageLength: '@Const.NO_OF_PAGE_RECORDS',
            dom: 'Bfrtip',
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                'colvis'
            ],
            ajax: {
                url: URL_LIST,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + token },
                data: function (d) {
                    const parseDate = (dateStr) => {
                        if (!dateStr) return null;
                        const parts = dateStr.split("-");
                        return parts.length === 3 ? `${parts[1]}-${parts[0]}-${parts[2]}` : null;
                    };
                    const in_page_record = d.length || 10;
                    const in_page_no = Math.floor(d.start / in_page_record) + 1;
                    return JSON.stringify({
                        uid: uid,
                        in_page_no: in_page_no,
                        in_page_record: in_page_record
                    });
                },
                dataSrc: function (json) {
                    if(json.token_valid === false){
                        window.location.href = `@Const.LOGOUT`; return;
                    }
                    let data = [];
                    try { data = JSON.parse(json.data || "[]"); } catch (e) { console.error(e); }
                    json.recordsTotal = json.total_count || 0;
                    json.recordsFiltered = json.total_count || 0;
                    return data;
                }
            },
             columns: [
                 { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                 { data: 'payout_no', title: 'Edit',
                      render: (data, type, row) => {
                        return `
                          <div class="d-flex align-items-center justify-content-between" style="gap: 8px;">
                            <a href="/Payout/Edit?payout_no=${data}&uid=${row.uid}" target="_blank" title="Edit">
                              <i class="fa fa-edit text-warning"></i>
                            </a> </div> `;
                     }
                 },
                 { data: 'payout_no', title: 'Payout #'},
                 { data: 'from_date', title: 'From Date',  render: (data) => data ? new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                 { data: 'to_date', title: 'To Date',  render: (data) => data ? new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                 { data: 'user_id', title: 'User Id'},
                 { data: 'user_name', title: 'Name'},
                 { data: 'pbv', title: 'PBV'},
                 { data: 'gbv', title: 'GBV'},

                 { data: 'inc_1', title: 'Income 1'},
                 { data: 'inc_2', title: 'Income 2'},
                 { data: 'inc_3', title: 'Income 3'},
                 { data: 'inc_4', title: 'Income 4'},
                 { data: 'inc_5', title: 'Income 5'},
                 { data: 'inc_6', title: 'Income 6'},
                 { data: 'inc_7', title: 'Income 7'},
                 { data: 'inc_8', title: 'Income 8'},
                 { data: 'inc_9', title: 'Income 9'},
                 { data: 'inc_10', title: 'Income 10'},

                 { data: 'total_inc', title: 'Total Income'},
                 { data: 'tds', title: 'TDS'},
                 { data: 'hc', title: 'Admin Charge'},
                 { data: 'dispache_inc', title: 'Dispached'},
                 { data: 'pan_tax', title: 'Tax(%)'},
                 { data: 'pan_verify', title: 'Pan Verify', orderable: false,
                      render: (d) => {
                            const s = { 0: ['No', 'text-danger'], 1: ['Yes', 'text-success'] }[+d] || ['Unknown', 'text-secondary'];
                            return `<span><i class="fa fa-circle ${s[1]} me-1"></i> ${s[0]}</span>`;
                      }
                 },
                 { data: 'bank_verify', title: 'Bank Verify', orderable: false,
                      render: (d) => {
                            const s = { 0: ['No', 'text-danger'], 1: ['Yes', 'text-success'] }[+d] || ['Unknown', 'text-secondary'];
                            return `<span><i class="fa fa-circle ${s[1]} me-1"></i> ${s[0]}</span>`;
                      }
                 },
                 { data: 'payout_no', title: 'Print',
                      render: (data, type, row) => {
                        return `
                          <div class="d-flex align-items-center justify-content-between" style="gap: 8px;">
                            <a href="/Payout/Print?payout_no=${data}&uid=${row.uid}" target="_blank" title="Print">
                              <i class="fa fa-print text-success"></i>
                            </a>
                          </div>
                        `;
                      }
                  }
             ],
        });
    }
</script>

