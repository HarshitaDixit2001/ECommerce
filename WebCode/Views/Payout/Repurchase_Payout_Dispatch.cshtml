@{
    ViewData["Title"] = "Repurchase_Payout_Dispatch";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Payout Dispatched
    </h4>
</section>
<div class="clearfix"></div>
<br />

<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="row mb-3">
                <div class="col-sm-4">
                    <select id="payout_no" asp-items="ViewBag.MatrixPayoutList" class="form-control select2">
                        <option value="0">🔍 Search Payout</option>
                    </select>
                </div>
                <div class="col-sm-2">
                    <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="panel-body">
                <div class="table-responsive mb-4">
                    <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end"></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>

                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")

<script>

    let table;
    let token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
    const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const URL_LIST = `/payout/get-repurchase-payout-dispatch`;
    const DOWNLOAD_FILE_NAME = "Matrix_Monthly_payout_dispatch";


    $(function () {

        @if (TempData["Success"] != null)
        {
                <text>
                showSuccessMessage(`@Const.SUCCESS_HEADER`, `@Html.Raw(TempData["Success"])`);
                </text>
        }

        initializeTable();
        $('#btnSearch').on('click', function () {  table.ajax.reload(); });
    });



    function initializeTable() {
        table = $('#tblList').DataTable({
            dom: 'Blfrtip',
            scrollY: "500px",
            processing: true,
            scrollX: true,
            autoWidth: true,
            responsive: true,
            destroy: true,
            lengthMenu: [[25, 100, -1], [25, 100, "All"]],
            pageLength: @Const.NO_OF_PAGE_RECORDS,
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                { extend: 'copyHtml5', text: 'Copy'},
                'fullscreenToggle',
                'colvis',
            ],
            ajax: {
                url: URL_LIST,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + token },
                data: function (d) {
                    const payout_no = parseInt($('#payout_no').val()) || 0;
                    if (payout_no <= 0) {
                        showErrorLog(`@Const.ERROR_HEADER`, 'Please select a valid payout number before searching.');
                        return false; // 🚫 stops the request
                    }

                    return JSON.stringify({
                        payout_no: payout_no,
                        uid: null,
                        status: null
                    });


                    return JSON.stringify({
                        payout_no: $('#payout_no').val(),
                        uid: null,
                        status: null
                    });
                },
                dataSrc: json => json?.data || []
            },
             columns: [
                 { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },

                 { data: 'payout_period', title: 'Payout Period'},
                 { data: 'user_id', title: 'User Id'},
                 { data: 'user_name', title: 'Name'},
                 { data: 'collection_amt', title: 'Collection', render: d => formatINR(d)},
                 { data: 'inc_1', title: 'Sales <br>Comm.', render: d => formatINR(d) },
                 { data: 'inc_2', title: 'Manager <br>Comm.', render: d => formatINR(d)},
                 { data: 'inc_3', title: 'Self Sales <br> Diff Comm.', render: d => formatINR(d)},

                 {
                    data: 'total_inc',
                    title: 'Total <br> Income',
                    render: function (data, type, row) {
                        if (!data) return ''; // if null or empty
                            let payout_no = btoa(encodeURIComponent(row.payout_no || ''));
                            let uid = btoa(encodeURIComponent(row.uid || ''));
                        return `<a href="/payout/user-income-list?payout_no=${payout_no}&uid=${uid}" target="_blank" style="cursor:pointer; font-weight:bold;">${formatINR(data)}</a>`;
                    }
                 },
                 { data: 'tds', title: 'TDS', render: d => formatINR(d)},
                 { data: 'hc', title: 'Admin <br>Charge', render: d => formatINR(d)},
                 { data: 'dispache_inc', title: 'Dispached', render: d => formatINR(d)},

                 { data: 'pan_tax', title: 'Tax (%)', render: (d) => d == null ? '' : d + '%' },

                { data: 'pan_no', title: 'PAN Number' },
                { data: 'bank_name', title: 'Bank Name' },
                { data: 'branch', title: 'Branch Name' },
                { data: 'account_no', title: 'Account Number' },
                { data: 'ifsc', title: 'IFSC Code' },

                  { data: 'pan_verify', title: 'Pan <br> Verify', orderable: false,
                      render: (d) => {
                            const s = { 0: ['No', 'text-danger'], 1: ['Yes', 'text-success'] }[+d] || ['Unknown', 'text-secondary'];
                            return `<span><i class="fa fa-circle ${s[1]} me-1"></i> ${s[0]}</span>`;
                      }
                 },
                 { data: 'bank_verify', title: 'Bank <br> Verify', orderable: false,
                      render: (d) => {
                            const s = { 0: ['No', 'text-danger'], 1: ['Yes', 'text-success'] }[+d] || ['Unknown', 'text-secondary'];
                            return `<span><i class="fa fa-circle ${s[1]} me-1"></i> ${s[0]}</span>`;
                      }
                 },

             ],
              footerCallback: function (row, data, start, end, display) {
                const api = this.api();
                const calc = i => api.column(i, { page: 'current' }).data().reduce((a, b) => (+a || 0) + (+b || 0), 0).toFixed(2);
                [4, 5, 6, 7, 8, 9, 10].forEach(i => $(api.column(i).footer()).html(calc(i)));
            }
        });
    }
</script>
