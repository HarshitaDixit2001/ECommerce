@{
    ViewData["Title"] = "Payout Wallet Passbook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    🎁 Reward Points
                </h1>
                <p class="breadcrumb-subtitle mb-0">
                    | Track your earned points and redemption history
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/secure/user-dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item"> Reward Points </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<div class="clearfix"></div>





<!-- ================= RP SUMMARY ================= -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1">Available Reward Points</h6>
                <h2 class="fw-bold text-warning mb-0">
                    <i class="bi bi-gift-fill"></i> 0 RP
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1">Total Earned</h6>
                <h2 class="fw-bold text-success mb-0">0 RP</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1">Total Redeemed</h6>
                <h2 class="fw-bold text-danger mb-0">0 RP</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted mb-1">This Month</h6>
                <h2 class="fw-bold text-primary mb-0">0 RP</h2>
            </div>
        </div>
    </div>
</div>

<!-- ================= FILTERS ================= -->
<section class="content">
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="row g-3 mb-3">

                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="text"
                           id="from_date"
                           class="form-control"
                           placeholder="DD-MM-YYYY" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="text"
                           id="to_date"
                           class="form-control"
                           placeholder="DD-MM-YYYY" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Transaction Type</label>
                    <select id="d_c" class="form-select select2">
                        <option value="">All Transactions</option>
                        <option value="C">Earned RP</option>
                        <option value="D">Redeemed RP</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Transaction No.</label>
                    <input type="text"
                           id="tran_no"
                           class="form-control"
                           placeholder="RP10001" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnSearch"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button id="btnReset"
                            class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Reset
                    </button>
                </div>

            </div>

            <!-- ================= DATATABLE ================= -->

            <div class="table-responsive">
                <table id="tblList"
                       class="table table-bordered table-hover align-middle nowrap w-100">
                </table>
            </div>

        </div>
    </div>
</section>




<!-- Main Content -->
<section class="content">
    <div class="row">
        <div class="col-sm-2">
            <input type="text" id="from_date" class="form-control" placeholder="From Date" />
        </div>
        <div class="col-sm-2">
            <input type="text" id="to_date" class="form-control" placeholder="To Date" />
        </div>
        <div class="col-sm-2">
            <select id="d_c" class="form-control select2">
                <option value="">All Debit/Credit </option>
                <option value="D">Debit</option>
                <option value="C">Credit</option>
            </select>
        </div>
        <div class="col-sm-2">
            <input type="button" id="btnSearch" class="btn btn-info" value="Search" />
        </div>

        <div class="col-sm-12">
            <div class="table-responsive mb-4">
                <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
            </div>
        </div>
    </div>
</section>

<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
<script>
    let token = "";
    const DOWNLOAD_FILE_NAME="PayoutWalletPassbook_";
    const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    $(function () {
        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
        $('#from_date').val(formatDate(monthStart));
        $('#to_date').val(formatDate(today));
        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        token = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString()))";
        //BindTableData();
       // $('#btnSearch').on('click', function () {  BindTableData(); });
    });


    function BindTableData() {
         showLoader();
         const formData = new FormData();
         formData.append('from_date', parseDate($('#from_date').val()));
         formData.append('to_date', parseDate($('#to_date').val()));
         formData.append('uid', uid);
         formData.append('d_c', $('#d_c').val());
         //formData.append('user_id', null);

         $.ajax({
             url: '/wallet/get-user-payout-wallet-passbook',
             type: 'POST',
             data: formData,
             processData: false,
             contentType: false,
             success: function (response) {
                 hideLoader();
                 if (response.success === true) {
                     const data = response.data || [];
                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                         scrollX: true,
                         scrollCollapse: true,
                         destroy: true,
                         responsive: true,
                         autoWidth: false,
                         language: { emptyTable: "No records found" },
                         "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                         "pageLength": 15,
                         buttons: [
                             { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                             { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                             { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                             { extend: 'copyHtml5', text: 'Copy'},
                         ],
                         data: data,
                         columns:[
                                 {
                                  data: null, title: '#',
                                  render: (d,t,r,m)=>`<span class="badge bg-secondary">${m.row + m.settings._iDisplayStart + 1}</span>`
                                },

                                {
                                  data:'doe', title:'Txn. Date',
                                  render:d=>d
                                    ? `<i class="bi bi-calendar-event text-primary me-1"></i>${new Date(d)
                                        .toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})
                                        .replace(/ /g,'-')}`
                                    : ''
                                },

                                {
                                  data:'amount', title:'Txn. Amount',
                                  render:(d,t,r)=>r.d_c==='D'
                                    ? `<i class="bi bi-arrow-down-circle text-danger me-1"></i><span class="text-danger fw-semibold">${d}</span>`
                                    : `<i class="bi bi-arrow-up-circle text-success me-1"></i><span class="text-success fw-semibold">${d}</span>`
                                },

                                {
                                  data:'balance', title:'Curr. Balance',
                                  render:d=>`<span class="fw-semibold text-dark">₹ ${d}</span>`
                                },

                                {
                                  data:'d_c', title:'Dr. / Cr.',
                                  render:d=>d==='D'
                                    ? `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-dash-circle me-1"></i>Debit</span>`
                                    : `<span class="badge bg-success-subtle text-success"><i class="bi bi-plus-circle me-1"></i>Credit</span>`
                                },

                                {
                                  data:'user_id', title:'User ID',
                                  render:d=>`<i class="bi bi-person-badge text-info me-1"></i>${d}`
                                },

                                {
                                  data:'name', title:'User Name',
                                  render:d=>`<i class="bi bi-person text-primary me-1"></i>${d}`
                                },

                                {
                                  data:'paid_user_id', title:'Paid UID',
                                  render:d=>`<i class="bi bi-person-check text-success me-1"></i>${d}`
                                },

                                {
                                  data:'paid_name', title:'Paid Name',
                                  render:d=>`<i class="bi bi-person-check-fill text-success me-1"></i>${d}`
                                },

                                {
                                  data:'remarks', title:'Remark',
                                  render:d=>`<i class="bi bi-chat-left-text text-muted me-1"></i>${d || '-'}`
                                },

                                {
                                  data:'tran_no', title:'Txn. No.',
                                  render:d=>`<span class="badge bg-light text-dark border">${d}</span>`
                                }
                         ],
                     });
                 }
             },
             error: function (xhr, status, error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }
</script>

