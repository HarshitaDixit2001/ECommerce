@{
    ViewData["Title"] = "Admin Company Wallet Request";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Wallet Request
    </h4>
    @*  <button class="btn btn-primary" onclick="openWalletModal()">
        Wallet Request
    </button> *@
</section>
<div class="clearfix"></div>
<br />
<!-- Main Content -->
<section class="content">
    <div class="row">

        <div class="col-sm-3">
            <select id="status" name="status" class="form-control">
                <option value="-1">🔍 All Payments</option>
                <option value="0">🟡 Pending</option>
                <option value="1">🟢 Approved</option>
                <option value="2">🔴 Rejected</option>
            </select>
        </div>
        <div class="col-sm-2">
            <input type="button" id="btnSearch" class="btn btn-info" value="Search" />
        </div>
        <div class="clearfix"></div>

        <div class="col-sm-12">
            <div class="table-responsive mb-4">
                <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
            </div>
        </div>
         
 

        <div class="modal fade" id="actionModal" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content shadow"> 
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title"><i class="fa fa-credit-card me-2"></i>Wallet Request Details</h5>
                        <button class="btn-close btn-close-white" onclick="closeActionModal()"></button>
                    </div>
                    <div class="modal-body">
                        <form id="SubmitForm">

                            <!-- Hidden -->
                            <input type="hidden" id="wallet_req_id" name="wallet_req_id">
                            <input type="hidden" id="h_status" name="h_status">

                            <table class="table table-sm table-bordered">
                                <tr><th>Your Request</th><td id="Requested_type"></td></tr>
                                <tr><th>User ID</th><td id="m_user_id"></td></tr>
                                <tr><th>User Name</th><td id="m_name"></td></tr>
                                <tr><th>Amount</th><td><span id="m_amount"></span></td></tr>
                                <tr><th>Status</th><td id="m_status"></td></tr>
                                <tr>
                                    <th>Payment Slip</th>
                                    <td>
                                        <img id="m_slip_img" class="img-thumbnail" style="max-height:120px; cursor:zoom-in;" onclick="showZoom(this.src)">
                                    </td>
                                </tr>
                            </table>

                            <!-- Password + Remarks (Single Line) -->
                            <div class="row mb-2">
                                <div id="div_password" class="col-md-4">
                                    <label>Password </label>
                                    <input type="password" id="tran_password" name="tran_password" class="form-control">
                                </div>

                                <div class="col-md-8">
                                    <label>Admin Remarks </label>
                                    <input type="text" id="response" name="response" class="form-control">
                                </div>
                            </div>

                            <!-- Buttons (Single Line) -->
                            <div class="d-flex gap-2">
                                <button type="submit" id="saveBtn" class="btn btn-primary">Submit</button>
                                <button type="button" class="btn btn-danger" onclick="closeActionModal()">Cancel</button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>


    </div>
</section>


@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")

<script>
    let token = "";
    const DOWNLOAD_FILE_NAME="WalletRequest_";
    //const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    $(function () {
        token = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString()))";
        BindTableData();
        $('#btnSearch').on('click', function () {  BindTableData(); });
    });



    let selectedRow = null;

    function openActionModal(status, row) {
        selectedRow = row;

        $('#wallet_req_id').val(row.wallet_req_id);
        $('#h_status').val(status);
         
        $('#m_user_id').text(row.user_id);
        $('#m_name').text(row.name);
        $('#m_amount').text(row.amount);
        $('#m_status').html(
            row.status == 0 ? '<span class="text-warning">Pending</span>' :
            row.status == 1 ? '<span class="text-success">Approved</span>' :
                              '<span class="text-danger">Rejected</span>'
        ); 
        $('#m_slip_img').attr('src', row.slip_img ? '/' + row.slip_img : '/no-image.png'); 
        if(status == 1)
        {
            $('#Requested_type').html('<span class="text-success"><h3>Approved</h3></span>');
            $('#div_password').show();
        }
        if(status == 2)
        { 
            $('#Requested_type').html('<span class="text-danger"><h3>Rejected</h3></span>');
            $('#div_password').hide();
        } 
        new bootstrap.Modal(document.getElementById('actionModal')).show();
    }

    function closeActionModal() {
        bootstrap.Modal.getInstance(document.getElementById('actionModal')).hide();
    }

     

     function BindTableData() {
          showLoader();
          const formData = new FormData(); 
          formData.append('status', $('#status').val());
          $.ajax({
             url: '/wallet/get-user-company-wallet-request-list',
             type: 'POST',
             data: formData,
             processData: false,
             contentType: false,
             success: function (response) {
                 hideLoader();
                 if (response.success === true ) {
                      const data = response.data || [];
                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                             // scrollY: "500px",
                             scrollX: true,
                             scrollCollapse: true,
                             destroy: true,
                             responsive: true,
                             autoWidth: false,
                             language: { emptyTable: "No records found" },
                             "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                             "pageLength": 15,
                             buttons: [
                                 { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                 { extend: 'copyHtml5', text: 'Copy'},
                             ],
                             data: data,
                             columns: [
                             { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                             {
                                data: 'status',
                                title: 'Status',
                                orderable: false,
                                render: (d, t, r) =>
                                    d == 1 ? '<i class="fa fa-circle text-success"></i> Approved' :
                                    d == 2 ? '<i class="fa fa-circle text-danger"></i> Rejected' :
                                    `<button class="btn btn-xs btn-success mt-1" onclick='openActionModal(1,${JSON.stringify(r)})'>Approve</button>
                                     <button class="btn btn-xs btn-danger mt-1" onclick='openActionModal(2,${JSON.stringify(r)})'>Reject</button>`
                             },
                            
                             { data: 'user_id',          title: 'User Id' },
                             { data: 'name',            title: 'Name' },
                             { data: 'amount',          title: 'Amount' },
                             { data: 'bank_tran_no',    title: 'Transaction No.' }, 
                             { data: 'payment_type',    title: 'Payment Mode' },
                             { data: 'user_ac_no',      title: 'User A/C No.' },
                             { data: 'user_bank',       title: 'User Bank' },
                             {
                                data: 'slip_img',
                                title: 'Payment Slip',
                                render: function (d) {
                                    const imgSrc = d ? `/${d}` : '@Const.NO_IMAGE';
                                    return `<img src="${imgSrc}" onclick="showZoom(this.src)" class="img-thumbnail" style="max-height:90px; cursor:zoom-in;" loading="lazy"/>`;
                                }
                             },
                             { data: 'remark',          title: 'Remarks' },
                             { data: 'response',        title: 'Bank Response' },

                             { data: 'doe', title: 'Transaction Date',  render: (data) => data ? new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                             { data: 'approved_date', title: 'Approval Date',  render: (data) => data ? new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                            
                             { data: 'comp_ac_no',      title: 'Company A/C No.' },
                             { data: 'comp_bank',       title: 'Company Bank' },

                         ],
                     });
                 }
             },
             error: function (xhr, status, error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }




    $('#SubmitForm').submit(function (e) {
        e.preventDefault();
        let status = $('#h_status').val();
        let tran_password = $('#tran_password').val();


        if(status === '1') {
            if(tran_password ===''){
                showErrorLog(`@Const.ERROR_HEADER`, "Please Enter Password.");  return;
            } 
        }
        
        const formData = new FormData(this); 
        formData.append('mst_key', 'UPDATE');
        formData.append('wallet_req_id', $('#wallet_req_id').val());
        formData.append('status', status);
        formData.append('tran_password', tran_password);
        formData.append('response', $('#response').val());
        formData.append('login_user_id', '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value');

        showLoader();
        $.ajax({
            url: '/wallet/user-company-wallet-request',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                hideLoader();
                if(response.success == true ){
                    showToastSuccess('Data save successfully');
                    closeActionModal();
                    $('#SubmitForm')[0].reset(); 
                    BindTableData();
                }else{
                    showErrorLog(`@Const.ERROR_HEADER`, response.message);
                }
            },
            error: function (res_error) {
               showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    });

    $('#cancelBtn').on('click', function (e) {
        e.preventDefault();
        closeActionModal();
        $('#SubmitForm')[0].reset(); 
    });

</script>

