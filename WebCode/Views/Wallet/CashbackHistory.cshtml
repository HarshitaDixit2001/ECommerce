@{
    ViewData["Title"] = "Cashback History";
}
<style>
    .tracking {
        position: relative;
    }

    .tracking-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: 25px;
    }

        .tracking-item:last-child {
            padding-bottom: 0;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 40px;
            width: 2px;
            height: calc(100% - 20px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

    .tracking-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tracking-content {
        padding-top: 5px;
    }

    .completed .tracking-content strong {
        color: #198754;
    }

    .active .tracking-content strong {
        color: #fd7e14;
    }
</style>
<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    💸 Cashback History
                </h1>
                <p class="breadcrumb-subtitle mb-0">
                    | View your earned cashback and transaction details
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="/secure/user-dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            Cashback Earnings
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<div class="clearfix"></div>

<div class="row mb-3">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Available Coupons</h6>
                <h3 class="text-success mb-0">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Active Coupons</h6>
                <h3 class="text-primary mb-0">0</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Expired Coupons</h6>
                <h3 class="text-danger mb-0">0</h3>
            </div>
        </div>
    </div>

</div>

<section class="py-2">
    <div class="container">

        <div class="row">

            <div class="col-sm-2">
                <input type="text" id="from_date" class="form-control" placeholder="From Date" />
            </div>
            <div class="col-sm-2">
                <input type="text" id="to_date" class="form-control" placeholder="To Date" />
            </div>

            <div class="col-sm-1">
                <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
            </div>
            <div class="clearfix"></div>
            <div class="col-sm-12">
                <div class="table-responsive mb-4">
                    <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
<script>
    $(document).ready(function () {

           var couponList = [
               {
                   couponCode: "WELCOME100",
                   couponName: "Welcome Offer",
                   discount: "₹100 Off",
                   minOrder: "₹999",
                   validTill: "31-Dec-2026",
                   status: "Active"
               },
               {
                   couponCode: "SAVE10",
                   couponName: "Flat 10% Discount",
                   discount: "10% Off",
                   minOrder: "₹500",
                   validTill: "15-Nov-2026",
                   status: "Active"
               },
               {
                   couponCode: "FESTIVE250",
                   couponName: "Festival Special",
                   discount: "₹250 Off",
                   minOrder: "₹2500",
                   validTill: "30-Oct-2026",
                   status: "Active"
               },
               {
                   couponCode: "FREESHIP",
                   couponName: "Free Shipping",
                   discount: "Free Delivery",
                   minOrder: "₹299",
                   validTill: "31-Dec-2026",
                   status: "Active"
               },
               {
                   couponCode: "SUPER20",
                   couponName: "Super Saver",
                   discount: "20% Off",
                   minOrder: "₹1500",
                   validTill: "10-Aug-2026",
                   status: "Expired"
               },
               {
                   couponCode: "MEGA500",
                   couponName: "Mega Sale",
                   discount: "₹500 Off",
                   minOrder: "₹5000",
                   validTill: "31-Jul-2026",
                   status: "Expired"
               }
           ];

           $('#tblList').DataTable({
               destroy: true,
               responsive: true,
               pageLength: 10,
               data: couponList,

               columns: [
                   {
                       title: "#",
                       data: null,
                       render: function (data, type, row, meta) {
                           return meta.row + 1;
                       }
                   },
                   {
                       title: "Coupon Code",
                       data: "couponCode",
                       render: function (data) {
                           return `<span class="badge bg-primary fs-6">${data}</span>`;
                       }
                   },
                   {
                       title: "Coupon Name",
                       data: "couponName"
                   },
                   {
                       title: "Discount",
                       data: "discount",
                       className: "fw-bold text-success"
                   },
                   {
                       title: "Min Order",
                       data: "minOrder"
                   },
                   {
                       title: "Valid Till",
                       data: "validTill"
                   },
                   {
                       title: "Status",
                       data: "status",
                       render: function (data) {
                           return data === "Active"
                               ? '<span class="badge bg-success">Active</span>'
                               : '<span class="badge bg-danger">Expired</span>';
                       }
                   },
                   {
                       title: "Action",
                       data: "couponCode",
                       orderable: false,
                       render: function (data) {
                           return `
                               <button class="btn btn-sm btn-outline-primary copyCoupon"
                                       data-code="${data}">
                                   <i class="bi bi-copy"></i> Copy
                               </button>
                           `;
                       }
                   }
               ]
           });

           $(document).on('click', '.copyCoupon', function () {

               let code = $(this).data('code');

               navigator.clipboard.writeText(code);

               $(this)
                   .removeClass('btn-outline-primary')
                   .addClass('btn-success')
                   .html('<i class="bi bi-check-lg"></i> Copied');
           });

       });
</script>



