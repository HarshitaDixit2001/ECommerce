@model ProductDetailViewModel
@{
    ViewData["Title"] = "Product Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-image-card {
        background: #fff;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 8px 30px rgba(0,0,0,.08);
        border: 1px solid #ececec;
        position: relative;
    }

    .product-actions {
        position: absolute;
        top: 18px;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 100;
    }

    .action-btn {
        width: 46px;
        height: 46px;
        border: none;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 6px 18px rgba(0,0,0,.15);
        transition: .3s;
        font-size: 18px;
    }

        .action-btn:hover {
            background: #198754;
            color: #fff;
            transform: translateY(-3px);
        }

    .main-image-wrapper {
        height: 500px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .product-main-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: .35s;
        cursor: zoom-in;
    }

        .product-main-image:hover {
            transform: scale(1.12);
        }

    .thumbnail-gallery {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .product-thumb {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border: 2px solid #e8e8e8;
        border-radius: 12px;
        cursor: pointer;
        transition: .3s;
        padding: 4px;
        background: #fff;
    }

        .product-thumb:hover {
            border-color: #198754;
            transform: translateY(-5px);
        }

        .product-thumb.active {
            border: 2px solid #198754;
            box-shadow: 0 0 0 4px rgba(25,135,84,.15);
        }



    /* Common Button Style */
    .product-action-btn,
    .action-btn {
        position: absolute;
        top: 0px;
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        font-size: 20px;
        color: #198754;
        background: #ffffff;
        border: 2px solid #198754;
        box-shadow: 0 8px 20px rgba(25,135,84,.15);
        transition: all .3s ease;
        /* position: absolute;
                                    top: 0;
                                    width: 46px;
                                    height: 46px;
                                    border: none;
                                    border-radius: 50%;
                                    background: #fff;
                                    box-shadow: 0 6px 18px rgba(0,0,0,.15);
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    font-size: 18px;
                                    cursor: pointer;
                                    transition: all .3s ease; */
    }

    /* Share Button - Left */
    .share-btn {
        left: 18px;
    }

    .wishlist-btn {
        right: 18px;
    }

    /* Hover Effect */
    .product-action-btn:hover,
    .action-btn:hover {
        background: #198754;
        color: #fff;
        transform: translateY(-3px);
    }

    /* Active Wishlist */
    .wishlist-btn.active {
        background: #dc3545;
        color: #fff;
    }


    @@media(max - width:992px) {
        .main-image-wrapper {
            height: 420px;
        }

        .product-thumb {
            width: 75px;
            height: 75px;
        }
    }

    @@media(max - width:768px) {
        .main-image-wrapper {
            height: 320px;
        }

        .product-thumb {
            width: 65px;
            height: 65px;
        }



        .action-btn {
            width: 40px;
            height: 40px;
            font-size: 16px;
        }
    }

    @@media(max - width:576px) {
        .main-image-wrapper {
            height: 280px;
        }

        .product-thumb {
            width: 55px;
            height: 55px;
        }

        .product-image-card {
            position: relative;
        }
    }



    .share-btn {
        top: 0;
        left: 18px;
    }

</style>

<style>

    /*=========================================================
                    BEST SELLING PRODUCTS
                    =========================================================*/

    .best-selling-wrapper {
        position: relative;
        overflow: hidden;
    }

    .marquee-container {
        width: 100%;
        overflow: hidden;
        padding: 10px 55px;
    }

    .marquee-track {
        display: flex;
        align-items: stretch;
        gap: 20px;
        width: max-content;
        animation: marqueeScroll 40s linear infinite;
    }

    .marquee-container:hover .marquee-track {
        animation-play-state: paused;
    }

    .marquee-item {
        flex: 0 0 auto;
        width: 280px;
    }

    /*=========================================================
                                                                                    PRODUCT CARD
                                                                =========================================================*/

    .product-card {
        position: relative;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 18px;
        overflow: hidden;
        transition: .35s;
        box-shadow: 0 6px 20px rgba(0,0,0,.08);
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 35px rgba(0,0,0,.15);
        }

    /*=========================================================
                                                                                    PRODUCT CODE
                                                                =========================================================*/

    .product-code-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #198754;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 30px;
        z-index: 5;
        box-shadow: 0 4px 10px rgba(0,0,0,.18);
    }

    /*=========================================================
                                                                                    WISHLIST
                                                                =========================================================*/

    .bs-wishlist-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #fff;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 5;
        transition: .3s;
        box-shadow: 0 5px 15px rgba(0,0,0,.15);
    }

        .bs-wishlist-btn i {
            font-size: 18px;
        }

        .bs-wishlist-btn:hover {
            background: #dc3545;
            color: #fff;
            transform: scale(1.08);
        }

    /*=========================================================
                                                                                    PRODUCT IMAGE
                                                                =========================================================*/

    .product-img {
        width: 100%;
        height: 250px;
        object-fit: contain;
        padding: 18px;
        transition: .35s;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    /*=========================================================
                                                                                    PRODUCT DETAILS
                                                                =========================================================*/

    .product-info {
        padding: 16px;
    }

    .product-title {
        font-size: 15px;
        font-weight: 600;
        color: #222;
        line-height: 1.45;
        min-height: 44px;
        overflow: hidden;
    }

    .product-price-box {
        margin-top: 10px;
    }

        .product-price-box .mrp {
            font-size: 14px;
            color: #999;
            text-decoration: line-through;
        }

        .product-price-box .dp {
            font-size: 18px;
            color: #198754;
            font-weight: 700;
        }

    .badge {
        font-size: 12px;
        font-weight: 600;
        padding: 7px 12px;
        border-radius: 30px;
    }

    .btn-cart-sm {
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .3s;
    }

        .btn-cart-sm i {
            font-size: 18px;
        }

        .btn-cart-sm:hover {
            background: #146c43;
            transform: scale(1.08);
        }

    /*=========================================================
                                                                                    NAVIGATION BUTTONS
                                                                =========================================================*/

    .marquee-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        cursor: pointer;
        z-index: 20;
        transition: .3s;
        box-shadow: 0 10px 25px rgba(0,0,0,.18);
    }

        .marquee-btn:hover {
            background: #146c43;
            transform: translateY(-50%) scale(1.08);
        }

    .marquee-prev {
        left: 5px;
    }

    .marquee-next {
        right: 5px;
    }

    /*=========================================================
                                                                                    ANIMATION
                                                                =========================================================*/

    @@keyframes marqueeScroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    /*=========================================================
                                                                                    RESPONSIVE
                                                                =========================================================*/

    @@media(max - width:992px) {
        .marquee-item {
            width: 240px;
        }

        .product-img {
            height: 220px;
        }
    }

    @@media(max - width:768px) {
        .marquee-container {
            padding: 10px 45px;
        }

        .marquee-item {
            width: 200px;
        }

        .product-img {
            height: 180px;
        }

        .marquee-btn {
            width: 40px;
            height: 40px;
            font-size: 18px;
        }
    }

    @@media(max - width:576px) {
        .marquee-container {
            padding: 10px 35px;
        }

        .marquee-item {
            width: 180px;
        }

        .product-img {
            height: 160px;
        }

        .product-title {
            font-size: 14px;
        }
    }
</style>

<style>
    .review-section {
        background: #F9FCF7;
    }

    .review-summary {
        border: 1px solid #E8F5E9;
    }

    .review-card {
        background: #fff;
        border: 1px solid #E8F5E9;
        border-radius: 18px;
        padding: 25px;
        transition: .3s;
        margin-bottom: 20px;
    }

        .review-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(46,125,50,.12);
        }

    .avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #E8F5E9;
        color: #2E7D32;
        font-size: 22px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .progress {
        height: 8px;
        background: #E8F5E9;
        border-radius: 30px;
    }

    .progress-bar {
        border-radius: 30px;
    }

    .btn-success {
        background: #2E7D32;
        border: none;
    }

        .btn-success:hover {
            background: #1B5E20;
        }

    .verified {
        background: #E8F5E9;
        color: #2E7D32;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .review-card p {
        color: #555;
        line-height: 1.8;
    }

    .rating-bars small {
        font-weight: 600;
    }

    .form-select {
        border-radius: 50px;
        min-width: 180px;
    }

    @@media(max - width:768px) {
        .review-summary {
            margin-bottom: 20px;
        }

        .avatar {
            width: 50px;
            height: 50px;
        }

        .review-card {
            padding: 18px;
        }
    }
</style>

<style>
    .review-section .form-control,
    .review-section .form-select {
        border-radius: 12px;
        border: 1px solid #d8e7d4;
    }

        .review-section .form-control:focus,
        .review-section .form-select:focus {
            border-color: #2e7d32;
            box-shadow: 0 0 0 .2rem rgba(46,125,50,.15);
        }

    .modal-content {
        overflow: hidden;
    }

    .rating-stars {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }

        .rating-stars input {
            display: none;
        }

        .rating-stars label {
            font-size: 34px;
            color: #d7d7d7;
            cursor: pointer;
            transition: .25s;
            margin-right: 6px;
        }

            .rating-stars label:hover,
            .rating-stars label:hover ~ label {
                color: #ffc107;
                transform: scale(1.12);
            }

        .rating-stars input:checked ~ label {
            color: #ffc107;
        }

    .modal-header {
        background: linear-gradient(135deg,#2e7d32,#43a047);
    }

    .modal-footer {
        background: #f7fbf5;
    }

    .form-label {
        color: #2e7d32;
    }

    .btn-success {
        background: #2e7d32;
        border-color: #2e7d32;
    }

        .btn-success:hover {
            background: #256428;
        }

    input[type=file]::file-selector-button {
        background: #2e7d32;
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 8px;
        margin-right: 12px;
    }

        input[type=file]::file-selector-button:hover {
            background: #256428;
        }
</style>


<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section py-5 bg-light border rounded-4 shadow">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">
                <h1 class="breadcrumb-title">
                    🍃 Best Selling Ayurvedic Products
                </h1>

                <p class="breadcrumb-subtitle mb-0">
                    | Trusted Herbal Solutions for Everyday Wellness
                </p>
            </div>

            <div class="col-lg-6 text-lg-end">

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">

                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/product">Products</a>
                        </li>

                        <li class="breadcrumb-item active">
                            @Model.cat_name
                        </li>
                    </ol>
                </nav>

            </div>

        </div>

    </div>
</section>



<!-- ================= PRODUCT SECTION ================= -->
<section class="py-5">

    <div class="container">

        <div class="row g-5">

            <!-- LEFT SIDE -->
            <div class="col-lg-5">

                <input type="hidden" value="@Model.pid" id="pid" />
                @{
                    var mainImg = !string.IsNullOrEmpty(Model.img1)
                    ? Url.Content("~/" + Model.img1) : Url.Content(@Const.NO_IMAGE);
                }

                <div class="product-image-card">

                    <!-- Floating Actions -->
                    <div class="product-actions">

                        <!-- Wishlist -->
                        <button class="product-action-btn wishlist-btn" title="Add to Wishlist">
                            <i class="bi bi-heart"></i>
                        </button>

                        <!-- Share -->
                        <button class="action-btn share-btn" onclick="shareProduct()" title="Share">
                            <i class="bi bi-share"></i>
                        </button>
                    </div>

                    <!-- Main Image -->
                    <div class="main-image-wrapper">
                        <img id="mainImage" src="@mainImg" class="product-main-image"
                             alt="@Model.prod_name" loading="lazy" style="cursor:zoom-in;"
                             onclick="showZoom('@mainImg')" />
                    </div>

                    <!-- Thumbnail Gallery -->
                    @if (Model.ImageList != null && Model.ImageList.Any())
                    {
                        <div class="thumbnail-gallery">

                            @foreach (var img in Model.ImageList)
                            {
                                var thumb = !string.IsNullOrEmpty(img) ? Url.Content("~/" + img.TrimStart('/')) : Url.Content(Const.NO_IMAGE);
                                <img src="@thumb" class="product-thumb" onclick="updateMainImage('@thumb')">
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="col-lg-7">
                <div class="product-details-scroll">
                    <!-- ========================================= -->
                    <!-- Product Summary -->
                    <!-- ========================================= -->

                    <div class="product-header">

                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                            <small class="text-muted">
                                Code : <strong>@Model.prod_code</strong>
                            </small>
                            <span class="badge rounded-pill bg-light text-success border px-3 py-2">
                                <i class="bi bi-stars me-1"></i>
                                Premium Quality Product
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
                            <h2 class="product-name mb-0 flex-grow-1 me-3">
                                @Model.prod_name
                            </h2>
                            <div class="hsn-badge">
                                <i class="bi bi-upc-scan me-1"></i>
                                <span>HSN :</span>
                                <strong>@Model.hsncode</strong>
                            </div>
                        </div>


                        <!-- Rating -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="text-warning">
                                @{
                                    decimal rating = Convert.ToDecimal(Model.rating);
                                }

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (rating >= i)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else if (rating >= i - 0.5m)
                                    {
                                        <i class="bi bi-star-half"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>

                            <span class="text-muted small">
                                <strong>@Model.rating</strong>/5
                                <span class="mx-1">|</span>
                                <i class="bi bi-chat-dots-fill me-1 text-success"></i>
                                @Model.review Reviews
                            </span>

                        </div>




                        <div class="row align-items-center g-3">

                            @{
                                decimal mrp = Model.mrp ?? 0;
                                decimal price = Model.price ?? 0;
                                decimal save = mrp - price;
                                decimal discount = mrp > 0 ? (save * 100 / mrp) : 0;
                            }

                            <!-- Price Details -->
                            <div class="col-lg-8 col-md-7">
                                <div class="d-flex flex-wrap align-items-center gap-4">
                                    
                                    <div>
                                        <small class="text-muted d-block">Selling Price</small>
                                        <h2 class="mb-0 fw-bold text-success">
                                            ₹@price.ToString("0.00")
                                        </h2>
                                    </div>

                                    <div>
                                        <small class="text-muted d-block">MRP</small>
                                        <h5 class="mb-0 text-muted text-decoration-line-through">
                                            ₹@mrp.ToString("0.00")
                                        </h5>
                                    </div>

                                    <div>
                                        <small class="text-muted d-block">Discount</small>
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                                            @discount.ToString("0")% OFF
                                        </span>
                                    </div>

                                    <div>
                                        <small class="text-muted d-block">You Save</small>
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                            <i class="bi bi-piggy-bank-fill me-1"></i>
                                            ₹@save.ToString("0.00")
                                        </span>
                                    </div>

                                </div>
                            </div>

                            <!-- Add To Cart -->
                            <div class="col-lg-4 col-md-5">
                                <input type="hidden" id="qty" value="1" />
                                @if (Model.product_qty > 0)
                                {
                                    <button type="button"
                                            class="btn btn-success btn-lg w-100"
                                            onclick="AddToCart(0,@Model.pid,$('#qty').val(),'')">
                                        <i class="bi bi-cart3 me-2"></i>
                                        Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-danger btn-lg w-100"
                                            disabled>
                                        <i class="bi bi-x-circle me-2"></i>
                                        Out of Stock
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(Model.size) || !string.IsNullOrEmpty(Model.color_name))
                            {
                                <div class="mb-3 d-flex align-items-center flex-wrap gap-3">

                                    @if (!string.IsNullOrEmpty(Model.size))
                                    {
                                        <div>
                                            <label class="form-label fw-semibold me-2">Size</label>
                                            <select class="form-select form-select-sm w-auto d-inline-block">
                                                <option>@Model.size</option>
                                            </select>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.color_name))
                                    {
                                        <div class="d-flex align-items-center">
                                            <label class="form-label fw-semibold me-2 mb-0">Color</label>

                                            <div class="form-check form-check-inline mb-0">
                                                <input class="form-check-input" type="radio" checked />
                                                <label class="form-check-label">@Model.color_name</label>
                                            </div>

                                            @if (!string.IsNullOrEmpty(Model.color_code))
                                            {
                                                <span class="ms-2 rounded-circle border"
                                                      style="width:20px;height:20px;background:@Model.color_code;"></span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                        </div>

                        <hr />



                        <!-- ========================================= -->
                        <!-- Product Description -->
                        <!-- ========================================= -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-header bg-success text-white py-3">
                                <h5 class="mb-0 fw-semibold">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    Description
                                </h5>
                            </div>

                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(Model.prod_desc))
                                {
                                    <div class="product-description-content">
                                        @Html.Raw(Model.prod_desc)
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted text-center py-3">
                                        <i class="bi bi-exclamation-circle me-2"></i>
                                        Product description is not available.
                                    </div>
                                }
                            </div>
                        </div>







                        <!-- ========================================= -->
                        <!-- Product Highlights -->
                        <!-- ========================================= -->
                        <div class="row g-3 mt-4">

                            <div class="col-md-6">
                                <div class="product-option h-100">
                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-patch-check-fill text-success fs-2 me-3"></i>

                                        <div>
                                            <h6 class="mb-1 fw-bold">
                                                100% Genuine Product
                                            </h6>

                                            <small class="text-muted">
                                                Original Ayurvedic formulation.
                                            </small>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="product-option h-100">
                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-truck text-success fs-2 me-3"></i>

                                        <div>
                                            <h6 class="mb-1 fw-bold">
                                                Free Shipping
                                            </h6>

                                            <small class="text-muted">
                                                Available on eligible orders.
                                            </small>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="product-option h-100">
                                    <div class="d-flex align-items-center">

