@section Scripts {
    <script>

             $(document).ready(function () {
                 BindBestSellingProduct();
                 BindIngredients();
             });



             function BindBestSellingProduct() {
                $.ajax({
                     url: "/product/get-product",
                    type: "GET",
                    data: {
                        cart_id: 0,
                        fetch_type: "HOME_BEST_SELLING"
                    },
                    success: function (response) {

                        if (!response || !response.success)
                            return;

                        let products = response.data || [];
                        let html = "";

                        // Duplicate products for infinite marquee
                        for (let r = 0; r < 2; r++) {
                            $.each(products, function (i, product) {
                                // Product Image
                                let img = "/images/noimage.jpg";
                                if (product.img1 && product.img1.trim() !== "") {
                                    img = "/" + product.img1.replace(/^\/+/, "");
                                }

                                // Product Name
                                let name = product.prod_name || "";

                                if (name.length > 25) {
                                    name = name.substring(0, 25) + "...";
                                }

                                // Product Details
                                let code = product.prod_code || "";
                                let mrp = Number(product.mrp || 0).toFixed(2);
                                let price = Number(product.price || 0).toFixed(2);
                                let discount = Number(product.discount || 0).toFixed(0);

                                html += `
                                    <div class="marquee-item">
                                        <div class="product-card">
                                            <!-- Product Code -->
                                            <div class="product-code-badge"> ${code}  </div>
                                            <!-- Wishlist -->
                                            <div class="bs-wishlist-btn"
                                                 title="Wishlist">
                                                <i class="bi bi-heart"></i>
                                            </div>

                                            <!-- Product Image -->
                                            <a href="/product/${product.seo_url}">
                                                <img src="${img}" class="product-img" alt="${product.prod_name}" loading="lazy">
                                            </a>

                                            <!-- Product Information -->
                                            <div class="product-info">
                                                <h6 class="product-title mb-2"> ${name} </h6>
                                                <div class="product-price-box d-flex justify-content-between align-items-center">
                                                    <span class="mrp"> MRP ₹${mrp}  </span>
                                                    <span class="dp"> Rs.${price} </span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                    <span class="badge bg-warning text-dark">
                                                        ${discount}% OFF
                                                    </span>

                                                    <button class="btn-cart-sm" type="button" onclick="AddToCart(0,${product.pid},1,'')">
                                                        <i class="bi bi-cart-plus"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>`;
                            });
                        }

                        $("#marqueeTrack").html(html);

                        // Restart marquee
                        if (typeof InitializeMarquee === "function") {
                            InitializeMarquee();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error loading products:", error);
                    }
                });

            }


        function BindIngredients() {
            showLoader();
            $("#ingredientContainer").html("");
            let mst_key = "GET_INGREDIENT_LIST";
            let pid = $("#pid").val();
            $.ajax({
                url: `/common/master-reports?mst_key=${mst_key}&id=${pid}`,
                type: "GET",
                dataType: "json",
                success: function (response) {
                    hideLoader();
                    if (!response || response.success !== true) {
                        $("#ingredientContainer").html("");
                        $("#div_ingredientContainer").hide();
                        return;
                    }

                    let data = [];
                    try {
                        data = JSON.parse(response.data);
                    }
                    catch (e) {
                        console.log(e);
                    }

                    if (!data || data.length === 0) {
                        $("#ingredientContainer").html("");
                        $("#div_ingredientContainer").hide();
                        return;
                    }

                    $("#div_ingredientContainer").show();
                    let html = "";

                    $.each(data, function (index, item) {

                        let img = "@Const.NO_IMAGE";
                        if (item.ingredient_img && item.ingredient_img.trim() !== "") {
                            img = "/" + item.ingredient_img.replace(/^\/+/, "");
                        }

                        let ingredientName = item.ingredient_name || "";
                        let ingredientDesc = item.ingredient_desc || "";
                        html += `
                        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6 mb-4">
                            <div class="ingredient-card">
                                <div class="ingredient-image">
                                    <img src="${img}" class="img-fluid" alt="${ingredientName}"
                                         loading="lazy" onclick="showZoom('${img}')">
                                </div>
                                <div class="ingredient-body">
                                    <h5 class="ingredient-title">
                                        <i class="bi bi-flower1 text-success me-2"></i> ${ingredientName}
                                    </h5>
                                    <p class="ingredient-desc"> ${ingredientDesc} </p>
                                </div>
                            </div>
                        </div>
                        `;
                    });
                    $("#ingredientContainer").html(html);
                },
                error: function () {
                    hideLoader();
                    $("#ingredientContainer").html("");
                    $("#div_ingredientContainer").hide();
                }
            });
        }





              // Highlight active thumbnail
             document.querySelectorAll(".img-thumbnail").forEach(thumb => {
                 thumb.addEventListener("click", function () {
                     document.querySelectorAll(".img-thumbnail").forEach(t => t.classList.remove("border-primary"));
                     this.classList.add("border-primary");
                 });
             });

             // Sync zoomed image with main image
             document.getElementById("mainImage").addEventListener("click", function () {
                 document.getElementById("zoomedImage").src = this.src;
             });

             // Function to update both images and highlight thumbnails
             function updateMainImage(src) {
                 document.getElementById("mainImage").src = src;
                 document.getElementById("zoomedImage").src = src;

                 document.querySelectorAll(".img-thumbnail").forEach(t => t.classList.remove("border-primary"));
                 const activeThumb = Array.from(document.querySelectorAll(".img-thumbnail")).find(t => t.src === src);
                 if (activeThumb) activeThumb.classList.add("border-primary");
             }

             // Close modal if clicking outside the zoomed image
             document.getElementById("zoomModal").addEventListener("click", function (e) {
                 const image = document.getElementById("zoomedImage");
                 if (!image.contains(e.target)) {
                     const modal = bootstrap.Modal.getInstance(document.getElementById("zoomModal"));
                     modal.hide();
                 }
             });


             $(function () {
                 var container = $("#marqueeContainer");
                 var timer;
                 function startAutoScroll() {
                     timer = setInterval(function () {
                         var maxScroll = container[0].scrollWidth - container.innerWidth();
                         if (container.scrollLeft() >= maxScroll) {
                             container.scrollLeft(0);
                         } else {
                             container.scrollLeft(container.scrollLeft() + 1);
                         }
                     }, 20);
                 }

                 function stopAutoScroll() {
                     clearInterval(timer);
                 }

                 startAutoScroll();
                 container.hover(function () {
                     stopAutoScroll();
                 }, function () {
                     startAutoScroll();
                 });

                 $("#nextBtn").click(function () {
                     stopAutoScroll();
                     container.stop().animate({
                         scrollLeft: container.scrollLeft() + 320
                     }, 400);
                     startAutoScroll();
                 });

                 $("#prevBtn").click(function () {
                     stopAutoScroll();
                     container.stop().animate({
                         scrollLeft: container.scrollLeft() - 320
                     }, 400);
                     startAutoScroll();
                 });
             });


             function shareProduct() {
                 if (navigator.share) {
                     navigator.share({
                         title: document.title,
                         text: '@Model.prod_name',
                         url: window.location.href
                     });
                 } else {
                     navigator.clipboard.writeText(window.location.href);
                     alert("Product link copied.");
                 }
             }

