            $("#btnSubmitReview").click(function () {

                // Center Boom
                setTimeout(function () {
                    confetti({
                        particleCount: 250,
                        spread: 140,
                        startVelocity: 60,
                        origin: {
                            x: 0.5,
                            y: 0.5
                        }
                    });
                }, 250);

                // Success Message
                Swal.fire({
                    icon: "success",
                    title: "🎉 Thank You!",
                    html: `
                        <h5 class="text-success mb-2">
                            Your review has been submitted successfully.
                        </h5>
                        <p class="text-muted mb-0">
                            Thank you for sharing your experience with our Ayurvedic product.
                        </p>
                    `,
                    confirmButtonColor: "#2e7d32",
                    confirmButtonText: "Awesome!"
                }).then(() => {

                    // Close Modal
                    var modal = bootstrap.Modal.getInstance(document.getElementById('reviewModal'));
                    if (modal)
                        modal.hide();

                    // Optional: Reset Form
                    $("#reviewModal form")[0].reset();
                });
            });

