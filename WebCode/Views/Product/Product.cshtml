@model List<ProductViewModel>
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
                               HERO BANNER
             ========================================== */

    .hero-banner {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        border: 2px solid #d8eadc;
        box-shadow: 0 10px 30px rgba(25,135,84,.12);
    }

    .hero-banner-img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        display: block;
    }

    /* Overlay */

    .banner-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.35) );
        display: flex;
        align-items: center;
        color: #fff;
    }

    .banner-content {
        max-width: 650px;
    }

    .banner-title {
        font-size: 3rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 15px;
        text-shadow: 0 3px 10px rgba(0,0,0,.4);
    }

    .banner-text {
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 25px;
        color: rgba(255,255,255,.95);
    }


    /* ==========================================
                               MOBILE
             ========================================== */

    @@media (max-width: 768px) {
        .hero-banner-img {
            height: 280px;
        }

        .banner-content {
            text-align: center;
            max-width: 100%;
            padding: 0 15px;
        }

        .banner-title {
            font-size: 1.8rem;
        }

        .banner-text {
            font-size: .95rem;
            line-height: 1.6;
        }
    }
</style>
 
<!-- ================= BREADCRUMB SECTION ================= -->
<section class="breadcrumb-section py-5 bg-light border rounded-4 shadow">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">

                <h2 class="fw-bold text-success mb-1">
                    🛍️ Product Categories
                </h2>
                <p class="text-muted mb-0">
                    Browse products by category.
                </p>

            </div>

            <div class="col-lg-6 text-lg-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-lg-end mb-0">

                        <li class="breadcrumb-item">
                            <a href="/">Home</a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/product">Products</a>
                        </li>

                        @* <li class="breadcrumb-item active">
                            Ayurvedic Products
                        </li> *@
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- ===== SHOP BY CATEGORY ===== -->
    @await Component.InvokeAsync("Category")
</section>
 

<!-- ===== PRODUCTS ===== -->
<section id="products" class="section-products border rounded-4 shadow">

    <div class="row g-4">
        <!-- Product Card -->
        @for (int i = 0; i < Model.Count; i += 4)
        {
            @foreach (var product in Model.Skip(i).Take(4))
            {
                var imgPath = !string.IsNullOrEmpty(product.img1)
                ? Url.Content("~/" + product.img1)
                : Url.Content("~/images/noimage.jpg");   // default image

                <!-- PRODUCT CARD START -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="product-card">
                        <!-- Wishlist -->
                        <div class="wishlist-btn"> <i class="bi bi-heart"></i> </div>
                        <!-- Image -->

                        <a href="@Url.Content($"~/product/{product.seo_url}")">
                            <img src="@imgPath" alt="@product.prod_name" class="product-img" loading="lazy" />
                        </a>
                        <!-- Info -->
                        <div class="product-info">
                            <!-- LINE 1 -->
                            <div class="d-flex justify-content-between">
                                <h6 class="product-title mb-0">
                                    @(product.prod_name.Length > 25 ? product.prod_name.Substring(0, 25) + "..." + " " + (product.size) : product.prod_name + " " + (product.size))
                                </h6>
                                <small class="product-code"> @product.prod_code </small>
                            </div>


                            <!-- LINE 2 -->
                            <div class="d-flex justify-content-between align-items-center product-price-box">
                                <span class="mrp">MRP: @product.mrp </span>
                                <span class="dp">Rs. @product.price</span>
                            </div>

                            <!-- LINE 3 -->
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge bg-warning text-dark">@product.discount% OFF</span>
                                <button id="@product.pid" class="btn-cart-sm" onclick="AddToCart(0, @product.pid, 1, '')">
                                    <i class="bi bi-cart-plus"></i>&nbsp;Add to cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- PRODUCT CARD END -->
            }
        }
    </div>
</section>


<!-- ===== PROMOTIONAL BANNER ===== -->
<section class="container-fluid px-0 my-4 border rounded-4 shadow">
    <div class="hero-banner position-relative">

        <img src="~/images/baner2.png" class="hero-banner-img" alt="Ayurvedic Health Products">

        <div class="banner-overlay">

            <div class="container">

                <div class="banner-content">

                    <h1 class="banner-title">
                        Pure Ayurvedic Wellness for Every Family
                    </h1>

                    <p class="banner-text">
                        Discover authentic herbal supplements, immunity boosters,
                        natural health products, and Ayurvedic remedies crafted
                        to support a healthier and balanced lifestyle.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<script src="~/js/jquery-3.7.1.min.js"></script>
