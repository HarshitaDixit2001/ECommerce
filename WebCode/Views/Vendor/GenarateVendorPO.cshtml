@model AdminPurchaseDto
@{
    ViewData["Title"] = "Generate Vendor PO ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i>Generate Purchase Order</a></li>
    </ol>
</section>

<form asp-action="generate-vendor-po" asp-controller="vendor" method="post">
    @Html.AntiForgeryToken()
    <!-- Main Content -->
    <section class="content">
        <div class="row">

            <div class="col-sm-12">
                <div class="panel panel-bd lobidrag">

                    <div class="panel-body">

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="vendor_id" class="form-label">Vendor Details</label>
                                <select asp-for="vendor_id" asp-items="ViewBag.VendorList" class="form-control select2">
                                    <option value="0">@Const.DROPDOWN_DEFAULT</option>
                                </select>
                                <span asp-validation-for="vendor_id" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="invoice_no" class="form-label">Invoice No.</label>
                                <input asp-for="invoice_no" class="form-control" />
                                <span asp-validation-for="invoice_no" class="text-danger"></span>
                            </div>
                            <div class="col-md-2" style="display:none;">
                                <label asp-for="delivery_date" class="form-label">Expected Delivery Date</label>
                                <input asp-for="delivery_date" class="form-control" type="date" />
                                <span asp-validation-for="delivery_date" class="text-danger"></span>
                            </div>
                            <div class="col-md-2" style="display:none;">
                                <label asp-for="doe" class="form-label">PO Date</label>
                                <input asp-for="doe" class="form-control" type="date" />
                                <span asp-validation-for="doe" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label h5 fw-bold text-primary">Product Search</label>
                                <select id="pid" asp-items="ViewBag.ProductList"
                                        onchange="GetProduct()" class="form-control select2">
                                    <option value="0">@Const.DROPDOWN_DEFAULT</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="panel-body">
                        <div class="table-responsive mb-4">
                            <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total:</th>
                                        <th></th> <!-- Price -->
                                        <th></th> <!-- Qty -->
                                        <th></th> <!-- Gross -->
                                        <th></th> <!-- GST -->
                                        <th></th> <!-- TAX -->
                                        <th></th> <!-- Total Amount -->
                                        <th></th> <!-- Delete -->
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="col-sm-6"> </div>
                    <!-- Right Column: Order Summary -->
                    <div class="col-sm-6">

                        <h5 class="mb-4 text-primary fw-bold">📦 Order Summary</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6"> <span>Sub Total</span> </div>
                            <div class="col-sm-6"> <span id="lbl_SubTotal">0</span> </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6">
                                <span>Discount</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Discount">0</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6">
                                <span>Adjustment</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Adjustment">0</span>
                            </div>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <div class="col-sm-6">
                                <span>Total Amount</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Total">0</span>
                            </div>
                        </div>
                        <hr />
                        <div class="text-end">
                            <button class="btn btn-submit text-white px-4 py-2 rounded-pill shadow-sm">
                                🚀 Generate Purchase Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
@{
    var uid = User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value;
}

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@await Html.PartialAsync("_ValidationScriptsPartial") 


<script>
    // Initialize Select2 dropdown with a placeholder and allow clearing the selection
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });

    $(function () {
        @if (TempData["Error"] != null)
        {
            <text> showErrorLog(`@Const.ERROR_HEADER`, '@TempData["Error"]'); </text>
        }
        @if (TempData["Success"] != null)
        {
            <text> showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]'); </text>
        }
    });

    let URL_ADD_CART = `/cart/add-cart-data`;
    let URL_CART_LIST = `/cart/get-cart-data`;
    let URL_DELETE_CART = `/cart/delete-cart-data`;
    let token="";

    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        $('#delivery_date').val(formatDate(today));
        $('#doe').val(formatDate(today)); 
        $('#delivery_date, #doe').datetimepicker({ timepicker: false, format: 'd-m-Y' });

         token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
         //BindTableData();
          showLoader();
    });



     function BindTableData() {
          showLoader();
          $.ajax({
              url: URL_CART_LIST,
              data: { cart_id: `@Const.VENDOR_PURCHASE_ORDER`, uid: '@uid' },
              type: 'GET',
              headers: { 'Authorization': 'Bearer ' + token },
              success: function (response) {
                   hideLoader();
                  if (response.success === true) {
                      const data =JSON.parse( response.data) || [];
                      $('#tblList').DataTable({
                          dom: 't',
                          scrollY: "500px",
                          scrollCollapse: true,
                          destroy: true,
                          responsive: true,
                          autoWidth: false,
                          pageLength: -1,
                          language: { emptyTable: "No records found" },
                          data: data,
                          columns: [
                              { title: '#',  data: null, render: function (data, type, row, meta) { return meta.row + 1; } },
                              {
                                title: 'Product',
                                orderable: false,
                                render: (_, __, row) =>
                                    `<span>${row.prod_code} -  ${row.prod_name} </span>`
                            },
                              { data: 'price', title: 'Price' },
                              { data: 'qty', title: 'Qty', orderable: false,
                                    render: function (qty, type, row) {
                                        const cid = row.cid;
                                        return `
                                            <div class="input-group input-group-sm" style="max-width: 130px;">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${cid}, -1)">−</button>
                                                <input type="number" min="1" value="${qty}" class="form-control text-center"
                                                id="qty-${cid}" onchange="changeQtyDirect(${cid}, this.value)" maxlength="6" style="width: 10ch;"/>
                                                <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${cid}, 1)">+</button>
                                            </div>
                                            <input type="hidden" id="pid-${row.pid}" value="${row.pid}" />
                                            <input type="hidden" id="rate-${cid}" value="${row.price}" />
                                        `;
                                    }
                              },

                              { data: 'gross', title: 'Gross' },
                              { data: 'gst', title: 'GST', render: gst => `${gst}%` },
                              { data: 'gst_amt', title: 'TAX' },
                              { data: 't_amount', title: 'Net Amount' },
                              { data: 'cid', title: '<i class="fa fa-trash text-danger" aria-hidden="true"></i>', orderable: false,  render: function (id) { return `<i class="fa fa-trash text-danger" aria-hidden="true" onclick="Delete_By_Id(${id})" style="cursor:pointer; padding:2px; margin:2px;"></i>`; } },
                              {
                                data: 'prod_type', title: 'Prod Type',
                                render: p => p == 1
                                    ? '<span class="text-success">🟢 Normal</span>'
                                    : p == 3
                                        ? '<span class="text-primary">🧪 Sample</span>'
                                        : p
                              }
                          ],
                          "footerCallback": function (row, data, start, end, display) {
                              const api = this.api();
                              function getTotal(index) { return api.column(index, { page: 'current' }).data().reduce((a, b) => { const x = parseFloat(a) || 0; const y = parseFloat(b) || 0; return x + y; }, 0); }

                              // ✅ Store sums in variables
                               const totalQty = getTotal(3);         // Qty
                               const totalGross = getTotal(4);       // Gross
                               const totalTax = getTotal(6);         // TAX
                               const totalAmount = getTotal(7);      // Total Amount

                               // ✅ Assign to footer
                               $(api.column(3).footer()).html(totalQty.toFixed(0));
                               $(api.column(4).footer()).html(totalGross.toFixed(2));
                               $(api.column(6).footer()).html(totalTax.toFixed(2));
                               $(api.column(7).footer()).html(totalAmount.toFixed(2));

                               // ✅ You can now use these values elsewhere if needed
                               $('#lbl_SubTotal').text(totalGross.toFixed(2));
                               $('#lbl_Discount').text("0.00");
                               $('#lbl_Adjustment').text("0.00");
                               $('#lbl_Total').text(totalAmount.toFixed(2));
                          }
                      });
                  }
              },
              error: function (xhr, status, error) {
                  showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
              }
          });
      }



     function GetProduct(){
        const pid = $('#pid').val();
        if (parseInt(pid) > 0) {
             const pidOld = document.getElementById(`pid-${pid}`)?.value;
             if (pidOld === pid) {
                 showToastSuccess("⚠️ Product already exists in the list.");
             } else {
                 updateQty(0, $('#pid').val(), 0, 1);
             }
        }
     }


     function updateQty(cid, pid, rate, qty){
           if(pid === "0"){ return; }

           $.ajax({
               url: URL_ADD_CART,
               type: 'GET',
               data: {cart_id: `@Const.VENDOR_PURCHASE_ORDER`, uid: '@uid', rate, prod_type : 1, pid, cid, qty},
               success: function (response) {
                   if(response.success == true){
                       showToastSuccess('Saved successfully.');
                       BindTableData();
                   }else{
                       showErrorLog(`@Const.ERROR_HEADER`, response.message);
                   }
               },
               error: function (res_error) {
                    showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
               }
           });
     }


     function changeQty(cid, delta) {
            let rate = parseFloat(document.getElementById(`rate-${cid}`)?.value) || 0;
            let input = document.getElementById(`qty-${cid}`);
            let newQty = (parseInt(input?.value) || 1) + delta;
            input.value = Math.min(Math.max(newQty, 1), 999999);
            updateQty(cid, 0, rate, input.value);
     }



    function changeQtyDirect(cid, value) {
        const rate = parseFloat(document.getElementById(`rate-${cid}`)?.value) || 1;
        const newQty = Math.min(Math.max(parseInt(value) || 1, 1), 999999);
        document.getElementById(`qty-${cid}`).value = newQty;
        updateQty(cid, 0, rate, newQty);
    }





       function Delete_By_Id(id){
           $.ajax({
               url: URL_DELETE_CART,
               data: { id: id },
               type: 'GET',
               contentType: 'application/json',
               headers: { 'Authorization': 'Bearer ' + token },
               success: function (response) {
                   debugger;

                   if(response.success == true){ BindTableData(); }
                   else{ showErrorLog(`@Const.ERROR_HEADER`, response.message); }
               },
               error: function (res_error) {
                   showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
               }
           });
       }

</script>


 

<style>
    body {
        background-color: #f8f9fa;
    }

    .summary-card {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    .btn-submit {
        background-color: #0d6efd;
        border: none;
    }

        .btn-submit:hover {
            background-color: #0b5ed7;
        }
</style>