@* @model VendorDto *@
@{
    ViewData["Title"] = "Vendor Management";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

} 
 
<!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i>Vendor Management</a></li>
    </ol>
        <a asp-action="vendor-add" asp-controller="vendor"
           class="btn btn-success pull-right"> <i class="fa fa-plus"></i> New </a>
  
</section>

<!-- Main Content -->
<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading">
                    <div class="col-sm-3">
                        <input id="vendor_name" name="vendor_name" class="form-control" />
                    </div>
                    <div class="col-sm-1">
                        <input type="submit" ID="btnSearch" class="btn btn-info" value="Search" />
                    </div>
                    <div class="col-sm-6">
                    </div>
                   
                </div>

                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
                    </div>
                </div>
            </div>
        </div> 
    </div>
</section>
 
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@

<script>
    let token = "";
    const DOWNLOAD_FILE_NAME="Vendor_";  
    let URL_LIST = `/common/master-reports`;
    let mst_key="GET_VENDOR_LIST";

    $(function () {
         
        token = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString()))";
        BindTableData();
        @if (TempData["Success"] != null)
        {
            <text> showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]'); </text>
        } 
    });


     function BindTableData() {
        let vendor_name= $('#vendor_name').val();
         showLoader();
         $.ajax({
             url: URL_LIST + `?mst_key=${mst_key}`,
             data: '{vendor_name: "' + vendor_name + '"}',
             type: 'GET',
             headers: { 'Authorization': 'Bearer ' + token },
             success: function (response) {
                  hideLoader();
                 if (response.token_valid === false) {
                     window.location.href = `@Const.LOGOUT`;
                     return;
                 }
                 else if (response.success === true && response.token_valid === true) {
                     const data = JSON.parse(response.data) || [];

                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                             scrollY: "500px",
                             scrollX: true,
                             scrollCollapse: true,
                             destroy: true,
                             responsive: true,
                             autoWidth: false,
                             language: { emptyTable: "No records found" },
                             "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                             "pageLength": 15,
                             buttons: [
                                 { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                { extend: 'copyHtml5', text: 'Copy'},
                                'fullscreenToggle',
                                'colvis',
                             ],
                             data: data,
                             columns: [
                             {
                                 data: 'vendor_id', title: '<i class="fa fa-pencil" aria-hidden="true" title="Edit"></i>', orderable: false,
                                 render: function (id) { return `<a href="/vendor/vendor-add/${id}" target="_blank" class="text-primary"> <i class="fa fa-pencil" aria-hidden="true" title="Edit"></i> </a>`; }
                             },
                             { data: 'vendor_name', title: 'Name' },
                             { data: 'display_name', title: 'Display name' },
                             { data: 'email_id', title: 'Email id' },
                             { data: 'phone_no', title: 'Phone No.' },
                             { data: 'mobile_id', title: 'Mobile No.' },
                             { data: 'source_supply', title: 'Source Supply' },
                             { data: 'skype_name', title: 'Skype Name' },
                             { data: 'designation', title: 'Designation' },
                             { data: 'department', title: 'Department' },
                             { data: 'website', title: 'Website' },
                             {
                                 data: 'status', title: 'Status', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> Active<div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> InActive <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             }
                         ],
                         "footerCallback": function (row, data, start, end, display) {
                             const api = this.api();
                         }
                     });
                 }
             },
             error: function (xhr, status, error) {
                 showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }

</script>



