@model AdminPurchaseReceiveDto
@{
    ViewData["Title"] = "Received Purchase Order ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Received Purchase Order
    </h4>
    <a asp-controller="vendor" asp-action="vendor-po-list" class="btn btn-sm btn-outline-success">
        Purchase Order List
    </a>
</section>
<br />
 


<form asp-action="vendor-received-po" asp-route-id="@Model?.purchase_id" asp-controller="vendor" method="post">
    @Html.AntiForgeryToken()
    <!-- Main Content -->
    <section class="content">
        <div class="row">

            <div class="col-sm-12">
                <div class="panel panel-bd lobidrag">

                    <div class="panel-body">

                        <div class="row mb-3">
                            <div class="col-md-6">

                                <input type="hidden" name="purchase_id" value="@Model.purchase_id" />


                                <label asp-for="purchase_id" class="form-label">Purchase Order</label>
                                <select asp-for="purchase_id" asp-items="ViewBag.VendorPOList" class="form-control select2">
                                    <option value="0">@Const.DROPDOWN_DEFAULT</option>
                                </select>
                                <span asp-validation-for="purchase_id" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="vendor_inv_no" class="form-label">Invoice No.</label>
                                <input asp-for="vendor_inv_no" class="form-control" />
                                <span asp-validation-for="vendor_inv_no" class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="vendor_inv_date" class="form-label">Delivery Date</label>
                                <input asp-for="vendor_inv_date" class="form-control" type="text" />
                                <span asp-validation-for="vendor_inv_date" class="text-danger"></span>
                            </div>
                            <!-- Status Checkbox -->
                            <div class="col-md-2 form-check pt-2">
                                <br />
                                <input asp-for="status" class="form-check-input me-2" />
                                <label asp-for="status" class="form-check-label">Close PO</label>
                            </div>
                        </div>
                    </div>

                    <div class="panel-body">
                        <div class="table-responsive mb-4">
                            <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                                <tfoot>
                                    <tr>
                                        <th colspan="5" class="text-end">Total:</th>
                                        <th></th>  
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="col-sm-6"> </div>
                    <!-- Right Column: Order Summary -->
                    <div class="col-sm-6">

                        <h5 class="mb-4 text-primary fw-bold">📦 Order Summary</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6"> <span>Sub Total</span> </div>
                            <div class="col-sm-6"> <span id="lbl_SubTotal">0</span> </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6">
                                <span>Discount</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Discount">0</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <div class="col-sm-6">
                                <span>Adjustment</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Adjustment">0</span>
                            </div>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <div class="col-sm-6">
                                <span>Total Amount</span>
                            </div>
                            <div class="col-sm-6">
                                <span id="lbl_Total">0</span>
                            </div>
                        </div>
                        <hr />
                        <div class="text-end">
                            <button class="btn btn-submit px-4 py-2 rounded-pill shadow-sm btn-primary">
                                🚀 Generate Purchase Order
                            </button>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </section>
</form>
@{
    var uid = User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value;
}

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@await Html.PartialAsync("_ValidationScriptsPartial") 
<script>
    // Initialize Select2 dropdown with a placeholder and allow clearing the selection
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });

    $(function () {
    @if (TempData["Error"] != null)
    {
        <text> showErrorLog(`@Const.ERROR_HEADER`, '@TempData["Error"]'); </text>
    }
    @if (TempData["Success"] != null)
    {
        <text> showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]'); </text>
    }
    });

    let batchOptions = [];
    let URL_LIST = `/print/get-vendor-po-detail`;
    let URL_UPDATE_CART = `/cart/update-invoice-detail-id`;
    //let URL_DROPDOWN_LIST = `/common/get-drop-list`;
    let URL_DROPDOWN_LIST =  `/common/get-master-dropdown`;
    let token="";

    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        $('#vendor_inv_date').val(formatDate(today));
        $('#vendor_inv_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });
         
         token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
         loadBatchOptions(BindTableData);
    });



     function BindTableData() {
         let inv_id= $('#purchase_id').val();
          showLoader();
          $.ajax({
              url: URL_LIST,
              data: { inv_id: inv_id },
              type: 'GET',
              headers: { 'Authorization': 'Bearer ' + token },
              success: function (response) {
                   
                   hideLoader();
                  if (response.success === true) {
                      const data =JSON.parse(response.data) || [];
                       
                      $('#tblList').DataTable({
                          dom: 't',
                          scrollY: "500px",
                          scrollCollapse: true,
                          destroy: true,
                          responsive: true,
                          autoWidth: false,
                          pageLength: -1,
                          language: { emptyTable: "No records found" },
                          data: data,
                          columns: [
                               { title: '#',  data: null, render: function (data, type, row, meta) { return meta.row + 1; } },
                               { title: 'Product', data: null, render: function (data, type, row) { return `${row.prod_code} <br> ${row.prod_name}`; } },
                               // {
                               //      title: 'Batch',
                               //      data: 'batch_id',
                               //      render: function (data, type, row, meta) {
                               //          const currentBatch = data || '';
                               //          const optionsHtml = batchOptions.map(opt =>  `<option value="${opt.value}" ${opt.value == currentBatch ? 'selected' : ''}>${opt.text}</option>` ).join('');
                               //          return `<select class="select2 form-select form-select-sm" onchange="onBatchChange(${row.inv_det_id}, this.value)">  ${optionsHtml} </select>`;
                               //      }
                               // },

                               {
                                    title: 'Batch',
                                    data: 'batch_id',
                                    width: '180px',
                                    render: function (data, type, row, meta) {
                                        const currentBatch = data || '';

                                        // Always start with a default option
                                        let optionsHtml = '<option value="">-- Select Batch --</option>';

                                        // Append options only if batchOptions is a valid array with items
                                        if (Array.isArray(batchOptions) && batchOptions.length > 0) {
                                            optionsHtml += batchOptions.map(opt =>
                                                `<option value="${opt.value}" ${opt.value == currentBatch ? 'selected' : ''}>${opt.text}</option>`
                                            ).join('');
                                        }

                                        return `
                                            <select class="select2 form-select form-select-sm w-180" style="min-width:160px"
                                                    onchange="onBatchChange(${row.inv_det_id}, this.value)">
                                                ${optionsHtml}
                                            </select>`;
                                    }
                               },


                              { data: 'mrp', title: 'MRP' },
                              { data: 'price', title: 'Rate', render: function (data, type, row, meta) { return `<input type="number" value="${data}" class="form-control form-control-sm text-end" style="width: 100px;"  onchange="onRateChange(${row.inv_det_id}, this.value)"  id="rate-${row.inv_det_id}" />`; } },
                              { data: 'qty', title: 'Order <br> Qty' },
                              { data: 'recd_qty', title: "Alr <br> Rcv'd" },
                              {
                                  data:'curr_qty',
                                  title: 'Receive',
                                  orderable: false,
                                  data: null,
                                  render: function (data, type, row) {
                                      return `
                                          <div class="input-group input-group-sm" style="max-width: 130px;">
                                              <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${row.inv_det_id}, -1)">−</button> &nbsp;
                                              <input type="number" min="0" class="form-control text-center receive-input" id="qty-${row.inv_det_id}" data-id="${row.inv_det_id}" value="${row.curr_qty}" onchange="changeQtyDirect(${row.inv_det_id}, this.value)" style="width: 10ch;" />
                                              <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${row.inv_det_id}, 1)">+</button>
                                          </div>
                                      `;
                                  }
                              },
                              { data: 'curr_gross', title: 'Gross' },
                              { data: 'tax', title: 'GST' },
                              { data: 'curr_taxrs', title: 'TAX <br> AMT' },
                              { data: 'curr_total', title: 'Net <br> Amount' },
                          ],
                          "footerCallback": function (row, data, start, end, display) {
                              const api = this.api();
                              function getTotal(index) { return api.column(index, { page: 'current' }).data().reduce((a, b) => { const x = parseFloat(a) || 0; const y = parseFloat(b) || 0; return x + y; }, 0); }

                              // ✅ Store sums in variables
                               const OrderQty = getTotal(5);
                               const AlreadyRcvdQty = getTotal(6);
                               //const ReceiveQty = getTotal(7);

                               let ReceiveQty = 0;
                                api.column(7, { page: 'current' }).nodes().each(function (cell) {
                                    const input = $(cell).find('input');
                                    const val = parseFloat(input.val()) || 0;
                                    ReceiveQty += val;
                                });
                               // let ReceiveQty = 0;
                               //  $('.receive-input').each(function () {
                               //      ReceiveQty += parseFloat($(this).val()) || 0;
                               //  });

                               const totalGross = getTotal(8);
                               const totalTax = getTotal(10);
                               const totalAmount = getTotal(11);

                               // ✅ Assign to footer
                               $(api.column(5).footer()).html(OrderQty.toFixed(0));
                               $(api.column(6).footer()).html(AlreadyRcvdQty.toFixed(0));
                               $(api.column(7).footer()).html(ReceiveQty.toFixed(0));

                               $(api.column(8).footer()).html(totalGross.toFixed(2));
                               $(api.column(10).footer()).html(totalTax.toFixed(2));
                               $(api.column(11).footer()).html(totalAmount.toFixed(2));

                               // ✅ You can now use these values elsewhere if needed
                               $('#lbl_SubTotal').text(totalAmount.toFixed(2));
                               $('#lbl_Discount').text("0.00");
                               $('#lbl_Adjustment').text("0.00");
                               $('#lbl_Total').text(totalAmount.toFixed(2));
                          }
                      });
                  }
              },
              error: function (xhr, status, error) {
                 showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
              }
          });
      }



      function onBatchChange(inv_det_id, batch_id) {
            updateData('batch_id', inv_det_id, batch_id);
        }



     function onRateChange(inv_det_id, newRate) {
        updateData('price', inv_det_id, newRate);
    }



       function updateData(ColumnName, inv_det_id, val){
           var payload = {
               tableName: 'tbl_admin_purchase_order_details',
               ColumnName: ColumnName,
               inv_det_id: inv_det_id,
               val: val
           };
           $.ajax({
               url: URL_UPDATE_CART,
               method: 'POST',
               contentType: 'application/json',
               data: JSON.stringify(payload),
               headers: { 'Authorization': 'Bearer ' + token },
               success: function (response) {
                   if(response.success == true){
                       showToastSuccess('Updated.!!');
                       BindTableData();
                   }else{  showErrorLog(`@Const.ERROR_HEADER`, response.message); }
               },
               error: function (res_error) {   showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return; }
           });
       }


      function changeQty(inv_det_id, delta) {
           const input = document.getElementById(`qty-${inv_det_id}`);
           let currentQty = parseInt(input.value) || 1;
           let newQty = currentQty + delta;
           newQty = Math.min(Math.max(newQty, 1), 999999);
           updateData('curr_qty', inv_det_id, newQty);
       }


       function changeQtyDirect(inv_det_id, value) {
           const input = document.getElementById(`qty-${inv_det_id}`);
           let newVal = parseInt(value) || 0;
           let max = parseInt(input.dataset.max) || 999999;

           if (newVal < 0) newVal = 0;
           if (newVal > max) newVal = max;
           updateData('curr_qty', inv_det_id, newVal);
       }



    function loadBatchOptions(callback) {

        $.get(`${URL_DROPDOWN_LIST}?id=0&mst_key=GET_BATCH_LIST`, res => {
             batchOptions = res.data; // Assumes [{ id: 1, name: "Batch A" }, ...]
             callback(); // Proceed to bind table

            // const def = '@Const.DROPDOWN_DEFAULT';
            // stateId == 0
            //     ? $dist.html(`<option selected value="0">${def}</option>`)
            //     : PopulateControl(res.data, $dist, def, 0);
        }).fail(() => {
             showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
        });


        // $.ajax({
        //     url: `${URL_DROPDOWN_LIST}?id=0&mst_key=GET_BATCH_LIST`,
        //     type: 'GET',
        //     success: function (response) {
        //         batchOptions = response.data; // Assumes [{ id: 1, name: "Batch A" }, ...]
        //         callback(); // Proceed to bind table
        //     },
        //     error: function () {  alert('Failed to load batch list.'); }
        // });
    }


    $('#tblList').on('draw.dt', function () {
        $('.select2').select2({
            width: 'resolve',
            dropdownParent: $('#tblList').closest('div') // Adjust if inside modal
        });
    });


    function updateCurrQtyInDataTable(inv_det_id, newQty) {
        const table = $('#tblList').DataTable();
        table.rows().every(function () {
            const rowData = this.data();
            if (rowData.inv_det_id === inv_det_id) {
                rowData.curr_qty = newQty;
                this.data(rowData); // Update the row's data in DataTable
            }
        });
    }

</script>
 