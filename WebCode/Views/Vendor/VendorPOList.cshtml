@{
    ViewData["Title"] = "Purchase Order List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 

@{
    var uid = User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value;
}

<!-- Breadcrumb -->
 
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Purchase Order List
    </h4> 
</section>
<br />


<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading row">
                    <div class="col-sm-3">
                        <select id="vendor_id" asp-items="ViewBag.VendorList" class="form-control select2">
                            <option value="0">🔍 Select Vendor</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div>
                    <div class="col-sm-2">
                        <input id="purchase_order_no" class="form-control" placeholder="PO No" />
                    </div>
                    <div class="col-sm-2">
                        <input type="button" id="btnSearch" class="btn btn-info" value="Search" />
                    </div>
                </div>

                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@
<script>

    let table;
    let token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
    const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';

    const DOWNLOAD_FILE_NAME = "Vendor_PO_";

    $(function () {
        $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(today.getDate() - 7);

        $('#from_date').val(formatDate(weekAgo));
        $('#to_date').val(formatDate(today));

        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        initializeTable();

        $('#btnSearch').on('click', function () {
            table.ajax.reload();
        });


    @if (TempData["Success"] != null)
    {
        <text> showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]'); </text>
    }
    });


    function initializeTable() {
        table = $('#tblList').DataTable({
            dom: 'Blfrtip',
            scrollY: "500px",
            processing: true,
            scrollX: true,
            autoWidth: true,
            responsive: true,
            destroy: true,
            lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
            pageLength: @Const.NO_OF_PAGE_RECORDS,
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                { extend: 'copyHtml5', text: 'Copy'},
                'fullscreenToggle',
                'colvis',
            ],
            ajax: {
                url: `/vendor/get-vendor-po-list`,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + token },
                data: function (d) {
                    const parseDate = (dateStr) => {
                        if (!dateStr) return null;
                        const parts = dateStr.split("-");
                        return parts.length === 3 ? `${parts[1]}/${parts[0]}/${parts[2]}` : null;
                    };
                    const in_page_record = d.length || 10;
                    const in_page_no = Math.floor(d.start / in_page_record) + 1;

                    return JSON.stringify({
                        purchase_order_no: $('#purchase_order_no').val() || '',
                        vendor_id: parseInt($('#vendor_id').val()) || 0,
                        buyer_uid: parseInt(uid) || 0,
                        from_date: parseDate($('#from_date').val()),
                        to_date: parseDate($('#to_date').val()),
                        in_page_no: in_page_no,
                        in_page_record: in_page_record
                    });
                },
                dataSrc: function (json) {
                    if(json.token_valid === false){
                        window.location.href = `@Const.LOGOUT`; return;
                    }
                    let data = [];
                    try { data = json?.data || []; } catch (e) { console.error(e); }
                    return data;
                }
            },
            columns: [
                { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                {
                    title: 'Order No',
                    data: 'purchase_order_no',
                    render: function (data, type, row) {
                        return `<a href="/print/vendor-inv-detail/${row.purchase_id}" target="_blank" class="text-primary text-decoration-underline">${data}</a>`;
                    }
                },
                {
                    data: null,
                    title: 'Receive',
                    render: (data, type, row) => {
                        const isGRN = row.status === 0;
                        return `<a class="text-primary text-decoration-underline dropdown-item ${isGRN ? '' : 'disabled'}"
                                href="${isGRN ? `/vendor/vendor-received-po/${row.purchase_id}` : 'javascript:void(0);'}"
                                ${isGRN ? '' : 'style="pointer-events: none; opacity: 0.5;"'}>
                                ${isGRN ? '📦 GRN' : '✔ Received'} </a> `;
                    }
                },
                { data: 'vendor_name', title: 'Vendor' },
                { data: 't_gross', title: 'Gross' },
                { data: 't_tax_rs', title: 'Tax' },
                { data: 'amount', title: 'Amount' },
                { data: 't_amount', title: 'Total Amount' },
                { data: 'adjust_amt', title: 'Adjustment' },
                { data: 'doe', title: 'Date', render: (data) => data ? new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                { data: 'invoice_no', title: 'Invoice No' },
                { data: 'buyer_user_id', title: 'Buyer ID' },
                { data: 'buyer_name', title: 'Buyer Name' },
                {
                  data: 'status',
                  title: 'Status',
                  orderable: false,
                  render: (data, type, row) => {
                    const statusMap = {
                       0: { text: 'Pending...', class: 'text-primary' },
                      1: { text: 'Approved', class: 'text-success' },
                      2: { text: 'Cancelled', class: 'text-danger' }
                    };

                    const status = statusMap[data] || { text: 'Unknown', class: 'text-secondary' };
                    return ` <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                             <span><i class="fa fa-circle ${status.class} me-1"></i> ${status.text}</span>
                        </div> `;
                  }
                }
                // { data: 'status', title: 'Status', orderable: false,
                //     render: function (data) {
                //          return data
                //         ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                //         : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                //     }
                // },
            ]
        });
    }
</script> 