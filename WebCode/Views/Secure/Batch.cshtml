 
@{
    ViewData["Title"] = "Batch";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

 
<!-- Breadcrumb -->
@* <section class="content-header">
    <ol class="breadcrumb pull-right"> 
        <li><a><i class="fa fa-list"></i> Batch Management</a></li>
        <li class="active"></li>
    </ol>
</section> *@

<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Batch Management
    </h4> 
</section> 
<div class="clearfix"></div>
<br />

<!-- Main Content -->
<section class="content">
    <div class="row">
        <div class="col-sm-8">
            <div class="panel panel-bd lobidrag">
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="panel panel-bd lobidrag">
                <div class="panel-body">
                    <!-- Form: Add / Edit -->
                    <hr />
                    <h4 class="header-title">Batch Management</h4>
                    
                    <form id="SubmitForm">
                        <input type="hidden" id="batch_id" name="batch_id" value="0" />
                        <div>
                            <label>Batch Name <span class="font-bold text-danger">*</span></label>
                            <input id="batch_no" name="batch_no" class="form-control" />
                        </div>

                         <div>
                            <label>MFD <span class="font-bold text-danger">*</span></label>
                            <input id="mfg_date" name="mfg_date" class="form-control" />
                        </div>
                        <div>
                            <label>EXP <span class="font-bold text-danger">*</span></label>
                            <input id="exp_date" name="exp_date" class="form-control" />
                        </div>
                        <div>
                            <input type="checkbox" id="status" name="status" />
                            <label for="status">Active</label>
                        </div>
                        <button type="submit" id="saveBtn" class="btn btn-primary">Add</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>


@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@
<script>
     let token = "";
     const DOWNLOAD_FILE_NAME="Batch";
     let URL_ADD = `/common/add-batch`;
     let URL_LIST = `/common/master-reports`;
     let mst_key="GET_BATCH_LIST";

     $(function () {
     
         $('#mfg_date, #exp_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });


         token = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString()))";
         BindTableData();
     });


      function BindTableData() {
          showLoader();
          $.ajax({
              url: URL_LIST + `?mst_key=${mst_key}`,
              type: 'GET',
              headers: { 'Authorization': 'Bearer ' + token },
              success: function (response) {
                   hideLoader();
                  if (response.token_valid === false) {
                      window.location.href = `@Const.LOGOUT`;
                      return;
                  }
                  else if (response.success === true && response.token_valid === true) {
                      const data = JSON.parse(response.data) || [];
                      $('#tblList').DataTable({
                          dom: 'Blfrtip',
                              scrollY: "500px",
                              scrollX: true,
                              scrollCollapse: true,
                              destroy: true,
                              responsive: true,
                              autoWidth: false,
                              language: { emptyTable: "No records found" },
                              "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                              "pageLength": 15,
                              buttons: [
                                  { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                  { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                    { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                    { extend: 'copyHtml5', text: 'Copy'},
                                    'fullscreenToggle',
                                    'colvis',
                              ],
                              data: data,
                              columns: [
                              {
                                  data: 'batch_id', title: 'Edit', orderable: false,
                                  render: function (id) { return `<i class="fa fa-pencil text-primary" aria-hidden="true" onclick="Get_Detail_By_Id(${id})" style="cursor:pointer; padding:2px; margin:2px;"></i> `; }
                              },
                              { data: 'batch_no', title: 'Batch No.' },
                              { data: 'mfg_date', title: 'MFG Date' },
                              { data: 'exp_date', title: 'EXP. Date' },
                              {
                                  data: 'status', title: 'Status', orderable: false,
                                  render: function (data) {
                                       return data
                                      ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                      : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                  }
                              }
                          ],
                          "footerCallback": function (row, data, start, end, display) {
                              const api = this.api();
                          }
                      });
                  }
              },
              error: function (xhr, status, error) {
                  showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
              }
          });
      }



     function Get_Detail_By_Id(id) {
         var mst_key_detail = true;
         showLoader();
         $.ajax({
             url: URL_LIST + `?id=${id}&mst_key=${mst_key}&mst_key_detail=${mst_key_detail}`,
             method: 'GET',
             contentType: 'application/json',
             headers: { 'Authorization': 'Bearer ' + token },
             success: function (response) {
                 hideLoader();
                  if (response.token_valid === false) {
                      window.location.href = `@Const.LOGOUT`; return;
                  }
                  else if (response.success === true && response.token_valid === true) {
                     const dataArray = JSON.parse(response.data) || [];
                     const data = dataArray[0] || {};
                     $('#batch_id').val(data.batch_id);
                     $('#batch_no').val(data.batch_no);
                     $('#mfg_date').val(data.mfg_date);
                     $('#exp_date').val(data.exp_date);

                     $('#status').prop('checked', data.status); 
                     $('#saveBtn').text('Update');
                  } else {
                     showErrorLog(`@Const.ERROR_HEADER`, response.message);
                  }
             },
             error: function (res_error) {
                 showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }



     $('#SubmitForm').submit(function (e) {
         e.preventDefault();
         if($('#batch_no').val().trim() === '') {
             showErrorLog(`@Const.ERROR_HEADER`, "Batch No. is required.");  return;
          }
         const formData = new FormData(this);
         formData.set("status", $('#status').is(':checked'));
         formData.set("mfg_date", parseDate($('#mfg_date').val()));
         formData.set("exp_date", parseDate($('#exp_date').val()));
         showLoader();
         $.ajax({
             url: URL_ADD,
             type: 'POST',
             data: formData,
             processData: false,        // Important!
             contentType: false,        // Important!
             headers: { 'Authorization': 'Bearer ' + token },
             success: function (response) {
                 hideLoader();
                 if (response.token_valid === false) {
                     window.location.href = `@Const.LOGOUT`;
                     return;
                 }
                 else if(response.success == true && response.token_valid == true){
                      showToastSuccess('Data save successfully');
                     $('#SubmitForm')[0].reset();
                     $('#saveBtn').text('Add');
                     $('#batch_id').val(0);
                     BindTableData();
                 }else{
                     showErrorLog(`@Const.ERROR_HEADER`, response.message);
                 }
             },
             error: function (res_error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     });
</script>
 