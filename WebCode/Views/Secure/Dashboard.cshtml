                                <small class="text-muted">Paid</small>
                            </div>
                            <div class="col-6">
                                <h4 class="fw-bold text-danger mb-0">
                                    <span id="total_user">0</span>
                                </h4>
                                <small class="text-muted">Unpaid</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div> *@

        </div>

    </section>




    <div class="clearfix"></div>
    <hr />


    <ul class="nav nav-tabs gray-tabs" id="myTab" role="tablist">

        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="sales-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#tab10"
                    type="button"
                    role="tab">
                📊 Monthly Sales
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="category-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#tab11"
                    type="button"
                    role="tab">
                📦 Category-wise Sales
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="product-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#tab12"
                    type="button"
                    role="tab">
                🛒 Product-wise Sales
            </button>
        </li>

    </ul>

    <div class="tab-content mt-3">

        <div class="tab-pane fade show active"
             id="tab10"
             role="tabpanel">

            <div id="salesCollectionChart"
                 style="height:400px;"></div>

        </div>

        <div class="tab-pane fade"
             id="tab11"
             role="tabpanel">

            <div id="categoryChart"
                 style="height:400px;"></div>

        </div>

        <div class="tab-pane fade"
             id="tab12"
             role="tabpanel">

            <div id="productChart"
                 style="height:400px;"></div>

        </div>

    </div>


</div>



@await Html.PartialAsync("_DatePicker")
<script>

    $(function () {
         const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
         const today = new Date();
         const startDateofMonth = new Date(today.getFullYear(), today.getMonth(), 1);

         $('#from_date').val(formatDate(startDateofMonth));
         $('#to_date').val(formatDate(today));
         $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });
    });
</script>





