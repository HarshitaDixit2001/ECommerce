    function GetProductWiseGraph() {

        let from_date = parseDate($('#from_date').val());
        let to_date = parseDate($('#to_date').val());

        let prod_url = `/secure/get-product-wise-graph?from_date=${from_date}&to_date=${to_date}&uid=${uid}`;

        $.get(prod_url, function (resp) {

            const ProductData = (JSON.parse(resp.data) || []);

            if (!ProductData.length) {
                $('#productChart').html('<p style="text-align:center;color:#2E7D32;font-size:16px;">🌿 No product sales data available.</p>');
                return;
            }

            const categories = ProductData.map(p => p.name);
            const amounts = ProductData.map(p => p.total);
            const quantities = ProductData.map(p => p.qty);

            Highcharts.chart('productChart', {

                chart: {
                    zoomType: 'xy',
                    backgroundColor: '#F8FFF5',
                    borderRadius: 12
                },

                colors: [
                    '#43A047',
                    '#F9A825'
                ],

                title: {
                    text: '' 
                },

                xAxis: {

                    categories: categories,

                    crosshair: true,

                    lineColor: '#A5D6A7',

                    tickColor: '#A5D6A7',

                    labels: {
                        style: {
                            color: '#2E7D32',
                            fontSize: '14px',
                            fontWeight: '600'
                        }
                    },

                    scrollbar: {
                        enabled: categories.length > 10
                    },

                    min: 0,

                    max: categories.length > 10 ? 9 : null

                },

                yAxis: [

                    {

                        gridLineColor: '#DCEFD8',

                        labels: {

                            style: {
                                color: '#388E3C',
                                fontSize: '14px'
                            },

                            formatter: function () {

                                return '₹' + formatINR(this.value);

                            }

                        },

                        title: {

                            text: 'Amount (₹)',

                            style: {
                                color: '#1B5E20',
                                fontSize: '16px',
                                fontWeight: '600'
                            }

                        }

                    },

                    {

                        opposite: true,

                        labels: {

                            style: {
                                color: '#F57F17',
                                fontSize: '14px'
                            }

                        },

                        title: {

                            text: 'Quantity (pcs)',

                            style: {
                                color: '#F57F17',
                                fontSize: '16px',
                                fontWeight: '600'
                            }

                        }

                    }

                ],

                tooltip: {

                    shared: true,

                    backgroundColor: '#1B5E20',

                    borderColor: '#43A047',

                    borderRadius: 8,

                    style: {

                        color: '#FFFFFF',

                        fontSize: '14px'

                    },

                    formatter: function () {

                        const index = this.points[0].point.index;

                        return `<b style="font-size:16px">${categories[index]}</b><br/>
                                💰 Amount : <b>₹${formatINR(amounts[index])}</b><br/>
                                📦 Qty : <b>${quantities[index]} pcs</b>`;

                    }

                },

                legend: {

                    layout: 'horizontal',

                    align: 'center',

                    verticalAlign: 'top',

                    itemStyle: {

                        color: '#2E7D32',

                        fontSize: '15px',

                        fontWeight: '600'

                    },

                    itemHoverStyle: {

                        color: '#1B5E20'

                    }

                },

                credits: {
                    enabled: false
                },

                plotOptions: {

                    column: {

                        borderRadius: 6,

                        pointPadding: 0.15,

                        borderWidth: 0,

                        dataLabels: {

                            enabled: true,

                            formatter: function () {

                                return '₹' + formatINR(this.y);

                            },

                            style: {

                                color: '#1B5E20',

                                fontSize: '13px',

                                fontWeight: '600',

                                textOutline: 'none'

                            }

                        }

                    },

                    spline: {

                        lineWidth: 4,

                        marker: {

                            enabled: true,

                            radius: 5,

                            fillColor: '#F9A825',

                            lineColor: '#FFFFFF',

                            lineWidth: 2

                        },

                        dataLabels: {

                            enabled: true,

                            formatter: function () {

                                return this.y + ' pcs';

                            },

                            style: {

                                color: '#F57F17',

                                fontSize: '13px',

                                fontWeight: '600',

                                textOutline: 'none'

                            }

                        }

                    }

                },

                series: [

                    {

                        name: 'Amount',

                        type: 'column',

                        yAxis: 0,

                        color: '#43A047',

                        data: amounts

                    },

                    {

                        name: 'Quantity',

                        type: 'spline',

                        yAxis: 1,

                        color: '#F9A825',

                        data: quantities,

                        marker: {

                            enabled: true

                        }

                    }

                ]

            });

        });

    }
</script>






