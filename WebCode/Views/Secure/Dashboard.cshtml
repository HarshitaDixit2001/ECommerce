    function GetCategoryWiseGraph() {

            let from_date = parseDate($('#from_date').val());
            let to_date = parseDate($('#to_date').val());

            let cat_url = `/secure/get-category-wise-graph?from_date=${from_date}&to_date=${to_date}&uid=${uid}`;

            $.get(cat_url, function (resp) {

                const rawData = JSON.parse(resp.data) || [];

                const categoryData = rawData.map(item => ({
                    name: item.name,
                    y: item.total,
                    qty: item.qty
                }));

                categoryData.sort((a, b) => a.name.localeCompare(b.name));

                Highcharts.chart('categoryChart', {

                    chart: {
                        type: 'pie',
                        backgroundColor: '#F8FFF5'
                    },

                    colors: [
                        '#2E7D32',
                        '#43A047',
                        '#66BB6A',
                        '#81C784',
                        '#A5D6A7',
                        '#C5E1A5',
                        '#8BC34A',
                        '#9CCC65',
