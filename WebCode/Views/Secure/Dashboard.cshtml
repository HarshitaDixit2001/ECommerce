            function GetSelesDashboard() {
                  let from_date = parseDate($('#from_date').val());
                  let to_date = parseDate($('#to_date').val()); 
                  let URL_LIST = `/secure/get-sales-dashboard?from_date=${from_date}&to_date=${to_date}&uid=${uid}`;
                  showLoader();
                  $.get(URL_LIST, function (resp) {
                       hideLoader();
                      if (resp.success === true) {
                           const data = JSON.parse(resp.data) || [];
                           //const data = dataArray[0] || {};

                           $('#gross_amount').html(formatINR(data.gross_amount));
                           $('#gst_amt').html(formatINR(data.gst_amt));
                           $('#sales').html(formatINR(data.sales));
                           $('#no_of_invoice').html(data.no_of_invoice);
                           $('#dispatch').html(data.dispatch);
                           $('#delivery').html(data.delivery);
                           $('#total_order').html(data.total_order);
                           $('#total_user').html(data.total_user);
                           //$('#paid_user').html(data.paid_user);
                       }
                   });
              }


