            function GetMonthlySalesGraph() {

                let from_date = parseDate($('#from_date').val());
                let to_date = parseDate($('#to_date').val());

                let url = `/secure/get-sales-collection-graph?from_date=${from_date}&to_date=${to_date}&uid=${uid}`;

                $.get(url, function (resp) {

                    const jsonData = JSON.parse(resp.data) || [];

                    const categories = jsonData.map(x => x.month_name);
                    const sales = jsonData.map(x => x.sales);

                        Highcharts.chart('salesCollectionChart', {

                        chart: {
                            type: 'column',
                            backgroundColor: '#F8FFF8',
                            borderRadius: 15,
                            spacingTop: 25,
                            spacingBottom: 20,
                            style: {
                                fontFamily: "'Poppins','Segoe UI',sans-serif"
                            }
                        },

                        title: {
                            text: '' 
                        },

                        xAxis: {
                            categories: categories,
                            crosshair: true,

                            lineColor: '#A5D6A7',
                            tickColor: '#A5D6A7',

                            labels: {
                                style: {
                                    color: '#2E7D32',
                                    fontSize: '15px',
                                    fontWeight: '600'
                                }
                            }
                        },

                        yAxis: {

                            min: 0,

                            gridLineColor: '#DCEFD8',

                            title: {
                                text: 'Sales Amount (₹)',
                                style: {
                                    color: '#1B5E20',
                                    fontSize: '16px',
                                    fontWeight: '600'
                                }
                            },

                            labels: {

                                style: {
                                    color: '#388E3C',
                                    fontSize: '15px'
                                },

                                formatter: function () {
                                    return formatINR(this.value);
                                }

                            }
                        },

                        tooltip: {

                            shared: true,

                            backgroundColor: '#1B5E20',

                            borderColor: '#2E7D32',

                            borderRadius: 10,

                            style: {
                                color: '#FFFFFF',
                                fontSize: '15px'
                            },

                            formatter: function () {

                                let s = '<b>' + this.x + '</b><br/><br/>';

                                this.points.forEach(function (point) {

                                    s += '<span style="color:' + point.series.color + '">●</span> '
                                        + point.series.name
                                        + ' : <b>₹'
                                        + formatINR(point.y)
                                        + '</b><br/>';

                                });

                                return s;

                            }

                        },

                        legend: {

                            layout: 'horizontal',

                            align: 'center',

                            verticalAlign: 'top',

                            backgroundColor: '#FFFFFF',

                            borderColor: '#C8E6C9',

                            borderRadius: 8,

                            borderWidth: 1,

                            itemStyle: {
                                color: '#2E7D32',
                                fontWeight: '600',
                                fontSize: '15px'
                            },

                            itemHoverStyle: {
                                color: '#1B5E20'
                            }

                        },

                        credits: {
                            enabled: false
                        },

                        exporting: {

                            buttons: {

                                contextButton: {

                                    symbolStroke: '#2E7D32',

                                    theme: {

                                        fill: '#E8F5E9',

                                        states: {

                                            hover: {

                                                fill: '#C8E6C9'

                                            }

                                        }

                                    }

                                }

                            }

                        },

                        plotOptions: {

                            series: {

                                animation: {
                                    duration: 1200
                                },

                                borderRadius: 8

                            },

                            column: {

                                pointPadding: 0.18,

                                borderWidth: 0,

                                colorByPoint: false,

                                dataLabels: {

                                    enabled: true,

                                    inside: false,

                                    style: {

                                        color: '#1B5E20',

                                        fontSize: '13px',

                                        fontWeight: '600',

                                        textOutline: 'none'

                                    },

                                    formatter: function () {

                                        return '₹' + formatINR(this.y);

                                    }

                                }

                            }

                        },

                        series: [

                            {
                                name: 'Sales',
                                data: sales,
                                color: '#43A047'
                            }

                        ]

                    });

                });

            }



