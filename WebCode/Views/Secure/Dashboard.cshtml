@{
    ViewData["Title"] = "SalesDashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Performance Dashboard
    </h4>
</section>
<div class="clearfix"></div>
<br />



<div class="content">
    <div class="row">
        <div class="col-sm-2">
            <input type="text" id="from_date" class="form-control" placeholder="From Date" />
        </div>
        <div class="col-sm-2">
            <input type="text" id="to_date" class="form-control" placeholder="To Date" />
        </div>
        <div class="col-sm-2">
            <button id="btnSearch" class="btn btn-primary"> <i class="fa fa-search"></i> Search  </button>
        </div>
    </div>
    <hr />
    <div class="clearfix"></div>


    <section class="container-fluid my-4">

        <div class="row g-3">

            <!-- 1. Gross Amount -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Gross Amount</h6>
                            <h3 class="fw-bold">₹ <span id="gross_amount">0</span></h3>
                        </div>
                        <div class="icon-box bg-dark-subtle text-dark">
                            <i class="fa fa-coins"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. GST Amount -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">GST Amount</h6>
                            <h3 class="fw-bold">₹ <span id="gst_amt">0</span></h3>
                        </div>
                        <div class="icon-box bg-danger-subtle text-danger">
                            <i class="fa fa-percent"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Total Sales -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Total Sales</h6>
                            <h3 class="fw-bold">₹ <span id="sales">0</span></h3>
                        </div>
                        <div class="icon-box bg-success-subtle text-success">
                            <i class="fa fa-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Invoices -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Invoices</h6>
                            <h3 class="fw-bold"><span id="no_of_invoice">0</span></h3>
                        </div>
                        <div class="icon-box bg-primary-subtle text-primary">
                            <i class="fa fa-file-invoice"></i>
                        </div>
                    </div>
                </div>
            </div>


            <!-- 5. Dispatch -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Dispatched</h6>
                            <h3 class="fw-bold"><span id="dispatch">0</span></h3>
                        </div>
                        <div class="icon-box bg-warning-subtle text-warning">
                            <i class="fa fa-truck"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Delivery -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Delivered</h6>
                            <h3 class="fw-bold"><span id="delivery">0</span></h3>
                        </div>
                        <div class="icon-box bg-success-subtle text-success">
                            <i class="fa fa-box-open"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 7. Total Orders -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Total Orders</h6>
                            <h3 class="fw-bold"><span id="total_order">0</span></h3>
                        </div>
                        <div class="icon-box bg-info-subtle text-info">
                            <i class="fa fa-cart-shopping"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 8. Users (Paid / Unpaid) -->
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div>
                            <h6 class="text-muted">Total Users</h6>
                            <h3 class="fw-bold"><span id="total_user">0</span></h3>
                        </div>
                        <div class="icon-box bg-info-subtle text-info">
                            <i class="fa fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>


            <!-- 8. Users (Paid / Unpaid) -->
            @* <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card kpi-card h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="text-muted mb-0">Users Status</h6>
                            <div class="icon-box-sm bg-info-subtle text-info">
                                <i class="fa fa-users"></i>
                            </div>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-6 border-end">
                                <h4 class="fw-bold text-success mb-0">
                                    <span id="paid_user">0</span>
