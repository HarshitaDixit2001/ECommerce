@{
    ViewData["Title"] = "Product Report Management";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Product List
    </h4>
    <a asp-action="product-add" asp-controller="secure" class="btn btn-sm btn-outline-success">
        <i class="fa fa-plus" aria-hidden="true"></i> Add Product
    </a>
</section>
  
<!-- Main Content -->
<section class="content">
    <div class="row"> 
        <div class="col-md-3">
            <select id="cat_id" name="cat_id" class="form-control"></select>
        </div> 
        <div class="col-md-3">
            <input type="submit" ID="btnSearch" class="btn btn-info" value="Search" />
        </div>
    </div>
    
    <div class="table-responsive mb-4">
        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"></table>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@

<script>
    // Initialize Select2 dropdown with a placeholder and allow clearing the selection
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });

    let token = "";
    const DOWNLOAD_FILE_NAME="Product_";
    let URL_LIST = `/common/master-reports`;
    let URL_DROPDOWN_LIST = `/common/get-master-dropdown`;
    let mst_key="GET_PRODUCT_LIST";

    $(function () {
    @if (TempData["Success"] != null)
    {
       <text> showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]'); </text>
    }
     
        BindTableData();
        CategorySelect();

         $('#btnSearch').on('click', function () {   BindTableData(); });

    });


     function BindTableData() {
         showLoader();
         let cat_id= $('#cat_id').val();
         $.ajax({
             url: URL_LIST + `?mst_key=${mst_key}&sub_id=${cat_id}`,
             type: 'GET',
             headers: { 'Authorization': 'Bearer ' + token },
             success: function (response) {
                  hideLoader();
                 if (response.token_valid === false) {
                     window.location.href = `@Const.LOGOUT`;
                     return;
                 }
                 else if (response.success === true && response.token_valid === true) {
 

                     const data = JSON.parse(response.data) || [];
                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                             scrollY: "500px",
                             scrollX: true,
                             scrollCollapse: true,
                             destroy: true,
                             responsive: true,
                             autoWidth: false,
                             language: { emptyTable: "No records found" },
                             "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                             "pageLength": 15,
                             buttons: [
                                 { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                { extend: 'copyHtml5', text: 'Copy'},
                                'fullscreenToggle',
                                'colvis',
                             ],
                             data: data,
                             columns: [
                             {
                                data: 'pid', title: '<i class="fa fa-pencil" aria-hidden="true" title="Edit"></i>', orderable: false,
                                render: function (id) { return `<a href="/secure/product-add/${id}" class="text-primary"> <i class="fa fa-pencil" aria-hidden="true" title="Edit"></i> </a>`; }
                             },
                             { data: 'cat_name', title: 'Cat. Name' },
                             { data: 'prod_code', title: 'SKU' },
                             { data: 'prod_name', title: 'Name' },
                             {
                                 data: 'status', title: 'STA', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             },
                            

                             { data: 'pur_price', title: 'Pur.<br> Rate' },
                             { data: 'mrp', title: 'MRP' },
                             { data: 'asso_price', title: 'Sales <br>Rate' },
                             { data: 'gst', title: 'GST <br>(%)' },
                             // { data: 'before_gst', title: 'Before Gst' },
                             // { data: 'scheme_1', title: '20%' },
                             // { data: 'scheme_2', title: '10%' },
                             // { data: 'case_size', title: 'Case <br>Size' },
                             { data: 'weight', title: 'Weight <br>(gm)' },
                             { data: 'batch_no', title: 'Batch No.' },
                             { data: 'hsncode', title: 'HSNCode' },
                             { data: 'prod_desc', title: 'Tag line' },
                              {
                                 data: 'is_arv', title: 'New <br>Arrivals', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             },
                             {
                                 data: 'is_trending', title: 'Trending', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             },
                             {
                                 data: 'is_best_selling', title: 'Best <br>Selling', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             },
                             {
                                data: "pid",
                                title: "Ingredient",
                                orderable: false,
                                searchable: false,
                                className: "text-center",
                                render: function (data) { 
                                    return `<a href="/secure/ingredient/${data}" class="btn btn-success btn-sm">
                                            <i class="fa fa-plus"></i> Add </a>`;
                                }
                             } 
                         ],
                         "footerCallback": function (row, data, start, end, display) {
                             const api = this.api();
                         }
                     });
                 }
             },
             error: function (xhr, status, error) {
                 showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
             }
         });
     }


    function CategorySelect(selectedValue = 0) {
        const $d = $('#cat_id').empty().append('<option value="0">Loading...</option>');
        $.get(`${URL_DROPDOWN_LIST}?id=0&mst_key=GET_CATEGORY_LIST`)
            .done(res => {
                $d.empty().append(`<option value="0">@Const.DROPDOWN_DEFAULT</option>`);
                res.data.forEach(i => $d.append(`<option value="${i.value}" ${i.value == selectedValue ? 'selected' : ''}>${i.text}</option>`));
            })
            .fail(() => $d.empty().append(`<option value="0" selected>@Const.DROPDOWN_DEFAULT</option>`));
    }
</script>

