<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@* <script src="~/js/jquery-3.7.1.min.js"></script> *@
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@

<script>
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    let token = "";
    const DOWNLOAD_FILE_NAME="Category_";
    const URL_ADD = `/common/add-category`;
    let URL_LIST = `/common/master-reports`;
    let mst_key="GET_CATEGORY_LIST";

    $(function () { 

        BindTableData();

        $('#cat_icon').on('change', function () {
            let icon = $(this).val();
            if (icon === '') {
                icon = 'bi-question-circle';
            }
            $('#iconPreview').html(`
                <i class="bi ${icon}" style="font-size:30px;color:#198754;"></i>
            `);
        });

    });


     function BindTableData() {
         showLoader();
         $.ajax({
             url: URL_LIST + `?mst_key=${mst_key}`,
             type: 'GET', 
             success: function (response) {
                  hideLoader();
                 if (response.token_valid === false) {
                     window.location.href = `@Const.LOGOUT`;
                     return;
                 }
                 else if (response.success === true && response.token_valid === true) {
                     const data = JSON.parse(response.data) || [];
                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                             scrollY: "500px",
                             scrollX: true,
                             scrollCollapse: true,
                             destroy: true,
                             responsive: true,
                             autoWidth: false,
                             language: { emptyTable: "No records found" },
                             "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                             "pageLength": 15,
                             buttons: [
                                 { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                 { extend: 'copyHtml5', text: 'Copy'},
                                 'fullscreenToggle',
                                 'colvis',
                             ],
                             data: data,
                             columns: [
                             {
                                 data: 'cat_id', title: 'Edit', orderable: false,
                                 render: function (id) { return `<i class="fa fa-pencil text-primary" aria-hidden="true" onclick="Get_Detail_By_Id(${id})" style="cursor:pointer; padding:2px; margin:2px;"></i> `; }
                             },
                             { data: 'cat_name', title: 'Name' },
                             { data: 'cat_desc', title: 'Description' },
                             {
                                data: 'cat_icon',
                                title: 'Icon',
                                className: 'text-center',
                                render: function (icon) {
                                    if (!icon) { icon = "bi-question-circle"; }
                                    return `
                                        <div class="d-flex justify-content-center">
                                            <div style="width:42px; height:42px; border-radius:50%;
                                                background:#edf7ef; display:flex; align-items:center; justify-content:center;">
                                                <i class="bi ${icon}" style="font-size:20px;color:#198754;"></i>
                                            </div>
                                        </div>`;
                                }
                            },
                             {
                                 data: 'status', title: 'Status', orderable: false,
                                 render: function (data) {
                                      return data
                                     ? '<i class="fa fa-circle text-success" aria-hidden="true" title="Active"></i> <div style="text-align:center; display:none;">' + data + '</div>'
                                     : '<i class="fa fa-circle text-danger" aria-hidden="true" title="Inactive"></i> <div style="text-align:center; display:none;">' + data + '</div>';
                                 }
                             }
                         ], 
                     });
                 }
             },
             error: function (xhr, status, error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }



    function Get_Detail_By_Id(id) {
        var mst_key_detail = true;
        showLoader();
        $.ajax({
            url: URL_LIST + `?id=${id}&mst_key=${mst_key}&mst_key_detail=${mst_key_detail}`,
            method: 'GET',
            contentType: 'application/json',  
            success: function (response) {
                hideLoader();
                 if (response.success === true && response.token_valid === true) {
                     const dataArray = JSON.parse(response.data) || [];
                     const data = dataArray[0] || {};
                    $('#cat_id').val(data.cat_id);
                    $('#cat_name').val(data.cat_name);
                    $('#cat_desc').val(data.cat_desc);
                    $('#status').prop('checked', data.status);
                    $('#saveBtn').text('Update');
                    $('#cat_icon').val(data.cat_icon).trigger("change");
                 } else {
                    showErrorLog(`@Const.ERROR_HEADER`, response.message);
                 }
            },
            error: function (res_error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    }


    $('#SubmitForm').submit(function (e) {
        e.preventDefault();
        if($('#cat_name').val().trim() === '') {
             showErrorLog(`@Const.ERROR_HEADER`, "Category is required.");  return;
          }
        const formData = new FormData(this);
        formData.set("status", $('#status').is(':checked'));
        showLoader();
        $.ajax({
            url: URL_ADD,
            type: 'POST',
            data: formData,
            processData: false,       
            contentType: false,        
            success: function (response) {
                debugger;

                hideLoader();
                if(response.success == true){
                     showToastSuccess('Data save successfully');
                    $('#SubmitForm')[0].reset();
                    $('#saveBtn').text('Add');
                    $('#cat_id').val(0);
                    
                    $('#cat_icon').val("").trigger("change");
                    $('#iconPreview').html(`
                        <i class="bi bi-question-circle" style="font-size:30px;color:#198754;"></i>
                    `);


                    BindTableData();
                }else{
                     debugger;
                    showErrorLog(`@Const.ERROR_HEADER`, response.message);
                }
            },
            error: function (res_error) {
                 debugger;
               showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
            }
        });
    });
     
</script>

