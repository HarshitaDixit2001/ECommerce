<script src="~/js/jquery-3.7.1.min.js"></script>
<script>

    let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    $(function () {
         GetUserDashboard();
    });


    function GetUserDashboard() {
        let URL_LIST = `/secure/get-user-dashboard?uid=${uid}`;
        showLoader();
        $.get(URL_LIST, function (resp) {
            hideLoader();
            if (resp.success === true) {
                 const dataArray = JSON.parse(resp.data) || [];
                 const data = dataArray[0] || {};

                 $('#user_id').html(data.user_id);
                 $('#name').html(data.name);
                 //$('#doe').html(data.doe);
                  if (data.doe) {
                     const d = new Date(data.doe);
                     $('#doe').html(d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).replace(/ /g, '-'));
                 } else { $('#doe').html('-'); }

                 $('#mobile').html(data.mobile);



                 $('#t_sponsor').html(data.t_sponsor);
                 $('#t_paid_sponsor').html(data.t_paid_sponsor);

                 $('#total_left').html(formatINR(data.total_left));
                 $('#total_right').html(formatINR(data.total_right));
                 $('#new_left').html(formatINR(data.new_left));
                 $('#new_right').html(formatINR(data.new_right));
                 $('#carry_left').html(formatINR(data.carry_left));
                 $('#carry_right').html(formatINR(data.carry_right));

                 $('#pbv').html(formatINR(data.pbv));
                 $('#gbv').html(formatINR(data.gbv));
                 $('#prev_pbv').html(formatINR(data.prev_pbv));
                 $('#prev_gbv').html(formatINR(data.prev_gbv));

                 $('#company_wallet').html(formatINR(data.company_wallet));
                 $('#payout_wallet').html(formatINR(data.payout_wallet));





                  // BANK KYC
                  $('#BankkycStatus')
                      .removeClass('bg-success-subtle text-success bg-warning-subtle text-warning')
                      .addClass(data.bank_status === '1' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning')
                      .text(data.bank_status === '1' ? 'Verified' : 'Pending');


                  // PAN KYC
                  $('#PankycStatus')
                      .removeClass('bg-success-subtle text-success bg-warning-subtle text-warning')
                      .addClass(data.pan_status === '1' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning')
                      .text(data.pan_status === '1' ? 'Verified' : 'Pending');


                  // AADHAAR KYC
                  $('#AadhaarkycStatus')
                      .removeClass('bg-success-subtle text-success bg-warning-subtle text-warning')
                      .addClass(data.aadhar_status === '1' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning')
                      .text(data.aadhar_status === '1' ? 'Verified' : 'Pending');


                  // Bank
                 $('#bank_img').attr('src', data.bank_img && data.bank_img !== '' ? '/'+data.bank_img : '@Const.NO_IMAGE');
                 // PAN
                 $('#pan_img').attr('src', data.pan_img && data.pan_img !== '' ? '/'+data.pan_img : '@Const.NO_IMAGE');
                 // Aadhaar
                 $('#aadhar_img_1').attr('src', data.aadhar_img_1 && data.aadhar_img_1 !== '' ? '/'+data.aadhar_img_1 : '@Const.NO_IMAGE');
                 $('#aadhar_img_2').attr('src', data.aadhar_img_2 && data.aadhar_img_2 !== '' ? '/'+data.aadhar_img_2 : '@Const.NO_IMAGE');

                 $('#pf_img').attr('src', data.pf_img && data.pf_img !== '' ? '/'+data.pf_img : '@Const.NO_IMAGE');

            }
         });
    }

