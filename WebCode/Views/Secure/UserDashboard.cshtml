@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
<style>
    .dashboard-overview {
        border: 0;
        border-radius: 15px;
    }

    .user-avatar {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #f1f1f1;
        cursor: pointer;
    }

    .stat-box {
        min-width: 90px;
        text-align: center;
        border-left: 1px solid #eee;
        padding: 0 10px;
    }

    .stat-value {
        font-size: 20px;
        font-weight: 700;
        line-height: 1;
    }

    .stat-label {
        font-size: 12px;
        color: #6c757d;
    }

    .wallet-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .wallet-main {
        background: #e8f5e9;
        color: #198754;
    }

    .wallet-reward {
        background: #fff3cd;
        color: #856404;
    }

    .kyc-card {
        border-radius: 16px;
        border: none;
    }

    .kyc-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        position: relative;
        transition: all 0.3s ease-in-out;
    }

        .kyc-box:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.12);
        }

        .kyc-box h6 {
            margin: 12px 0;
            font-weight: 600;
            color: #212529;
        }

        .kyc-box img {
            max-height: 130px;
            width: auto;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e0e0e0;
        }

    /* Status Badge */
    .kyc-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 5px 12px;
        font-size: 13px;
        border-radius: 20px;
        font-weight: 600;
        text-transform: uppercase;
    }

        .kyc-badge.success {
            background-color: #e9f7ef;
            color: #198754;
        }

        .kyc-badge.pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .kyc-badge.failed {
            background-color: #f8d7da;
            color: #842029;
        }





    news-card {
        border-radius: 14px;
        border: 0;
    }

    .news-item {
        background: #ffffff;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 12px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
        position: relative;
        transition: .25s ease-in-out;
    }

        .news-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        .news-item h6 {
            margin-bottom: 4px;
            font-weight: 600;
        }

        .news-item p {
            font-size: 14px;
            color: #495057;
            margin-bottom: 6px;
        }

        .news-item small {
            color: #6c757d;
        }

    /* News Badges */
    .news-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 3px 10px;
        font-size: 11px;
        border-radius: 20px;
        font-weight: 600;
    }

        .news-badge.new {
            background: #e7f1ff;
            color: #0d6efd;
        }

        .news-badge.info {
            background: #e9f7ef;
            color: #198754;
        }

        .news-badge.alert {
            background: #fff3cd;
            color: #856404;
        }

</style>
