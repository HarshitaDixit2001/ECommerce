@{
    ViewData["Title"] = "MonthWiseProductQty";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
@* <!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i> Product Wise Qty</a></li>
    </ol>
</section> *@
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Received Purchase Order
    </h4>
    <a asp-controller="vendor" asp-action="vendor-po-list" class="btn btn-sm btn-outline-success">
        Purchase Order List
    </a>
</section>
<div class="clearfix"></div>
<br />
<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading row">
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div>

                    <div class="col-md-3 col-sm-3">
                        <select id="seller_uid" asp-items="ViewBag.SallerList" class="form-control select2">
                            <option value="0">🔍 Search User ID</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-sm-2">
                        <select id="prod_type" class="form-control select2">
                            <option value="1">Sales</option>
                            <option value="2">Scheme</option>
                            <option value="3">Samples</option>
                            <option value="0">🔍 All</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-sm-2" style="display:none;">
                        <select id="sub_role_id" class="form-control select2">
                            <option value="0">🔍 All</option>
                            <option value="2">Manager</option>
                            <option value="3">Sales Men</option>
                        </select>
                    </div>
                    <div class="col-sm-1">
                        <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                            <thead></thead>   <!-- Required: JS will populate this -->
                            <tbody></tbody>   <!-- DataTables handles this -->
                            <tfoot></tfoot>   <!-- Required for totals -->
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@
<script>

    let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const subRole = '@User.FindFirst("SubRole")?.Value';


    const URL_LIST = `/secure/get-month-wise-product-qty`;
    const DOWNLOAD_FILE_NAME = "month-wise-product-qty";

    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(today.getDate() - 180);

        $('#from_date').val(formatDate(weekAgo));
        $('#to_date').val(formatDate(today));

        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        initializeTable();
        $('#btnSearch').on('click', function () { initializeTable(); });
    });


    const parseDate = d => d ? d.split("-").reverse().join("/") : null;




    function initializeTable() {
        showLoader();
        let seller_uid = parseInt($('#seller_uid').val()) || 0;
        uid = seller_uid > 0 ? seller_uid : uid;
        $.ajax({
            url: URL_LIST,
            data: {from_date: parseDate($('#from_date').val()),
                  to_date: parseDate($('#to_date').val()),
                  sub_role_id: $('#sub_role_id').val(),
                  seller_uid: $('#seller_uid').val(),
                  prod_type: $('#prod_type').val(),
                  uid },
            type: 'GET',
            success: function (res) {
                 hideLoader();
                if (res.success && res.data.length > 0) {
                    //const fixedKeys = ['prod_code', 'prod_name'];
                    const allMonthKeys = new Set();

                    // Collect all unique month keys
                    res.data.forEach(row => {
                        const months = row.month_qty || {};
                        for (let key in months) {
                            allMonthKeys.add(key);
                        }
                    });

                    // Sort months like Apr-25, May-25...
                    const sortedMonthKeys = [...allMonthKeys].sort((a, b) => {
                        const parseMonth = m => new Date('01-' + m);
                        return parseMonth(a) - parseMonth(b);
                    });

                    // Build column definitions
                    const columns = [
                        { title: '#', data: null, render: (data, type, row, meta) => meta.row + 1, className: 'text-center',  orderable: false },
                        { title: 'P-Code', data: 'prod_code', className: 'text-start' },
                        { title: 'P-Name', data: 'prod_name', className: 'text-start' },
                        ...sortedMonthKeys.map(month => ({
                            title: month,
                            data: month,
                            render: data => data ?? 0
                        }))
                    ];

                    // Prepare the final flat data
                    const tableData = res.data.map(item => {
                        const flat = {
                            prod_code: item.prod_code,
                            prod_name: item.prod_name
                        };
                        sortedMonthKeys.forEach(month => {
                            flat[month] = item.month_qty[month] || 0;
                        });
                        return flat;
                    });

                        // Clear existing header and footer to avoid duplication
                    //$('#tblList thead').empty();
                    $('#tblList tfoot').empty();

                    // Create new header and footer HTML
                    //let theadHtml = '<tr>';
                    let tfootHtml = '<tr>';
                    columns.forEach(col => {
                        //theadHtml += `<th>${col.title}</th>`;
                        tfootHtml += `<th data-key="${col.title}"></th>`;
                    });
                   // theadHtml += '</tr>';
                    tfootHtml += '</tr>';

                    // Set the generated HTML
                    //$('#tblList thead').html(theadHtml);
                    $('#tblList tfoot').html(tfootHtml);

 
                    // Initialize DataTable
                    $('#tblList').DataTable({
                        dom: 'Blfrtip', 
                        scrollY: "500px",
                        autoWidth: true,
                        responsive: true,
                        destroy: true,
                        processing: true,
                        lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
                        pageLength: @Const.NO_OF_PAGE_RECORDS,
                        buttons: [
                            { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                            { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                            { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                            { extend: 'copyHtml5', text: 'Copy'},
                            'fullscreenToggle',
                            'colvis',
                        ],
                        data: tableData,
                        columns: columns,
                        footerCallback: function (row, data, start, end, display) {
                            const api = this.api();

                            // Calculate totals for each month column
                            api.columns().every(function () {
                                const index = this.index();
                                const title = $(this.header()).text();

                                if (!['Product Code', 'Product Name'].includes(title)) {
                                    let total = data.reduce((sum, row) => {
                                        const val = parseFloat(row[title]) || 0;
                                        return sum + val;
                                    }, 0);

                                    $(this.footer()).html(total.toLocaleString());
                                }
                            });
                        }
                    });
                } 
                else {
                    if ($.fn.DataTable.isDataTable('#tblList')) {
                        $('#tblList').DataTable().clear().draw();
                    }
                }
            }
        });
    }
</script>
 