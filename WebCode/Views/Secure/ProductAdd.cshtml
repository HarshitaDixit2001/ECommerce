<script>
    // Initialize Select2 dropdown with a placeholder and allow clearing the selection
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    let URL_DROPDOWN_LIST =  `/common/get-master-dropdown`;
    let URL_LIST = `/common/master-reports`;

    $(function () {
        @if (TempData["Error"] != null)
        {
              <text> showErrorLog(`@Const.ERROR_HEADER`, '@TempData["Error"]'); </text>
        }
    });


    function Bind_product_code(){
        var mst_key_detail = true;
        let mst_key="GET_CATEGORY_LIST";
        let id=$('#cat_id').val();
        let pid = $('#pid').val();
        if(id > 0 && pid == 0)
        { debugger;
            showLoader();
            $.ajax({
                url: URL_LIST + `?id=${id}&mst_key=${mst_key}&mst_key_detail=${mst_key_detail}`,
                method: 'GET',
                contentType: 'application/json',
                success: function (response) {

                    hideLoader();
                     if (response.success === true ) {
                         const dataArray = JSON.parse(response.data) || [];
                         const data = dataArray[0] || {};
                        $('#prod_code').val(data.prod_code);
                     }
                },
                error: function (res_error) {
                    showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); return;
                }
            });
        }
    }



</script>
<style>
    .custom-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .custom-checkbox input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid #dc3545; /* Red when unchecked */
            border-radius: 6px;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
            background-color: #dc3545; /* Red background */
        }

            .custom-checkbox input[type="checkbox"]::after {
                content: '✖';
                color: #fff;
                font-size: 12px;
                font-weight: bold;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

            .custom-checkbox input[type="checkbox"]:checked {
                background-color: #198754; /* Green when checked */
                border-color: #198754;
            }

                .custom-checkbox input[type="checkbox"]:checked::after {
                    content: '✔';
                    color: #fff;
                    font-size: 14px;
                }

        .custom-checkbox label {
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            margin-bottom: 0;
        }
</style>
 