@{
    ViewData["Title"] = "Enquiry Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Enquiry Details
    </h4>
</section>
<div class="clearfix"></div>
<br />
<!-- Main Content -->
<section class="content">
    <div class="row">


        <div class="col-sm-2">
            <select id="status" name="status" class="form-control">
                <option value="0">🔍 Select Enquiry Status</option>

                <option value="1">🟢 Interested</option>
                <option value="2">🔴 Not Interested</option>
                <option value="3">🟡 On Hold</option>
                <option value="4">🔵 Follow-Up Required</option>
                <option value="5">📞 Call Back Later</option>
                <option value="6">⚪ No Response</option>
                <option value="7">✅ Closed</option>
            </select>

        </div>
        <div class="col-sm-2">
            <input type="button" id="btnSearch" class="btn btn-info" value="Search" />
        </div>

        <div class="col-sm-12">
            <div class="table-responsive mb-4">
                <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_Sweetalert")
<script>
    const user_id = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';

    let token = "";
    const DOWNLOAD_FILE_NAME="Enquiry_";
    const URL_LIST = `/common/master-reports`;
    const mst_key="GET_ENQUIRY_LIST";
    $(function () {
        BindTableData();
    });


     function BindTableData() {
         showLoader();
         $.ajax({
             url: URL_LIST + `?mst_key=${mst_key}`,
             type: 'GET',
             headers: { 'Authorization': 'Bearer ' + token },
             success: function (response) {
                 hideLoader();
                 if (response.success === true && response.token_valid === true) {
                     const data = JSON.parse(response.data) || [];
                     $('#tblList').DataTable({
                         dom: 'Blfrtip',
                             scrollX: true,
                             scrollCollapse: true,
                             destroy: true,
                             responsive: true,
                             autoWidth: false,
                             language: { emptyTable: "No records found" },
                             "lengthMenu": [[15, 50, 100, -1], [15, 50, 100, "All"]],
                             "pageLength": 15,
                             buttons: [
                                 { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_') },
                                 { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                                 { extend: 'copyHtml5', text: 'Copy'},
                             ],
                             data: data,
                             columns: [
                             // {
                             //     data: 'enq_id', title: 'Edit', orderable: false,
                             //     render: function (id) { return `<i class="fa fa-pencil text-primary" aria-hidden="true" onclick="Get_Detail_By_Id(${id})" style="cursor:pointer; padding:2px; margin:2px;"></i> `; }
                             // },
                            {
                                data: 'enq_id',
                                title: 'Reply',
                                orderable: false,
                                render: function (id) {
                                    return `<button class="btn btn-sm btn-primary" onclick="openReplyModal(${id})"> <i class="fa fa-reply"></i> Reply </button>`;
                                }
                            },
                            {
                                data: 'status',
                                title: 'Status',
                                orderable: false,
                                render: function (data) {
                                    switch (parseInt(data)) {
                                       case 0: return '🟡 <span class="text-warning fw-semibold">Pending</span>';
                                        case 1: return '🟢 <span class="text-success fw-semibold">Interested</span>';
                                        case 2:  return '🔴 <span class="text-danger fw-semibold">Not Interested</span>';
                                        case 3: return '🟡 <span class="text-warning fw-semibold">On Hold</span>';
                                        case 4: return '🔵 <span class="text-primary fw-semibold">Follow-Up Required</span>';
                                        case 5: return '📞 <span class="text-info fw-semibold">Call Back Later</span>';
                                        case 6: return '⚪ <span class="text-muted fw-semibold">No Response</span>';
                                        case 7: return '✅ <span class="text-success fw-semibold">Closed</span>';
                                        default: return '<span class="text-secondary">Unknown</span>';
                                    }
                                }
                            },
                             { data: 'name',              title: 'Customer Name' },
                             { data: 'mobile',            title: 'Mobile Number' },
                             { data: 'email_id',          title: 'Email Address' },
                             { data: 'state',             title: 'State' },
                             { data: 'city',              title: 'City' },
                             { data: 'address',           title: 'Address' },
                             { data: 'subject',           title: 'Subject' },
                             // { data: 'msg',               title: 'Message' },
                             // { data: 'remarks',           title: 'Response Message' },
                             {
                                data: 'msg',
                                title: 'Message',
                                render: function (data, type, row) {
                                    if (!data) return '';
                                    const maxLength = 70;
                                    if (data.length <= maxLength) return data;
                                    const shortText = data.substr(0, maxLength) + '...';
                                    const fullText = data;
                                    // unique ID per row
                                    const id = 'msg_' + row.enq_id;
                                    return `
                                        <span id="${id}_short">${shortText}</span>
                                        <span id="${id}_full" style="display:none;">${fullText}</span>
                                        <a href="javascript:void(0);" onclick="toggleReadMore('${id}')" class="text-primary">Read More</a>
                                    `;
                                }
                            },
                            {
                                data: 'remarks',
                                title: 'Response Message',
                                render: function (data, type, row) {
                                    if (!data) return '';
                                    const maxLength = 70;
                                    if (data.length <= maxLength) return data;
                                    const shortText = data.substr(0, maxLength) + '...';
                                    const fullText = data;
                                    const id = 'remarks_' + row.enq_id;
                                    return `
                                        <span id="${id}_short">${shortText}</span>
                                        <span id="${id}_full" style="display:none;">${fullText}</span>
                                        <a href="javascript:void(0);" onclick="toggleReadMore('${id}')" class="text-primary">Read More</a>
                                    `;
                                }
                             },

                             { data: 'visit_date', title: 'Visit Date', render: d => d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                             { data: 'doe', title: 'Enquiry Date', render: d => d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                             { data: 'enquiry_from',      title: 'Enquiry Source' },
                             { data: 'response_user_id',  title: 'Responded By' },
                             { data: 'response_date', title: 'Response Date', render: d => d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : '' },
                         ],
                     });
                 }
             },
             error: function (xhr, status, error) {
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
             }
         });
     }




    function openReplyModal(enqId) {

        var table = $('#tblList').DataTable();
        var rowData = table.rows().data().toArray().find(x => x.enq_id == enqId);

        if (!rowData) return;

        $('#enq_id').val(rowData.enq_id);
        $('#m_name').val(rowData.name);
        $('#m_mobile').val(rowData.mobile);
        $('#m_subject').val(rowData.subject);
        $('#m_msg').val(rowData.msg);
        $('#m_enquiry_from').val(rowData.enquiry_from);
        $('#m_status').val(rowData.status ?? 0);
        $('#m_reply_message').html(rowData.remarks ?? '');

        var modal = new bootstrap.Modal(document.getElementById('replyModal'));
        modal.show();
    }


    $(document).on('submit', '#SubmitForm', function (e) {
        e.preventDefault();

        if ($('#m_status').val() == '0') {
            showErrorLog('Error', 'Please select enquiry status.');
            return;
        }

        const formData = new FormData(this);
        formData.set("enq_id", $('#enq_id').val());
        formData.set("status", $('#m_status').val());
        formData.set("remarks", $('#m_remarks').val());
        formData.set("response_user_id", user_id);

        showLoader();
        $.ajax({
            url: '/print/appointment-save',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                hideLoader();
                if(response.success){
                    showToastSuccess("Reply saved successfully.");
                    $('#SubmitForm')[0].reset();
                    $('#enq_id').val(0);
                    bootstrap.Modal.getInstance(document.getElementById('replyModal')).hide();
                    BindTableData(); // Refresh DataTable if needed
                } else {
                    showErrorLog('Error', response.message);
                }
            },
            error: function () {
                hideLoader();
                showErrorLog('Error', 'Unexpected error occurred.');
            }
        });
    });
</script>




<div class="modal fade" id="replyModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="SubmitForm">
                <div class="modal-header">
                    <h5 class="modal-title">Enquiry Reply</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="enq_id" name="enq_id">
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="fw-semibold">Customer Name</label>
                            <input type="text" id="m_name" class="form-control" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-semibold">Mobile Number</label>
                            <input type="text" id="m_mobile" class="form-control" readonly>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="fw-semibold">Subject</label>
                            <input type="text" id="m_subject" class="form-control" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-semibold">Enquiry Source</label>
                            <input type="text" id="m_enquiry_from" class="form-control" readonly>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="fw-semibold">Message</label>
                        <textarea id="m_msg" rows="3" class="form-control" readonly></textarea>
                    </div>


                    <div class="mb-2">
                        <h6 class="fw-semibold text-primary">Replied Message</h6>
                        <div id="m_reply_message"></div>
                    </div>



                    <div class="mb-2">
                        <label class="fw-semibold">Reply Status</label>
                        <select id="m_status" name="m_status" class="form-control">
                            <option value="0">🔍 Select Enquiry Status</option>
                            <option value="1">🟢 Interested</option>
                            <option value="2">🔴 Not Interested</option>
                            <option value="3">🟡 On Hold</option>
                            <option value="4">🔵 Follow-Up Required</option>
                            <option value="5">📞 Call Back Later</option>
                            <option value="6">⚪ No Response</option>
                            <option value="7">✅ Closed</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="fw-semibold">Response Message</label>
                        <textarea id="m_remarks" name="m_remarks" rows="3" class="form-control" placeholder="Enter response message"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" data-bs-dismiss="modal"> Close </button>
                    <button type="submit" class="btn btn-success">Save Reply</button>
                </div>
            </form>
        </div>
    </div>
</div>

