@{
    ViewData["Title"] = "Sales & Collection Report";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
<!-- Breadcrumb -->
@* <section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i> Sales & Collection Report</a></li>
    </ol>
</section> *@
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>ales & Collection Report
    </h4> 
</section>
<div class="clearfix"></div>
<br />


<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading row">
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div>

                    <div class="col-md-3 col-sm-3">
                        <select id="seller_uid" asp-items="ViewBag.SallerList" class="form-control select2">
                            <option value="0">🔍 Search User ID</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-sm-2" style="display:none;">
                        <select id="prod_type" class="form-control select2">
                            <option value="1">Sales</option>
                            <option value="3">Samples</option>
                            <option value="0">🔍 All</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-sm-2" style="display:none;">
                        <select id="sub_role_id" class="form-control select2">
                            <option value="0">🔍 All</option>
                            <option value="2">Manager</option>
                            <option value="3">Sales Men</option>
                        </select>
                    </div>
                    <div class="col-sm-1">
                        <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                            <thead></thead>   <!-- Required: JS will populate this -->
                            <tbody></tbody>   <!-- DataTables handles this -->
                            <tfoot></tfoot>   <!-- Required for totals -->
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@

<script>

    let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const subRole = '@User.FindFirst("SubRole")?.Value';


    const URL_LIST = `/secure/get-sales-collection`;
    const DOWNLOAD_FILE_NAME = "SalesCollectionReport";

    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(today.getDate() - 180);

        $('#from_date').val(formatDate(weekAgo));
        $('#to_date').val(formatDate(today));

        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        initializeTable();
        $('#btnSearch').on('click', function () { initializeTable(); });
    });


    const parseDate = d => d ? d.split("-").reverse().join("/") : null;


    function initializeTable() {
        showLoader();
        $.get(URL_LIST, {
            from_date: parseDate($('#from_date').val()),
            to_date: parseDate($('#to_date').val()),
            sub_role_id: $('#sub_role_id').val(),
            mode_id: $('#prod_type').val(),
            uid: +($('#seller_uid').val()) || uid
        }, res => {

            hideLoader();
            debugger;

            // if (!(res.success && res.data.length)) return $('#tblList').DataTable().clear().draw();
            const table = $('#tblList').DataTable();
            table.clear().draw(); // Clear before redrawing

            // If no valid data, stop and clear
            if (!(res.success && res.data.length)) {
                $('#tblList tfoot').html('');
                return;
            }


            const months = new Set();
            res.data.forEach(r => Object.keys(r.month_qty || {}).forEach(k => months.add(k)));

            const grouped = {};
            [...months].forEach(k => {
                const [m, y, type] = k.split(/[-_]/); // e.g. Apr-25-Sal
                const base = `${m}-${y}`;
                grouped[base] = grouped[base] || {};
                grouped[base][type] = k;
            });

            const sortedMonths = Object.keys(grouped).sort((a, b) => new Date('01-' + a) - new Date('01-' + b));
            const dynamicCols = sortedMonths.flatMap(month => [
                grouped[month]['Sal'],
                grouped[month]['Coll']
            ]).filter(Boolean);

            const columns = [
                { title: '#', data: null, render: (_, __, ___, meta) => meta.row + 1, className: 'text-center' },
                { title: 'Name', data: 'name', className: 'text-start' },
                ...dynamicCols.map(col => ({
                    title: col,
                    data: col,
                    render: d => (+d || 0).toLocaleString(undefined, { minimumFractionDigits: 0 }),
                    className: 'text-end'
                })),
                {
                    title: 'Total-Sal', data: 'Total-Sal',
                    render: d => (+d || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }),
                    className: 'text-end'
                },
                {
                    title: 'Total-Coll', data: 'Total-Coll',
                    render: d => (+d || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }),
                    className: 'text-end'
                }
            ];

            const rows = res.data.map(r => {
                const flat = { name: r.name, 'Total-Sal': 0, 'Total-Coll': 0 };
                dynamicCols.forEach(k => flat[k] = r.month_qty?.[k] || 0);
                flat['Total-Sal'] = r.month_qty?.['Total-Sal'] || 0;
                flat['Total-Coll'] = r.month_qty?.['Total-Coll'] || 0;
                return flat;
            });

            $('#tblList tfoot').html('<tr>' + columns.map(c =>
                `<th>${['#', 'Name'].includes(c.title) ? '' : '0.00'}</th>`
            ).join('') + '</tr>');

            $('#tblList').DataTable({
                 dom: 'Blfrtip',
                 scrollY: "500px",
                destroy: true,
                autoWidth: true,
                responsive: true,
                processing: true,
                lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
                pageLength: @Const.NO_OF_PAGE_RECORDS,
                data: rows,
                columns: columns,
                buttons: ['excel', 'csv',
                    { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                        { extend: 'copyHtml5', text: 'Copy'},
                        'fullscreenToggle',
                        'colvis',
                    ],
                footerCallback: function () {
                    const api = this.api();
                    api.columns().every(function () {
                        const title = $(this.header()).text();
                        if (['#', 'Name'].includes(title)) return;
                        const total = api.rows({ search: 'applied' }).data()
                            .reduce((sum, row) => sum + (+row[title] || 0), 0);
                        $(this.footer()).html(total.toLocaleString(undefined, { minimumFractionDigits: 2 }));
                    });
                }
            });
        });
    }
     
</script>
 