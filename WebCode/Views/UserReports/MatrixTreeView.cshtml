@{
    ViewData["Title"] = "Matrix Tree View";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>User Tree View
    </h4>
    <a onclick="GetUserUID()" class="btn btn-sm btn-outline-success">
        <i class="fa-solid fa-user-check me-1"></i> Go Own Status
    </a>
</section>
 
<section class="content">
    <div class="row">
        <div class="col-sm-12">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-success mb-0">
                    <i class="fa-solid fa-sitemap me-2"></i> User Tree View
                </h4>
            </div>

            <div id="userTree"></div>

        </div>
    </div>
</section>

<!-- Dependencies -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/themes/default/style.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/jstree.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(function () {
        GetUserUID();
    });

    function GetUserUID() {
        let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
        GetUserData(uid);
    }

    function GetUserData(uid) {
        showLoader();

        $.ajax({
            url: '/user-report/get-matrix-tree-view',
            type: 'GET',
            data: { uid: uid, from_date: null, to_date: null },
            success: function (res) {
                hideLoader();

                if (!res || !res.data) return alert('No data found');

                let jsonResult;
                try {
                    jsonResult = JSON.parse(res.data);
                } catch (err) {
                    console.error("Invalid JSON returned:", err);
                    return;
                }

                let treeData = [];
                if (jsonResult.length && jsonResult[0].json_result) {
                    treeData = JSON.parse(jsonResult[0].json_result);
                } else {
                    treeData = jsonResult;
                }

                const normalize = nodes =>
                    nodes.map(node => ({
                        id: node.id?.toString() || "",
                        text: formatNodeText(node),
                        data: typeof node.data === "string" ? JSON.parse(node.data) : node.data,
                        children: Array.isArray(node.children) ? normalize(node.children) : []
                    }));

                const jsTreeData = normalize(treeData);

                if ($.jstree.reference('#userTree')) $('#userTree').jstree('destroy').empty();

                $('#userTree')
                    .jstree({
                        core: {
                            data: jsTreeData,
                            themes: { dots: true, icons: false },
                            animation: 300 // Smooth expand/collapse
                        },
                        plugins: ['wholerow']
                    })
                    .on('ready.jstree', function () {
                        const tree = $('#userTree').jstree(true);
                        if (jsTreeData.length > 0) tree.open_node(jsTreeData[0].id);
                        initTooltips();
                    });

                $(document).off('click', '.name, .user_id').on('click', '.name, .user_id', function (e) {
                    e.stopPropagation();
                    const li = $(this).closest('li');
                    const tree = $('#userTree').jstree(true);
                    const node = tree.get_node(li.attr('id'));
                    if (node && node.data && node.data.user_id) {
                        GetUserData(node.id);
                    }
                });

                function formatNodeText(node) {
                    const d = node.data ? (typeof node.data === "string" ? JSON.parse(node.data) : node.data) : {};
                    const imgSrc = d.pf_img ? "/" + d.pf_img : "/NoImage.jpg";

                    return `
                        <div class="user-node">
                            <div class="user-photo-container">
                                <img src="${imgSrc}" alt="${d.name || 'User'}" class="user-photo img-thumbnail" style="height: 50px; width:50px;">
                            </div>

                            <div class="user-info">
                                <strong class="name">${d.name || node.text || 'Unnamed User'}</strong><br>
                                <small>
                                    <span class="user_id">ID: ${d.user_id || '—'}</span> |
                                    <span class="user-role">${d.role_name || ''}</span>
                                </small>
                            </div>
                        </div>
                    `;
                }

                function initTooltips() {
                    $('[data-bs-toggle="tooltip"]').tooltip('dispose');
                    $('#userTree .jstree-anchor').each(function () {
                        const nodeId = $(this).closest('li').attr('id');
                        const tree = $('#userTree').jstree(true);
                        const node = tree.get_node(nodeId);
                        if (!node || !node.data) return;

                        const d = node.data;
                        const tooltipHtml = `
                            <div><strong>User ID:</strong> ${d.user_id || ''}</div>
                            <div><strong>Name:</strong> ${d.name || ''}</div>
                            <div><strong>Role:</strong> ${d.role_name || ''}</div>
                            <div><strong>Collection:</strong> ₹${d.collection_amt}</div>
                            <div><strong>Sales:</strong> ₹${d.sales_amt}</div>
                        `;

                        $(this)
                            .attr('data-bs-toggle', 'tooltip')
                            .attr('data-bs-html', 'true')
                            .attr('data-bs-placement', 'right')
                            .attr('title', tooltipHtml);
                    });

                    const tooltipList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipList.map(el => new bootstrap.Tooltip(el));
                }
            },
            error: function () {
                hideLoader();
                alert('Error while fetching tree data.');
            }
        });
    }

  

    function showLoader() {
        $('#userTree').html('<div class="text-center py-5 text-secondary"><i class="fa fa-spinner fa-spin me-2"></i>Loading tree...</div>');
    }
    function hideLoader() { }
</script>

<style>
    
    /* User Node */
    .user-node {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 54px;
    }

    .user-photo-container {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #28a745;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        box-shadow: 0 0 5px rgba(0,0,0,0.15);
    }

    .user-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .user-info strong {
        font-size: 15px;
        font-weight: 600;
        color: #000;
    }

    .user-info small {
        font-size: 13px;
        color: #333;
    }

    .name, .user_id {
        cursor: pointer;
        font-weight: 700;
        color: #000;
    }

        .name:hover, .user_id:hover {
            color: #198754;
            text-decoration: underline;
        }

    /* JSTree Anchor */
    .jstree-anchor {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all 0.25s;
    }

        .jstree-anchor:hover {
            border-left: 3px solid #198754;
        }

    .jstree-clicked {
        border-left: 3px solid #198754;
    }

    /* Tree lines */
    #userTree ul {
        margin-left: 25px;
        padding-left: 20px;
        border-left: 2px dashed #a9dfbf;
    }

    #userTree li {
        position: relative;
        padding: 10px 0;
    }

        #userTree li::before {
            content: "";
            position: absolute;
            top: 22px;
            left: -20px;
            width: 20px;
            height: 0;
            border-top: 2px dashed #a9dfbf;
        }

    #userTree > ul {
        border-left: none;
    }

        #userTree > ul > li::before {
            border: none;
        }

    /* Plus and Minus icons */
    .jstree-icon.jstree-ocl {
        width: 18px;
        height: 18px;
        line-height: 18px;
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        color: #198754;
        cursor: pointer;
        margin-right: 6px;
        background: none;
        border: none;
    }

    .jstree-open > .jstree-ocl::before {
        content: "−";
    }

    .jstree-closed > .jstree-ocl::before {
        content: "+";
    }

    /* Tooltip */
    .tooltip-inner {
        max-width: 280px;
        font-size: 13px;
        text-align: left;
        padding: 8px;
        color: #fff;
        border-radius: 6px;
    }

    /* Hover effect on user photo */
    .user-node:hover .user-photo-container {
        box-shadow: 0 0 8px #81c784;
        transform: scale(1.05);
        transition: all 0.25s ease-in-out;
    }
</style>

