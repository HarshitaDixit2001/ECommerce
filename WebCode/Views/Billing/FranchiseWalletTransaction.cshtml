@{
    ViewData["Title"] = "Franchise Wallet Transaction";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

}
 
<!-- Breadcrumb -->
@* <section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i> Wallet Passbook</a></li>
    </ol>
</section> *@
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Wallet Passbook
    </h4> 
</section>
<div class="clearfix"></div>
<br />

<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading row">
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div>
                    <div class="col-sm-3">
                        <select id="mode_id" class="form-control select2">
                            <option value="0">All</option>
                            <option value="4">Generate Invoice</option>
                            <option value="12">Payment Received</option>
                            <option value="15">Commission Received</option>
                            <option value="17">Credit Note</option>
                            <option value="5">Cancelled Invoice</option>
                            <option value="16">Commission Cancelled</option>
                        </select>
                    </div>

                    <div class="col-sm-2">
                        <select id="d_c" class="form-control select2">
                            <option value="">All</option>
                            <option value="C" style="color: green;">Credit</option>
                            <option value="D" style="color: red;">Debit</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="user_id" class="form-control" placeholder="User ID" />
                    </div>
                    <div class="col-sm-1">
                        <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                    </div>
                </div>

                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total:</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@

<script>

    let table;
    let token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
    const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const URL_LIST = `/billing/get-wallet-transaction`;
    const DOWNLOAD_FILE_NAME = "wallet_passbook";
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });

    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(today.getDate() - 30);

        $('#from_date').val(formatDate(weekAgo));
        $('#to_date').val(formatDate(today));

        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        initializeTable();

        $('#btnSearch').on('click', function () {  table.ajax.reload(); });
    });





    function initializeTable() {
        table = $('#tblList').DataTable({
            dom: 'Blfrtip',
            processing: true,
            scrollY: "500px",
            scrollX: true,
            autoWidth: true,
            responsive: true,
            destroy: true,
            lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
            pageLength: @Const.NO_OF_PAGE_RECORDS,
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                { extend: 'copyHtml5', text: 'Copy'},
                'fullscreenToggle',
                'colvis',
            ],
            ajax: {
                url: URL_LIST,
                type: 'POST',
                contentType: 'application/json',
                //headers: { 'Authorization': 'Bearer ' + token },
                data: function (d) {
                    const parseDate = (dateStr) => {
                        if (!dateStr) return null;
                        const parts = dateStr.split("-");
                        return parts.length === 3 ? `${parts[1]}/${parts[0]}/${parts[2]}` : null;
                    };
                    const in_page_record = d.length || 10;
                    const in_page_no = Math.floor(d.start / in_page_record) + 1;

                    return JSON.stringify({
                        from_date: parseDate($('#from_date').val()),
                        to_date: parseDate($('#to_date').val()),
                        d_c: $('#d_c').val() || null,
                        mode_id: $('#mode_id').val() || null,
                        uid: uid,
                        user_id: $('#user_id').val() || null,
                        in_page_no: in_page_no,
                        in_page_record: in_page_record
                    });
                },
                dataSrc: function (json) {
                    let data = [];
                    try { data =  json.data || "[]"; } catch (e) { console.error(e); }
                    json.recordsTotal = json.total_count || 0;
                    json.recordsFiltered = json.total_count || 0;
                    return data;
                }
            },
            columns: [
                { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                {
                    data: 'doe',
                    title: 'Date',
                    render: d => d ? new Date(d).toLocaleDateString('en-GB', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    }).replace(/ /g, '-') : ''
                },
                { data: 'user_id', title: 'User ID' },
                { data: 'name', title: 'Name' },
                {
                    data: 'd_c',
                    title: 'Type',
                    render: d => `<span style="color:${d === 'D' ? 'red' : d === 'C' ? 'green' : 'gray'};font-weight:bold;">${d === 'D' ? 'Debit' : d === 'C' ? 'Credit' : 'Unknown'}</span>`
                },
                {
                    data: 'debit',
                    title: 'Debit',
                    render: (d, t, r) => `<span style="color:red; font-weight:bold;">${d}</span>`
                },
                {
                    data: 'credit',
                    title: 'Credit',
                    render: (d, t, r) => `<span style="color:green; font-weight:bold;">${d}</span>`
                },

                { data: 'remarks', title: 'Particulars' },
                { data: 'voucher_type', title: 'Voucher Type'},
                { data: 'tran_no', title: 'Voucher No.' },
            ],
             footerCallback: function (row, data, start, end, display) {
                const api = this.api();
                const calc = i => api.column(i, { page: 'current' }).data().reduce((a, b) => (+a || 0) + (+b || 0), 0).toFixed(2);
                [5,6].forEach(i => $(api.column(i).footer()).html(calc(i)));
            }
        });
    }
</script>
 