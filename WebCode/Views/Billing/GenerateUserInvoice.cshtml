@model GenerateInvoiceDto
@{
    ViewData["Title"] = "Generate Invoice";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
} 
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Generate Invoice
    </h4> 
</section> 
<div class="clearfix"></div>
<form asp-action="generate-user-invoice" asp-controller="billing"
      asp-route-order_id="@Model?.order_id" id="FormSubmit" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="order_id" />
    <!-- Main Content -->
    <section class="content">
        <div class="row">

            <div class="col-md-3 col-sm-3 d-none">
                <select asp-for="cart_id" class="form-control" onchange="ChangeCart()">
                    <option value="6">✅ Repurchase Inv.</option>
                    @* <option value="7">✅ AWS Product</option> *@
                    <option value="8">🎁 Free Sample</option>
                </select> 
            </div>

            <div class="col-md-3">
                <select asp-for="buyer_uid" asp-items="ViewBag.BuyerList" onchange="GetName()" class="form-control select2">
                    <option value="0">🔍 Search User</option>
                </select>
            </div>
 
            <div class="col-md-4">
                <select id="pid" asp-items="ViewBag.ProductList" onchange="GetProduct()" class="form-control select2">
                    <option value="0">🔍 Search products</option>
                </select>
            </div>
            <div class="col-md-2 d-none">
                <input asp-for="invoice_no" value="" class="form-control text-uppercase" type="text" placeholder="Invoice No." maxlength="30" />
            </div>
              <div class="col-md-3 d-none">
                <input asp-for="doe" class="form-control" type="text" placeholder="Invoice Date." />
            </div>

            <div class="clearfix"></div>

            <div class="col-md-12">
                <div class="table-responsive mb-4">
                    <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end"></th>
                                <th></th> <!-- Price -->
                                <th></th> <!-- Qty -->
                                <th></th> <!-- Gross -->
                                <th></th> <!-- GST -->
                                <th></th> <!-- TAX -->
                                <th></th> <!-- Total Amount -->
                               @*  <th></th> <!--BV --> *@
                                <th></th> <!-- Delete --> 
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="divScheme" class="table-responsive mb-4">
                    <table id="tblSchemeList" class="table table-striped table-hover display nowrap cell-border" style="width:100%"> </table>
                </div>
            </div>
            <div class="col-md-12">
                <div id="div_order_detail" class="row">
                    <div class="col-sm-6">
                        <h5 class="mb-4 text-primary fw-bold">📦 Shipping Detail</h5>

                        <div class="row mb-12">

                            <div class="col-sm-6">
                                <input asp-for="s_name" class="form-control" type="text" placeholder="User Id." maxlength="25" />
                                <span asp-validation-for="s_name" class="text-danger"></span>
                            </div>

                            <div class="col-sm-6">
                                <input asp-for="s_mobile_no" class="form-control" type="text" placeholder="Mobile No." maxlength="10" />
                                <span asp-validation-for="s_mobile_no" class="text-danger"></span>
                            </div>

                            <div class="col-sm-12">
                                <textarea asp-for="s_address" class="form-control" type="text" placeholder="Address" maxlength="200" rows="2"></textarea>
                                <span asp-validation-for="s_address" class="text-danger"></span>
                            </div>


                            <div class="col-sm-6">
                                <select id="state_id" name="state_id" asp-for="state_id" asp-items="ViewBag.StateList"
                                        onchange="DistrictSelect()" class="form-control select2">
                                    <option value="0">🔍Select state</option>
                                </select>
                                <span asp-validation-for="state_id" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6">
                                <select id="dist_id" name="dist_id" asp-for="dist_id" asp-items="ViewBag.DistrictList" class="form-control select2">
                                    <option value="0">🔍Select district</option>
                                </select>
                                <span asp-validation-for="dist_id" class="text-danger"></span>
                            </div>

                            <div class="col-sm-6">
                                <input asp-for="s_city" class="form-control" type="text" placeholder="City" maxlength="70" />
                            </div>
                            <div class="col-sm-6">
                                <input asp-for="s_pincode" class="form-control" type="text" placeholder="Pincode" maxlength="6" />
                                <span asp-validation-for="s_pincode" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6">
                                <input asp-for="gst_no" class="form-control" type="text" placeholder="GST No." maxlength="25" />
                                <span asp-validation-for="gst_no" class="text-danger"></span>
                            </div>
                            <div class="col-sm-12">
                                <textarea asp-for="remark" class="form-control" type="text" placeholder="Remark" maxlength="200" rows="2"></textarea>
                                <span asp-validation-for="remark" class="text-danger"></span>
                            </div>

                            <h5 class="text-primary">
                                <i class="fa fa-credit-card me-2"></i> Payment Detail
                            </h5>
                            <div class="col-sm-12">
                                <div class="row mb-12">

                                    <div class="col-sm-6">
                                        <select asp-for="pay_id" onchange="PaymentOption()" class="form-control">
                                            <option value="0">🔍Payment Option</option>
                                            <option value="1">💵 Cash</option>
                                            <option value="4">🏦 Net Banking</option> 
                                            <option value="2">📦 COD</option>
                                            <option value="3">📲 UPI</option>
                                            <option value="5">🧾 Cheque</option>
                                            <option value="6">💳 Credit Card</option>
                                            <option value="7">💳 Debit Card</option>
                                            <option value="8">📄 DD</option>
                                            <option value="9">👛Company Wallet</option>   
                                        </select>
                                        <span asp-validation-for="pay_id" class="text-danger"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <input asp-for="bank_name" class="form-control" type="text" placeholder="Bank name" maxlength="50" />
                                        <span asp-validation-for="bank_name" class="text-danger"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <input asp-for="check_no" class="form-control" type="text" placeholder="DD/Cheque/UPI/Tran No." maxlength="35" />
                                        <span asp-validation-for="check_no" class="text-danger"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <input asp-for="checkdate" class="form-control" type="text" placeholder="Ckeque Date" maxlength="20" />
                                        <span asp-validation-for="checkdate" class="text-danger"></span>
                                    </div>

                                    <div class="col-sm-12">
                                        <h5 class="text-uppercase font-weight-bold mb-3 text-primary">Terms & Conditions</h5>
                                        <ol class="pl-3">
                                            <li>Goods once sold will not be taken back.</li>
                                            <li>Warranty will be undertaken by the manufacturer only.</li>
                                            <li>All disputes are subject to jurisdiction.</li>
                                            <li>Company is not responsible after the goods leave the premises.</li>
                                            <li>Any inaccuracy in this bill must be notified immediately on its receipt.</li>
                                            <li>This is a computer generated invoice. No signature required.</li>
                                        </ol>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Right Column: Order Summary -->
                    <div class="col-sm-6">

                        <h5 class="mb-4 text-primary fw-bold">📦 Order Summary</h5>

                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4" style="display:none;">
                            <input type="text" class="form-control" id="coupon" placeholder="Enter Coupon Code">
                            <button class="btn btn-primary" type="button" onclick="ApplyCoupon()">Apply</button>
                        </div>

                        <table class="table table-striped table-hover display nowrap cell-border dataTable">
                            <tr>
                                <td> Wallet Balance </td>
                                <td>  <span id="lbl_walletBalance">0.00</span> </td>
                            </tr>
                            <tr class="d-none">
                                <td>@Const.M_BV</td>
                                <td><span id="lbl_t_bv">0.00</span></td>
                            </tr>
                            <tr>
                                <td width="50%">Gross</td>
                                <td width="50%"><span id="lbl_Gross">0.00</span></td>
                            </tr>
                            <tr>
                                <td>GST</td>
                                <td><span id="lbl_GST">0.00</span></td>
                            </tr>
                            <tr>
                                <td>Delivery Charge</td>
                                <td>
                                    <div class="col-md-5">
                                        <select id="del_charge_tax" class="form-control">
                                            <option value="0">0%</option>
                                           @*  <option value="18">18%</option> *@
                                        </select>
                                    </div>
                                    <div class="col-md-7">
                                        <input asp-for="del_charge" class="form-control" type="text"
                                               onkeypress="return onlyDecimal(event)" />
                                    </div>

                                </td>
                            </tr>
                            <tr>
                                <td> Net Delivery Charge</td>
                                <td>
                                    <input asp-for="net_delivery_charge" class="form-control" type="text" readonly />
                                </td>
                            </tr>
                            <tr>
                                <td>Adjustment</td>
                                <td>
                                    <input asp-for="adjust_amt" class="form-control" type="text"
                                           onkeypress="return onlyDecimal(event)" /> 
                                </td>
                            </tr>
                           
                            <tr>
                                <td>Total Amount (Rs.)</td>
                                <td> <span id="lbl_Total">0.00</span>  </td>
                            </tr>

                             <tr>
                                <td> Gross Weight </td>
                                <td>   <span id="lbl_GrossWeight">0.00</span> </td>
                            </tr>

                            @* <tr>
                                <td>Discount</td>
                                <td>
                                    <input asp-for="discount" class="form-control" type="text"
                                           onkeypress="return onlyDecimal(event)" />
                                </td>
                            </tr> *@
                            @* <tr>
                                <td>Payable Amount (Rs.)</td>
                                <td> <span id="lbl_PaybleAmount">0.00</span>  </td>
                            </tr>
                            
                            <tr>
                                <td>Due Balance (Rs.)</td>
                                <td>  <span id="company_due" class="due-balance">0.00</span>  </td>
                            </tr>
                            <tr>
                                <td>Receive Amount (Rs.)</td>
                                <td>
                                    <input asp-for="receive_amount" class="form-control" type="text"
                                           onkeypress="return onlyDecimal(event)" maxlength="20" readonly />
                                </td>
                            </tr> *@

                        </table>
                         
                        <div class="d-flex justify-content-between mb-2 d-none" >
                            <div class="col-sm-6"> Scheme  </div>
                            <div class="col-sm-6"> <span id="scheme">0.00</span> </div>
                        </div>
                         
                        <div class="text-end">
                            <button type="submit" class="btn btn-success" onclick="confirmSubmission(event)">🚀 Submit  </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </section>
</form>
<input type="hidden" id="hnd_TotalAmount" value="0" />
<input type="hidden" id="hnd_PaybleAmount" value="0" />
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
 
<script>
    // Initialize Select2 dropdown with a placeholder and allow clearing the selection
    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    const login_uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    $(function () {
        $("#del_charge_tax, #del_charge, #discount").on("keyup input change", function () {
            Update_Discount_Delcharge();
        });

        @if (TempData["Error"] != null)
        {
         <text> showErrorLog(`@Const.ERROR_HEADER`, `@Html.Raw(TempData["Error"])`); PaymentOption(); </text>
        }
        @if (TempData["Success"] != null)
        {
            <text>
                  showSuccessMessage(`@Const.SUCCESS_HEADER`, `@Html.Raw(TempData["Success"])`);
            </text>
        }
    });



    let URL_ADD_CART = `/cart/add-cart-data`;
    let URL_CART_LIST = `/cart/get-cart-data`;
    let URL_CART_SCHEME_LIST = `/cart/get-cart-scheme-data`;
    let URL_DELETE_CART = `/cart/delete-cart-data`;
    let URL_SPONSOR_NAME = `/common/master-reports`;
    let URL_PROD_LIST = `/product/get-billing-product-list`;
    let URL_DROPDOWN_LIST = `/common/get-master-dropdown`;

    let token = "";

    $(function () {
        //token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
       
        if ($('#buyer_uid').val() != "0") { GetName(); }


        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        $('#doe').val(formatDate(today));
        $('#checkdate').val(formatDate(today));
        $('#doe, #checkdate').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        is_old_inv_fuction();
        PaymentOption();

        Bind_product();
        BindTableData();
    });



     function ChangeCart(){
          GetName();
          BindTableData();
     }



    function BindTableData() { 

        let buyer_uid=$('#buyer_uid').val();
        if (buyer_uid == "0") { return; }
        $.ajax({
            url: URL_CART_LIST,
            data: { cart_id: $('#cart_id').val(), uid: buyer_uid },
            type: 'GET',
            headers: { Authorization: 'Bearer ' + token },
            success: function (response) {
                if (!response.success) return;

                const data = JSON.parse(response.data || '[]');

                $('#div_order_detail').toggle(data.length > 0);

                $('#tblList').DataTable({
                    dom: 't',
                    // scrollY: '500px',
                    scrollCollapse: true,
                    destroy: true,
                    responsive: true,
                    autoWidth: false,
                    pageLength: -1,
                    language: { emptyTable: 'No records found' },
                    data: data,
                    columns: [
                        { title: '#', data: null, render: (_, __, ___, meta) => meta.row + 1 },
                        {
                            data: null, title: 'Product',
                            render: function (data, type, row) {
                                return `<strong>${row.prod_code}</strong><br><small>${row.prod_name}</small>`;
                            }
                        },
                        {
                            data: 'price',
                            title: 'Rate',
                            orderable: false,
                            render: function (price, __, row) {
                                const cartId = Number($('#cart_id').val());
                                const disabled = [6, 7].includes(cartId) ? "disabled" : "";

                                return `
                                    <input type="number" min="0" value="${price}"
                                           class="form-control text-center"
                                           id="rate-${row.cid}"
                                           onchange="changeRate(${row.cid}, this.value)"
                                           style="width: 15ch;" ${disabled} />

                                    <input type="hidden" id="pid-${row.pid}" value="${row.pid}" />
                                    <input type="hidden" id="prod_type-${row.pid}" value="${row.prod_type}" />
                                `;
                            }
                        },

                        // {
                        //     data: 'price', title: 'Rate', orderable: false,
                        //     render: (price, __, row) => `
                        //                  <input type="number" min="0" value="${price}" class="form-control text-center"
                        //                         id="rate-${row.cid}" onchange="changeRate(${row.cid}, this.value)" style="width: 15ch;" />
                        //                  <input type="hidden" id="pid-${row.pid}" value="${row.pid}" />
                        //                  <input type="hidden" id="prod_type-${row.pid}" value="${row.prod_type}" />
                        //              `
                        // },
                        {
                            data: 'qty', title: 'Quantity', orderable: false,
                            render: (qty, __, row) => `
                                         <div class="input-group input-group-sm" style="max-width: 130px;">
                                             <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${row.cid}, -1)">−</button>
                                             <input type="number" min="1" value="${qty}" class="form-control text-center"
                                                    id="qty-${row.cid}" onchange="changeQtyDirect(${row.cid}, this.value)" style="width: 10ch;" />
                                             <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(${row.cid}, 1)">+</button>
                                         </div>
                                     `
                        },
                        { data: 'gross', title: 'Gross' },
                        { data: 'gst', title: 'GST', render: gst => `${gst}%` },
                        { data: 'gst_amt', title: 'TAX' },
                        { data: 't_amount', title: 'Invoice Amt' },
                        // { data: 't_m_bv', title: '@Const.M_BV' },
                        {
                            data: 'cid', title: 'ACT', orderable: false,
                            render: cid => `<i class="fa fa-trash text-danger" style="cursor:pointer;" onclick="Delete_By_Id(${cid})"></i>`
                        },
                       
                        // {
                        //     data: 'prod_type', title: 'Prod Type',
                        //     render: p => p == 1
                        //         ? '<span class="text-success">🟢 Normal</span>'
                        //         : p == 3
                        //             ? '<span class="text-primary">🧪 Sample</span>'
                        //             : p
                        // }
                    ],
                    footerCallback: function () {
                        const api = this.api();
                        const getTotal = index =>
                            api.column(index, { page: 'current' }).data().reduce((a, b) => (+a || 0) + (+b || 0), 0);

                        const totalQty = getTotal(3);
                        const totalGross = getTotal(4);
                        const totalTax = getTotal(6);
                        const totalAmount = getTotal(7);
                        //const t_bv = getTotal(8);
                        // Sum by prod_type
                        let PaybleAmount = 0, discount = 0;
                        data.forEach(row => {
                            const amt = parseFloat(row.t_amount) || 0;
                            if (row.prod_type == 1) PaybleAmount += amt;
                            else if (row.prod_type == 3) discount += amt;
                        });
                        //$('#lbl_t_bv').text(t_bv.toFixed(2));
                        $('#lbl_Gross').text(totalGross.toFixed(2));
                        $('#lbl_GST').text(totalTax.toFixed(2));
                        $('#lbl_Total').text(Math.round(totalAmount.toFixed(2)));
                        $('#discount').val(discount.toFixed(2));
                        //$('#lbl_PaybleAmount').text(Math.round(PaybleAmount));

                        $('#hnd_TotalAmount').val(Math.round(totalAmount.toFixed(2)));
                        $('#hnd_PaybleAmount').val(Math.round(PaybleAmount));

                        $(api.column(3).footer()).html(totalQty.toFixed(0));
                        $(api.column(4).footer()).html(totalGross.toFixed(2));
                        $(api.column(6).footer()).html(totalTax.toFixed(2));
                        $(api.column(7).footer()).html(totalAmount.toFixed(2));
                        //$(api.column(8).footer()).html(t_bv.toFixed(2));
                        $('#scheme, #lbl_GrossWeight').text("0.00");
                    }
                });

                BindSchemeData();
                Update_Discount_Delcharge();
            },
            error: () => showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.')
        });
    }



    function Update_Discount_Delcharge() {
        let GST = getFloat("del_charge_tax");
        let del_charge = getFloat("del_charge");
        let discount = getFloat("discount");
        let TotalAmount = getFloat("hnd_TotalAmount");
        let PaybleAmount = 0;
        del_charge = parseFloat(del_charge) + parseFloat((del_charge * GST / 100));
        $('#net_delivery_charge').val(del_charge.toFixed(2));
        PaybleAmount = ((TotalAmount + del_charge) - discount);
        $('#lbl_Total').text(PaybleAmount.toFixed(2));
        return;
    }




    function BindSchemeData() { 
        let buyer_uid=$('#buyer_uid').val();
        if (buyer_uid == "0") { return; }
        $.ajax({
            url: URL_CART_SCHEME_LIST,
            data: { cart_id: $('#cart_id').val(), uid: buyer_uid },
            type: 'GET',
            headers: { 'Authorization': 'Bearer ' + token },
            success: function (res) {
                const data = res.success ? JSON.parse(res.data || '[]') : [];
                if (data.length === 0) return $('#divScheme').hide();

                $('#divScheme').show();
                $('#tblSchemeList').show().DataTable({
                    dom: 't',
                    scrollY: "500px",
                    scrollCollapse: true,
                    destroy: true,
                    responsive: true,
                    autoWidth: false,
                    language: { emptyTable: "No records found" },
                    data: data,
                    columns: [
                        { title: '#', data: null, render: (d, t, r, m) => m.row + 1 },
                        { title: 'Product', orderable: false, render: (q, t, r) => r.prod_code + ' - ' + r.prod_name },
                        { data: 'qty', title: 'Quantity' },
                        { title: 'Status', orderable: false, render: () => '<span style="color:green;">Scheme</span>' }
                    ]
                });
            },
            error: () => showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.')
        });
    }


     function GetProduct(){
        const pid = $('#pid').val();
        if (parseInt(pid) > 0) {
             const pidOld = document.getElementById(`pid-${pid}`)?.value;
             if (pidOld === pid) {
                 showToastSuccess("⚠️ Product already exists in the list.");
             } else {
                 updateQty(0, $('#pid').val(), 0, 1);
             }
        }
     }



    function updateQty(cid, pid, rate, qty, prod_type) {
         let buyer_uid=$('#buyer_uid').val();
        if (buyer_uid == "0") { return; }
        if (pid === "0") return; 
        $.ajax({
            url: URL_ADD_CART,
            type: 'GET',
            data: { cart_id: $('#cart_id').val(), uid: buyer_uid, rate, prod_type, pid, cid, qty },
            success: function (response) {
                response.success
                    ? (showToastSuccess('Saved successfully.'), BindTableData())
                    : showErrorLog(`@Const.ERROR_HEADER`, response.message);
            },
            error: () => showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.')
        });
    }




    function changeQty(cid, delta) {
        let rate = parseFloat(document.getElementById(`rate-${cid}`)?.value) || 0;
        let input = document.getElementById(`qty-${cid}`);
        let newQty = (parseInt(input?.value) || 1) + delta;
        input.value = Math.min(Math.max(newQty, 1), 999999);
        updateQty(cid, 0, rate, input.value, 0);
    }



    function changeQtyDirect(cid, value) { 
        const rate = parseFloat(document.getElementById(`rate-${cid}`)?.value) || 1;
        const newQty = Math.min(Math.max(parseInt(value) || 1, 1), 999999);
        document.getElementById(`qty-${cid}`).value = newQty;
        updateQty(cid, 0, rate, newQty, 0);
    }



    function changeRate(cid, value) {
        const qty = parseFloat(document.getElementById(`qty-${cid}`)?.value || "1");
        const rate = parseFloat(value || "0");

        if (qty <= 0) document.getElementById(`qty-${cid}`).value = 1;
        if (rate < 0) document.getElementById(`rate-${cid}`).value = 0;

        updateQty(cid, 0, rate < 0 ? 0 : rate, qty <= 0 ? 1 : qty, 0);
    }


    // function Delete_By_Id(id) {
    //     $.ajax({
    //         url: URL_DELETE_CART,
    //         data: { id: id },
    //         type: 'GET',
    //         contentType: 'application/json',
    //         success: function (response) {
    //             if (response.success == true) { BindTableData(); }
    //             else { showErrorLog(`@Const.ERROR_HEADER`, response.message); }
    //         },
    //         error: function (res_error) { showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.'); }
    //     });
    // }


    function Bind_product() {
        const $d = $('#pid').empty().append('<option value="0">Loading...</option>');
        $.get(`${URL_DROPDOWN_LIST}?id=0&mst_key=GET_VENDOR_PURCHASE_PRODUCT_LIST`)
            .done(res => {
                $d.empty().append(`<option value="0">🔍 Search products</option>`);
                res.data.forEach(i => $d.append(`<option value="${i.value}">${i.text}</option>`));
            })
            .fail(() => $d.empty().append(`<option value="0" selected>🔍 Search products</option>`));
    }


     


    function GetName() {
        let URL_LIST = `/common/master-reports`;
        let mst_key = "GET_BASIC_USER_DATA";
        let uid = $('#buyer_uid').val();
        if (uid != "0") {
            $.ajax({
                url: URL_LIST + `?id=${uid}&mst_key=${mst_key}`,
                type: 'GET',
                success: function (response) {
                    if (response.success === true) {
                        const dataArray = JSON.parse(response.data) || [];
                        const data = dataArray[0] || {};

                        $('#s_name').val(data.name);
                        $('#s_mobile_no').val(data.mobile);
                        $('#state_id').val(data.state_id).trigger('change.select2');
                        DistrictSelect(data.dist_id);

                        $('#dist_id').val(data.dist_id).trigger('change.select2');
                        $('#s_city').val(data.city);
                        $('#s_address').val(data.address);
                        $('#s_pincode').val(data.pin_code);


                        // $('#company_due').text('0.00');
                        // if (parseFloat(data.company_due) > 0) {
                        //     $('#company_due').text(parseFloat(data.company_due).toFixed(2));
                        // }

                        $('#lbl_walletBalance').text('0.00');
                        if (parseFloat(data.company_wallet) > 0) {
                            $('#lbl_walletBalance').text(parseFloat(data.company_wallet).toFixed(2));
                        }
                    }

                },
                error: function () {
                }
            });
        }
    }




    function PaymentOption() {
        let pay_id = $('#pay_id').val();
        if (pay_id == "0" || pay_id == "1" || pay_id == "2" || pay_id == "9" || pay_id == "10") {
            $('#bank_name').hide();
            $('#check_no').hide();
            $('#checkdate').hide();
        }
        else {
            $('#bank_name').show();
            $('#check_no').show();
            $('#checkdate').show();
        }
        $('#lbl_walletBalance').text('0.00');
        if(pay_id == "9" || pay_id == "10"){
            BindBalance();
        }
        //$('#pay_id').valid();
    }



    function is_old_inv_fuction() {
        if ($('#is_old_inv').val() == "1") {
            $('#invoice_no').val('');
            $('#doe').show();
        }
        else {
            GetInvoiceNo();
            $('#doe').hide();
        }
    }

    function GetInvoiceNo() {
        let URL_LIST = `/common/master-reports`;
        let mst_key = "GET_NEXT_INVOICE_NO";
        $.ajax({
            url: URL_LIST + `?mst_key=${mst_key}`,
            type: 'GET',
            success: function (response) {
                if (response.success === true) {
                    const dataArray = JSON.parse(response.data) || [];
                    const data = dataArray[0] || {};
                    $('#invoice_no').val(data.invoiceno);
                }
            },
            error: function () { }
        });
    }


    function BindBalance() {
        let buyer_uid = $('#buyer_uid').val();
        let pay_id = $('#pay_id').val();
        let mst_key="GET_BASIC_USER_DATA";
        if (buyer_uid == "") {
            $('#lbl_walletBalance').text('0.00');
            return;
        }
        $('#lbl_walletBalance').text('Loading...');
        $.ajax({
            url: `${URL_SPONSOR_NAME}?user_id=${buyer_uid}&mst_key=${mst_key}`,
            type: 'GET',
            success: function (response) {
                const dataArray = JSON.parse(response.data) || [];
                const data = dataArray[0] || {};
                if (response.data !== null) {
                    if (pay_id == "9") { $('#lbl_walletBalance').text(data.company_wallet.toFixed(2)); }
                    if (pay_id == "10") { $('#lbl_walletBalance').text(data.payout_wallet.toFixed(2)); }
                }
                else { $('#lbl_walletBalance').text('0.00'); }
            },
            error: function () { $('#lbl_walletBalance').text('0.00'); }
        });
    }

 

    function DistrictSelect(selected_dist_id) {
        let state_id = $('#state_id').val()
        $('#dist_id').empty().append('<option selected value="0">Loading...</option>');
        $.ajax({
            url: `${URL_DROPDOWN_LIST}?id=${state_id}&mst_key=GET_DISTRICT_LIST`,
            type: 'GET',
            success: function (response) {
                $('#dist_id').empty().append('<option selected value="0">🔍Select District</option>');
                PopulateControl(response.data, $('#dist_id'));
                $('#dist_id').val(selected_dist_id).trigger('change');
            },
            error: function () { $('#dist_id').empty().append('<option selected value="0">🔍Select District</option>'); }
        });
    }


    function PopulateControl(list, control) {
        if (list && list.length > 0) {
            control.removeAttr("disabled");
            $.each(list, function (i, item) {
                control.append($('<option></option>').val(item.value).text(item.text));
            });
        } else { control.empty().append('<option selected value="0">Not available</option>'); }
    }


    function confirmSubmission(event) {
        event.preventDefault(); // stop the form from auto-submitting

        let PayId = $('#pay_id').val();
        let PayMode = PayId == "0" ? "" : $('#pay_id option:selected').text();
        let Name = $('#s_name').val();
        let Mobile = $('#s_mobile_no').val();
        let InvoiceAmount = $('#lbl_Total').html();

        // 🔴 Validation
        if (PayId == "0") {
            Swal.fire({ icon: 'error', title: 'Payment Mode Required', text: 'Please select a payment mode before generating the invoice.', confirmButtonColor: '#dc3545' });
            $('#pay_id').focus();
            return;
        }

        Swal.fire({
            icon: 'warning',
            title: 'Confirm Invoice Generation',
            html: `
                <div style="text-align:left; font-size:15px; line-height:1.7;">
                    <p><strong>Are you sure you want to generate this invoice?</strong></p>
                    <p>Invoice Details:</p>
                    <ul style="padding-left:18px;">
                        <li>Customer Name: <b>${Name}</b></li>
                        <li>Mobile No: <b>${Mobile}</b></li>
                        <li>Payment Mode: <b>${PayMode}</b></li>
                        <li>Total Invoice Amount: <b>₹ ${Number(InvoiceAmount).toLocaleString()}</b></li>
                        <li>This action cannot be undone</li>
                    </ul>
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: 'Yes, Generate Invoice',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#dc3545',
            width: '40%'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('FormSubmit').submit();
            }
        });
    }


    function GetSelectProductData() { 
        let cart_id= $('#cart_id').val(); 
        window.location.href = `/bulk/select-product-for-cart?cart_id=${cart_id}`; 
    }


    const getFloat = id => {
        const val = $(`#${id}`).val();
        return isNaN(parseFloat(val)) ? 0 : parseFloat(val);
    };
 
</script>
 