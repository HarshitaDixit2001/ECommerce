<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Profit & Loss Report
    </h4> 
</section>
<div class="clearfix"></div>
<br />
<section class="content">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-bd lobidrag">
                <div class="panel-heading row">
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div>
                    <div class="col-md-4">
                        <select id="seller_uid" asp-items="ViewBag.SallerList" class="form-control select2">
                            <option value="0">🔍 Search User ID</option>
                        </select>
                    </div>
                    <div class="col-sm-1">
                        <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                            <thead></thead>   <!-- Required: JS will populate this -->
                            <tbody></tbody>   <!-- DataTables handles this --> 
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <hr />

                <div class="panel-body">
                <div class="table-responsive mb-4">
                    <table id="tblexpenses" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                        <tfoot>
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th> 
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div> 

            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")

<script>

    let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    const subRole = '@User.FindFirst("SubRole")?.Value'; 
    const URL_LIST = `/billing/get-profit-loss`;
    const DOWNLOAD_FILE_NAME = "SalesCollectionReport";

    $('.select2').select2({ placeholder: "🔍Select an Option", allowClear: true });
    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const weekAgo = new Date(today);
        weekAgo.setDate(today.getDate() - 180);

        $('#from_date').val(formatDate(weekAgo));
        $('#to_date').val(formatDate(today));

        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

        initializeTable();
        $('#btnSearch').on('click', function () { initializeTable(); });
    });


    const parseDate = d => d ? d.split("-").reverse().join("/") : null;



    function initializeTable() {
        showLoader();
        let from_date = parseDate($('#from_date').val());
        let to_date = parseDate($('#to_date').val());
        $.get(URL_LIST, {
            from_date: from_date,
            to_date: to_date,
            seller_uid: $('#seller_uid').val() || uid
        }, res => {

            from_date = $('#from_date').val();
            to_date = $('#to_date').val();

            hideLoader();

            if ($.fn.DataTable.isDataTable('#tblList')) {
                $('#tblList').DataTable().clear().destroy();
            }

            if (!(res.success && res.data.length)) return;

            const months = new Set();
            res.data.forEach(r =>
                Object.keys(r.month_qty || {}).forEach(k => months.add(k))
            );

            const sortedMonths = [...months].sort(
                (a, b) => new Date("01-" + a) - new Date("01-" + b)
            );

            const columns = [
                {
                    title: '#', data: null,
                    render: (_, __, ___, meta) => meta.row + 1,
                    className: 'text-center'
                },
                { title: 'Name', data: 'name', className: 'text-start' },
                ...sortedMonths.map(col => ({
                    title: col,
                    data: col,
                    render: (d, _, row) => {
                        const val = formatINR(d);
                        if (row.sno >= 1 && row.sno <= 15) {
                            return `<a href="javascript:void(0)" onclick="BindExpensesTable('${row.sno}', '${from_date}', '${to_date}', '${col}', '0')">${val}</a>`;
                        }
                        return val;
                    },
                    className: 'text-end'
                })),
                {
                    title: 'Total', data: 'Total',
                    render: (d, _, row) => {
                        const val = formatINR(d);
                        if (row.sno >= 1 && row.sno <= 15) {
                            return `<a href="javascript:void(0)" onclick="BindExpensesTable('${row.sno}', '${from_date}', '${to_date}', '', '1')">${val}</a>`;
                        }
                        return val;
                    },
                    className: 'text-end'
                }
            ];

            // Build rows
            const rows = [];
            res.data.forEach(r => {
                const flat = { name: r.name, Total: 0, sno: r.sno };
                sortedMonths.forEach(m => {
                    flat[m] = r.month_qty?.[m] || 0;
                    flat.Total += (+flat[m] || 0);
                });
                rows.push(flat);
            });

            $('#tblList').DataTable({
                dom: 'Bfrti',
                destroy: true,
                autoWidth: true,
                responsive: true,
                processing: true,
                paging: false,
                data: rows,
                columns: columns,
                createdRow: function(row, data) {
                    if (data.name === 'Total') $(row).css('font-weight', 'bold');
                },
                footerCallback: function(row, data, start, end, display) {
                    const api = this.api();
                    // Remove the last row (Total) from summing
                    const dataWithoutTotal = data.slice(0, data.length - 1);

                    sortedMonths.forEach((month, index) => {
                        const sum = dataWithoutTotal.reduce((a, r) => a + (+r[month] || 0), 0);
                        $(api.column(index + 2).footer()).html(formatINR(sum));
                    });

                    // Total column footer
                    const totalSum = dataWithoutTotal.reduce((a, r) => a + (+r.Total || 0), 0);
                    $(api.column(columns.length - 1).footer()).html(formatINR(totalSum));
                },
                buttons: [
                    'excel', 'csv',
                    {
                        extend: 'pdfHtml5',
                        text: 'PDF',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        filename: () =>
                            DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')
                    },
                    { extend: 'copyHtml5', text: 'Copy' },
                    'fullscreenToggle',
                    'colvis'
                ]
            });
        });
    }



    function BindExpensesTable(ecid, from_date, to_date, month, total) {
        
        $('html, body').animate({
            scrollTop: $('#tblexpenses').offset().top
        }, 800); // 800ms scroll duration


         if(total == "0")
         { 
             const dates = getMonthStartEnd(month);
             if (dates) {
                  from_date = dates.start;
                  to_date = dates.end;
             }
         } 
          
         from_date = parseDate(from_date);
         to_date = parseDate(to_date);

         table = $('#tblexpenses').DataTable({
             dom: 'Blfrtip',
             processing: true,
             //scrollY: "700px",
             scrollX: true,
             responsive: true,
             destroy: true,
             lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
             pageLength: 100,
             buttons: [
                 { extend: 'excelHtml5', text: 'Excel', filename: () => `${DOWNLOAD_FILE_NAME}_${new Date().toISOString().replace(/[:T]/g,'_')}` },
                 { extend: 'csvHtml5', text: 'CSV', filename: () => `${DOWNLOAD_FILE_NAME}_${new Date().toISOString().replace(/[:T]/g,'_')}` },
                 { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => `${DOWNLOAD_FILE_NAME}_${new Date().toLocaleString('sv-SE').replace(/[: ]/g,'_')}` },
                 { extend: 'copyHtml5', text: 'Copy' },
                 'fullscreenToggle', 'colvis'
             ],
             ajax: {
                 url: '/bulk/get-expenses',
                 type: 'POST',
                 contentType: 'application/json',
                 data: () => JSON.stringify({
                      uid: 0,
                      from_date: from_date,
                      to_date: to_date,
                      ecid : ecid,
                 }),
                 dataSrc: json => json.token_valid === false ? (window.location.href = `@Const.LOGOUT`) : (json.data || [])
             },
             columns: [
                 { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                 { data: 'doe', title: 'Date', render: d => d ? new Date(d).toLocaleDateString('en-GB',{ day:'2-digit', month:'short', year:'numeric'}).replace(/ /g,'-') : '' },
                 { data: 'name', title: 'Name' },
                 { data: 'exp_cat', title: 'Expenses' },
                 { data: 'amount', title: 'Amount' },
                 { data: 'remarks', title: 'Remarks' },
                 // {
                 //    data: 'eid', title: 'Delete', orderable: false,
                 //    render: (d) => `<i class="fa fa-trash text-danger" style="cursor:pointer" onclick="Delete(${d})"></i>`
                 // }
             ],
             footerCallback: function () {
                 const api = this.api();
                 const sumCol = i => api.column(i, { page: 'current' }).data().reduce((a,b)=> (+a||0)+(+b||0),0).toFixed(2);
                 $(api.column(4).footer()).html(sumCol(4));
             }
         });
     }

      

    function getMonthStartEnd(monthStr) {
        if (!monthStr) return null;

        const parts = monthStr.split('-'); // ["Apr", "25"]
        if (parts.length !== 2) return null;

        const monthName = parts[0];
        const yearShort = parts[1];

        const monthIndex = new Date(`${monthName} 1, 20${yearShort}`).getMonth(); // 0-based
        const year = 2000 + parseInt(yearShort);

        const startDate = new Date(year, monthIndex, 1);
        const endDate = new Date(year, monthIndex + 1, 0);

        // Helper function to format date as dd-mm-yyyy
        function formatDDMMYYYY(date) {
            const dd = String(date.getDate()).padStart(2, '0');
            const mm = String(date.getMonth() + 1).padStart(2, '0'); // month is 0-based
            const yyyy = date.getFullYear();
            return `${dd}-${mm}-${yyyy}`;
        }

        return {
            start: formatDDMMYYYY(startDate), // dd-mm-yyyy
            end: formatDDMMYYYY(endDate)      // dd-mm-yyyy
        };
    }
     
</script>
 