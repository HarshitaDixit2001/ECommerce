@{
    ViewData["Title"] = "Party Ledger";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
@* <!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i> <strong> Party Ledger </strong></a></li> 
    </ol>
        <a asp-controller="billing" asp-action="invoice-list" class="btn btn-success pull-right"> <i class="fa fa-list"></i>  Invoice List </a>
   
