@{
    ViewData["Title"] = "Franchise Order List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Franchise Order List
    </h4> 
</section>
<div class="clearfix"></div>
<br />

<section class="content">
    <div class="row">

        <div class="col-sm-2">
            <input type="text" id="from_date" class="form-control" placeholder="From Date" />
        </div>
        <div class="col-sm-2">
            <input type="text" id="to_date" class="form-control" placeholder="To Date" />
        </div>
        <div class="col-sm-2">
            <input id="buyer_id" class="form-control" placeholder="Buyer Id" />
        </div>
        <div class="col-sm-2"> 
            <input id="seller_id" class="form-control" placeholder="Seller Id" />
        </div>
        <div class="col-sm-2">
            <input id="order_no" class="form-control" placeholder="Order No" />
        </div>
        <div class="col-sm-2" style="display:none;">
            <input id="mobile_no" class="form-control" placeholder="Mobile No" />
        </div>
        <div class="col-sm-1">
            <select id="status" class="form-control">
                <option value="-1">All</option>
                <option value="0">Pending</option>
                <option value="1" selected>Approved</option>
                <option value="2">Cancelled</option>
            </select>
        </div>
        <div class="col-sm-1">
            <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-12">
            <div class="table-responsive mb-4">
                <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                    <tfoot>
                        <tr>
                            <th colspan="2" class="text-end">Total:</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>

                            <th></th>
                            <th></th>
                            <th></th>

                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

</section>

 
@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
@* @await Html.PartialAsync("_ValidationScriptsPartial") *@
 
<script>

        let table;
        let token = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.Token?.ToString() ?? ""))';
        const uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
        const subRole = '@User.FindFirst("SubRole")?.Value';

        const URL_LIST = `/billing/get-fran-order-list`;
        const DOWNLOAD_FILE_NAME = "Order_List";

        $(function () {

            const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
            const today = new Date();
            const weekAgo = new Date(today);
            weekAgo.setDate(today.getDate() - 30);

            $('#from_date').val(formatDate(weekAgo));
            $('#to_date').val(formatDate(today));

            $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });

            initializeTable();

            $('#btnSearch').on('click', function () {  table.ajax.reload(); });
        });




    function initializeTable() {


        table = $('#tblList').DataTable({
            dom: 'Blfrtip',
            scrollY: "500px",
            scrollX: true,
            autoWidth: true,
            responsive: true,
            destroy: true,
            processing: true,
            lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
            pageLength: @Const.NO_OF_PAGE_RECORDS,
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                { extend: 'copyHtml5', text: 'Copy'},
                'fullscreenToggle',
                'colvis',
            ],
            ajax: {
                url: URL_LIST,
                type: 'POST',
                contentType: 'application/json',
                //headers: { 'Authorization': 'Bearer ' + token },
                data: () => JSON.stringify({
                    from_date: parseDate($('#from_date').val()),
                    to_date: parseDate($('#to_date').val()),
                    uid,   
                    buyer_user_id : $('#buyer_id').val() || null,
                    seller_user_id : $('#seller_id').val() || null,
                    buyer_uid : null,
                    seller_uid : null,
                    status: $('#status').val() == '-1' ? null : $('#status').val(),
                    order_no: $('#order_no').val() || null,
                    mobile_no: $('#mobile_no').val() || null
                }),
                dataSrc: function (json) {
                        if(json.token_valid === false){
                            window.location.href = `@Const.LOGOUT`; return;
                        }
                        let data = [];
                        try { data = json?.data || []; } catch (e) { console.error(e); }
                        return data;
                    }
                },
                columns: [
                { data: null, title: '#', render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                {
                    data: 'order_no', title: 'Order No',
                    render: (d, t, r) => `<a href="/print/admin-po/${r.order_id}" target="_blank" class="text-primary text-decoration-underline">${d}</a>`
                },
                {
                    data: 'order_id', title: 'Action', orderable: false,
                    render: (d, t, r) => {
                        if (subRole !== "admin_sub_role") return '';
                        return r.status === 0 ? `<a href="/billing/generate-invoice?order_id=${d}" class="text-primary text-decoration-underline"><i class="fa fa-check-circle me-1"></i> Approve</a>`
                            : r.status === 1 ? `<span class="text-success"><i class="fa fa-circle me-1"></i> Approved</span>`
                            : `<span class="text-danger"><i class="fa fa-circle me-1"></i> Cancelled</span>`;
                    }
                },
                { data: 'buyer_user_id', title: 'Party ID' },
                { data: 'buyer_name', title: 'Party Name' },
                { data: 'gst_no', title: 'Party GST No' },
                { data: 'seller_user_id', title: 'Order By' },
                { data: 'seller_name', title: 'Order Name' },
                { data: 't_gross', title: 'Gross' },
                { data: 't_tax_rs', title: 'Tax' },
                { data: 't_amount', title: 'Total Amount' },
                { data: 'adjust_amt', title: 'Adjustment' },
                {
                    data: 'doe', title: 'Date',
                    render: d => d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : ''
                }
            ],
            footerCallback: function (row, data, start, end, display) {
                const api = this.api();
                const calc = i => api.column(i, { page: 'current' }).data().reduce((a, b) => (+a || 0) + (+b || 0), 0).toFixed(2);
                [8, 9, 10, 11].forEach(i => $(api.column(i).footer()).html(calc(i)));
            }
        });
    }
</script>
 