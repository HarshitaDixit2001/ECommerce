@{
    ViewData["Title"] = "Party Wise Outstanding";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
@* <!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i> Party Wise Outstanding </a></li>
    </ol>
</section> *@
<!-- Breadcrumb -->
<section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
    <h4 class="mb-0 fw-semibold text-secondary">
        <i class="fa fa-list me-2 text-muted"></i>Party Wise Outstanding
    </h4> 
</section>
<div class="clearfix"></div>
<br />

<section class="content">
    <div class="row">
        <div class="col-sm-12">

            <div class="panel-heading row">
                <div class="row mb-12">
                    <div class="col-sm-2">
                        <input type="text" id="from_date" class="form-control" placeholder="From Date" />
                    </div>
                    <div class="col-sm-2">
                        <input type="text" id="to_date" class="form-control" placeholder="To Date" />
                    </div> 
                    <div class="col-md-4">
                        <select id="seller_uid" asp-items="ViewBag.SallerList" class="form-control select2">
                            <option value="0">🔍 Search User ID</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <input id="btnSearch" class="btn btn-info" type="button" value="Search" />
                    </div>
                </div>
            </div>
            <div class="row mb-12">
                <div class="panel-body">
                    <div class="table-responsive mb-4">
                        <table id="tblList" class="table table-striped table-hover display nowrap cell-border" style="width:100%">
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Total:</th>
                                    <th></th>
                                    <th></th> 
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>



@await Html.PartialAsync("_DatatableScript")
@await Html.PartialAsync("_DropdownSearch")
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_DatePicker")
<script>

    let table;
    const URL_LIST = `/billing/get-party-wise-outstanding`;
    const DOWNLOAD_FILE_NAME = "PartyWiseOutstanding";
     let uid = '@User.FindFirst(System.Security.Claims.ClaimTypes.Sid)?.Value';
    $(function () {

        const formatDate = date => date.toLocaleDateString('en-GB').split('/').join('-');
        const today = new Date();
        const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);

        $('#from_date').val(formatDate(monthStart));
        $('#to_date').val(formatDate(today));
        $('#from_date, #to_date').datetimepicker({ timepicker: false, format: 'd-m-Y' });


        initializeTable();
        $('#btnSearch').on('click', function () {  table.ajax.reload(); });
    });


    const parseDate = d => d ? d.split("-").reverse().join("/") : null;


    function initializeTable() {
        table = $('#tblList').DataTable({
            dom: 'Blfrtip',
            scrollY: "500px",
            processing: true,
            scrollX: true,
            autoWidth: true,
            responsive: true,
            destroy: true,
            lengthMenu: [[10, 25, 100, -1], [10, 25, 100, "All"]],
            pageLength: -1,
            buttons: [
                { extend: 'excelHtml5', text: 'Excel', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'csvHtml5', text: 'CSV', filename: () => DOWNLOAD_FILE_NAME + new Date().toISOString().replace(/[:T]/g, '_') },
                { extend: 'pdfHtml5', text: 'PDF', orientation: 'landscape', pageSize: 'A4', filename: () => DOWNLOAD_FILE_NAME + new Date().toLocaleString('sv-SE').replace(/[: ]/g, '_')},
                { extend: 'copyHtml5', text: 'Copy'},
                'fullscreenToggle',
                'colvis',
            ],
            ajax: {
                url: URL_LIST,
                type: 'GET',
                contentType: 'application/json',
                data: function (d) {
                    d.from_date  = parseDate($('#from_date').val());
                    d.to_date    = parseDate($('#to_date').val());
                    d.seller_uid = $('#seller_uid').val() || uid;    // 👈 send seller_uid
                },
                dataSrc: json => json?.data || []
            },
            columns: [
                { title: '#', data: null, render: (d, t, r, m) => m.row + m.settings._iDisplayStart + 1 },
                { data: 'user_id', title: 'User ID' },
                { data: 'name', title: 'Party’s Name' },
                { data: 'targert', title: 'Targert' },
                { data: 'sales', title: 'Sales' },
                { data: 'collection', title: 'Collection' },
                { data: 'outstanding', title: 'Outstanding' },
            ],
            "footerCallback": function (row, data, start, end, display) {
                const api = this.api();
                function getTotal(index) {
                    return api.column(index, { page: 'current' }).data().reduce((a, b) => {
                        const x = parseFloat(a) || 0;
                        const y = parseFloat(b) || 0;
                        return x + y;
                    }, 0);
                }
                $(api.column(3).footer()).html(getTotal(3).toFixed(2));
                $(api.column(4).footer()).html(getTotal(4).toFixed(2));
                $(api.column(5).footer()).html(getTotal(5).toFixed(2));
                $(api.column(6).footer()).html(getTotal(6).toFixed(2));
            }
        });
    }
</script> 