@model GenerateInvoiceDto
@{
    ViewData["Title"] = "Generate Order";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
@* <!-- Breadcrumb -->
<section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i>Generate Franchise Invoice / Purchase Order</a></li>

    </ol>
