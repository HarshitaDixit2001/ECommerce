@{
    ViewData["Title"] = "Party_list";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
 
<!-- Breadcrumb -->
@* <section class="content-header">
    <ol class="breadcrumb pull-left"> 
        <li><a><i class="fa fa-list"></i>Franchise List</a></li>
    </ol>
    <a asp-action="admin-add-franchise" asp-controller="user" class="btn btn-success pull-right"> <i class="fa fa-plus"></i> New </a>
