@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">

    <div class="container">
        <!-- Breadcrumb -->
        <section class="content-header d-flex justify-content-between align-items-center py-2 border-bottom">
            <h4 class="mb-0 fw-semibold text-secondary">
                <i class="fa fa-list me-2 text-muted"></i>Change Password
            </h4>
        </section>
        <div class="clearfix"></div>
        <br />


        <div class="row">
            <div class="col-sm-12">
                <div class="col-md-4">
                    <label class="form-label">👤 Old Password</label>
                    <input id="old_password" class="form-control" type="password" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="col-md-4">
                    <label class="form-label">👤 New Password</label>
                    <input id="password" class="form-control" type="password" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="col-md-4">
                    <label class="form-label">🔒 Confirm Password</label>
                    <input id="confirm_password" class="form-control" type="password" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <!-- Submit Button -->
                <div class="col-md-2 d-flex align-items-end">
                    <label class="form-label"></label>
                    <button type="submit" id="saveBtn" class="btn btn-success w-100"
                            onclick="confirmSubmissionReceivedAmount(event)">
                        ✅ Submit
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/js/jquery-3.7.1.min.js"></script>
@await Html.PartialAsync("_Sweetalert")
@await Html.PartialAsync("_ValidationScriptsPartial")
<script>

    $(function () {

        $('#old_password, #password, #confirm_password').on('keypress', function (e) {
            if (e.which === 32) {
                e.preventDefault();
                showErrorLog(`@Const.ERROR_HEADER`, "Spaces are not allowed in password.");
            }
        });

        $('#old_password, #password, #confirm_password').on('paste', function (e) {
            const pasteData = (e.originalEvent || e).clipboardData.getData('text');
            if (/\s/.test(pasteData)) {
                e.preventDefault();
                showErrorLog(`@Const.ERROR_HEADER`, "Pasting spaces in password is not allowed.");
            }
        });



            @if (TempData["Error"] != null)
            {
                    <text> showErrorLog(`@Const.ERROR_HEADER`, '@TempData["Error"]'); </text>
            }
            @if (TempData["Success"] != null)
            {
                    <text>
                       showSuccessMessage(`@Const.SUCCESS_HEADER`, '@TempData["Success"]');
                    </text>
            }
    });




    function ChangePassword() {
        const old_password = $('#old_password').val();
        const password = $('#password').val();
        const confirm_password = $('#confirm_password').val();

        if (old_password == "") {
            showErrorLog(`@Const.ERROR_HEADER`, "Please enter old password."); return;
        }
        if (password.length < 8) {
            showErrorLog(`@Const.ERROR_HEADER`, "Password must be at least 8 characters."); return;
        }
        if (password !== confirm_password) {
            showErrorLog(`@Const.ERROR_HEADER`, "Passwords do not match. Please try again."); return;
        }

        showLoader();
        const url = `/user/update-password`;
        $.ajax({
            url: url,
            type: 'GET',
            data: { old_password: old_password, password: password },
            success: function (response) {
                hideLoader();
                if (response.success === true) {
                    showToastSuccess('Data saved successfully.');
                    showSuccessMessage(`@Const.SUCCESS_HEADER`, '✅ Your details have been saved successfully.');

                    $('#old_password').val('');
                    $('#password').val('');
                    $('#confirm_password').val('');

                } else {
                    showErrorLog(`@Const.ERROR_HEADER`, response.message || "Failed to save data.");
                }
            },
            error: function () {
                hideLoader();
                showErrorLog(`@Const.ERROR_HEADER`, 'Unexpected error occurred.');
            }
        });
    }


     function confirmSubmissionReceivedAmount(event) {
            event.preventDefault(); // stop the form from auto-submitting
            Swal.fire({
                icon: 'question',
                title: '⚠️ Are you sure you want to continue?',
                html: `<div style="text-align: left; white-space: pre-wrap; font-size: 16px;"><strong>${'Do you want to submit the details?'}</strong></div>`,
                showCancelButton: true,
                confirmButtonText: 'Yes',
                cancelButtonText: 'No',
                customClass: { htmlContainer: 'text-left' },
                width: '35%'
            }).then((result) => {
                if (result.isConfirmed) {
                    ChangePassword();
                }
            });
        }

</script>
